; Script generated by Inno Setup for AVORA POS Native (100% Native WPF Desktop Terminal)
#define MyAppName "AVORA POS Native"
#define MyAppVersion "1.0.0"
#define MyAppPublisher "AVORA Restaurant Solutions"
#define MyAppURL "https://avora.restaurant"
#define MyAppExeName "AvoraPosNative.exe"

[Setup]
; Unique AppId completely separated from Hybrid WebView2 app (Directive 1 & 10)
AppId={{B2C3D4E5-F6A7-8901-BCDE-AVORAPOSNATIVE2026}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\AVORA POS Native
DefaultGroupName={#MyAppName}
AllowNoIcons=yes
OutputDir=e:\avora-restaurant\dist\native\installer
OutputBaseFilename=AVORA-POS-Native-Setup
Compression=lzma2/max
SolidCompression=yes
ArchitecturesInstallIn64BitMode=x64
WizardStyle=modern
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
SetupIconFile=e:\avora-restaurant\desktop\AvoraPosNative\Assets\avora_logo_desktop.ico
CloseApplications=yes
RestartApplications=no
UsePreviousAppDir=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"
Name: "autostart"; Description: "Khởi động AVORA POS Native cùng Windows (Auto-start with Windows)"; GroupDescription: "Tùy chọn:"; Flags: unchecked

[Files]
; Self-contained x64 published application (Zero WebView2, zero browser engine)
Source: "e:\avora-restaurant\dist\native\app\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "e:\avora-restaurant\desktop\AvoraPosNative\Assets\avora_logo_desktop.ico"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\avora_logo_desktop.ico"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\avora_logo_desktop.ico"; Tasks: desktopicon

[Registry]
; Windows Startup Autorun
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: string; ValueName: "AvoraPosNative"; ValueData: """{app}\{#MyAppExeName}"""; Flags: uninsdeletevalue; Tasks: autostart

; Deep Linking Protocol: avora-pos-native://
Root: HKCU; Subkey: "Software\Classes\avora-pos-native"; ValueType: string; ValueName: ""; ValueData: "URL:AVORA POS Native Protocol"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\avora-pos-native"; ValueType: string; ValueName: "URL Protocol"; ValueData: ""; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\avora-pos-native\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\avora_logo_desktop.ico"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\avora-pos-native\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Flags: uninsdeletekey

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
