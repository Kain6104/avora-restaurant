; Script generated by Inno Setup for AVORA POS
#define MyAppName "AVORA POS"
#define MyAppVersion "1.0.1"
#define MyAppPublisher "AVORA Restaurant Solutions"
#define MyAppURL "https://avora.restaurant"
#define MyAppExeName "AvoraPos.exe"

[Setup]
AppId={{A1B2C3D4-E5F6-7890-ABCD-AVORAPOS2026}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\AVORA POS
DefaultGroupName={#MyAppName}
AllowNoIcons=yes
OutputDir=e:\avora-restaurant\dist\installer
OutputBaseFilename=AVORA-POS-Setup
Compression=lzma2/max
SolidCompression=yes
ArchitecturesInstallIn64BitMode=x64
WizardStyle=modern
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
SetupIconFile=E:\avora-restaurant\desktop\AvoraPos\avora_logo_desktop.ico
CloseApplications=yes
RestartApplications=no
UsePreviousAppDir=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"
Name: "autostart"; Description: "Khởi động AVORA POS cùng Windows (Auto-start with Windows)"; GroupDescription: "Tùy chọn nâng cao:"; Flags: unchecked

[Files]
; Self-contained x64 published application
Source: "e:\avora-restaurant\dist\app\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "E:\avora-restaurant\desktop\AvoraPos\avora_logo_desktop.ico"; DestDir: "{app}"; Flags: ignoreversion

; Microsoft WebView2 Evergreen Bootstrapper
Source: "e:\avora-restaurant\installer\MicrosoftEdgeWebview2Setup.exe"; DestDir: "{tmp}"; Flags: deleteafterinstall

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\avora_logo_desktop.ico"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\avora_logo_desktop.ico"; Tasks: desktopicon

[Registry]
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: string; ValueName: "AvoraPos"; ValueData: """{app}\{#MyAppExeName}"""; Flags: uninsdeletevalue; Tasks: autostart
Root: HKCU; Subkey: "Software\Classes\avora-pos"; ValueType: string; ValueName: ""; ValueData: "URL:AVORA POS Protocol"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\avora-pos"; ValueType: string; ValueName: "URL Protocol"; ValueData: ""; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\avora-pos\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\avora_logo_desktop.ico"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\avora-pos\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Flags: uninsdeletekey

[Run]
; Install WebView2 Evergreen Runtime if missing (Directive 3)
Filename: "{tmp}\MicrosoftEdgeWebview2Setup.exe"; Parameters: "/silent /install"; Flags: runhidden waituntilterminated; Check: NeedsWebView2Install

; Launch application after setup
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Code]
function NeedsWebView2Install(): Boolean;
var
  version: String;
begin
  Result := True;
  
  // Check 64-bit registry
  if RegQueryStringValue(HKLM, 'SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}', 'pv', version) then
  begin
    if (Length(version) > 0) and (version <> '0.0.0.0') then
    begin
      Result := False;
      Exit;
    end;
  end;

  // Check 32-bit / native HKLM registry
  if RegQueryStringValue(HKLM, 'SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}', 'pv', version) then
  begin
    if (Length(version) > 0) and (version <> '0.0.0.0') then
    begin
      Result := False;
      Exit;
    end;
  end;

  // Check user-level HKCU registry
  if RegQueryStringValue(HKCU, 'SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}', 'pv', version) then
  begin
    if (Length(version) > 0) and (version <> '0.0.0.0') then
    begin
      Result := False;
      Exit;
    end;
  end;
end;
