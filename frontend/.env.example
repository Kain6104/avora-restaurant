# Backend API URL for client-side requests
NEXT_PUBLIC_API_URL="http://localhost:4001"

# Backend API URL for server-side / SSR requests
INTERNAL_API_URL="http://127.0.0.1:4001"

# Optional WebSocket URL (defaults to NEXT_PUBLIC_API_URL if unset)
NEXT_PUBLIC_SOCKET_URL="http://localhost:4001"

# Optional Map Tile Configuration (defaults to OpenStreetMap)
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"
