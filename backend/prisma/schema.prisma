  @@index([userId, source])
  @@index([userId, membershipTierId])
  @@index([orderCode])
  @@index([orderId])
  @@index([referenceCode])
  @@index([membershipTierId], map: "PointTransaction_membershipTierId_fkey")
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String?
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
