// ==========================================
// HỆ THỐNG ĐÁNH GIÁ & TRẢI NGHIỆM KHÁCH HÀNG (REVIEWS & RATINGS)
// ==========================================

enum ProductReviewStatus {
  ACTIVE
  HIDDEN
  DELETED
}

enum OrderReviewStatus {
  ACTIVE
  HIDDEN
  MODERATED
}

enum ReviewMediaType {
  IMAGE
  VIDEO
}

enum ReviewReactionType {
  LIKE
  DISLIKE
}

model ProductReview {
  id                  String              @id @default(uuid())
  userId              String
  productId           String
  rating              Int // 1 - 5 (Integer)
  content             String              @db.Text
  isVerifiedPurchase  Boolean             @default(false)
  verifiedOrderId     String?
  verifiedOrderItemId String?
  purchasedAt         DateTime?
  status              ProductReviewStatus @default(ACTIVE)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  product           Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  verifiedOrder     Order?           @relation("VerifiedOrderReviews", fields: [verifiedOrderId], references: [id], onDelete: SetNull)
  verifiedOrderItem OrderItem?       @relation("VerifiedOrderItemReviews", fields: [verifiedOrderItemId], references: [id], onDelete: SetNull)
  media             ReviewMedia[]
  reactions         ReviewReaction[]
  reply             ReviewReply?

  @@unique([userId, productId])
  @@index([productId, status])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
  @@index([verifiedOrderId])
}

model ReviewMedia {
  id              String          @id @default(uuid())
  productReviewId String?
  orderReviewId   String?
  followUpId      String?
  mediaType       ReviewMediaType @default(IMAGE)
  url             String          @db.Text
  thumbnailUrl    String?         @db.Text
  mimeType        String
  sizeBytes       Int
  width           Int?
  height          Int?
  durationSeconds Float?
  displayOrder    Int             @default(0)
  createdAt       DateTime        @default(now())

  productReview ProductReview?       @relation(fields: [productReviewId], references: [id], onDelete: Cascade)
  orderReview   OrderReview?         @relation(fields: [orderReviewId], references: [id], onDelete: Cascade)
  followUp      OrderReviewFollowUp? @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  @@index([productReviewId])
  @@index([orderReviewId])
  @@index([followUpId])
}

model ReviewReaction {
  id        String             @id @default(uuid())
  reviewId  String
  userId    String
  type      ReviewReactionType
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId, type])
  @@index([userId])
}

model ReviewReply {
  id              String   @id @default(uuid())
  productReviewId String?  @unique
  orderReviewId   String?  @unique
  adminId         String
  content         String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  productReview ProductReview? @relation(fields: [productReviewId], references: [id], onDelete: Cascade)
  orderReview   OrderReview?   @relation(fields: [orderReviewId], references: [id], onDelete: Cascade)
  admin         User           @relation("AdminReviewReplies", fields: [adminId], references: [id])

  @@index([adminId])
}

model OrderReview {
  id                   String            @id @default(uuid())
  orderId              String
  userId               String
  overallRating        Int // 1 - 5 (Integer)
  foodRating           Int?
  serviceRating        Int?
  deliveryRating       Int?
  content              String            @db.Text
  rewardPointsSnapshot Int               @default(999)
  rewardGranted        Boolean           @default(false)
  rewardGrantedAt      DateTime?
  pointTransactionId   String?           @unique
  reviewExpiresAt      DateTime
  status               OrderReviewStatus @default(ACTIVE)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  order            Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  pointTransaction PointTransaction?     @relation(fields: [pointTransactionId], references: [id], onDelete: SetNull)
  media            ReviewMedia[]
  followUps        OrderReviewFollowUp[]
  reply            ReviewReply?

  @@unique([orderId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model OrderReviewFollowUp {
  id            String   @id @default(uuid())
  orderReviewId String
  userId        String
  content       String   @db.Text
  createdAt     DateTime @default(now())

  orderReview OrderReview   @relation(fields: [orderReviewId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  media       ReviewMedia[]

  @@index([orderReviewId, createdAt])
  @@index([userId])
}

// =========================================================================
// AI MEAL ARCHITECT™ SCHEMAS
