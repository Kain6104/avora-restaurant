generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String             @id @default(uuid())
  email                     String             @unique
  phone                     String?            @unique
  passwordHash              String?
  fullName                  String
  username                  String?            @unique
  avatarUrl                 String?
  birthdate                 DateTime?          @db.Date
  role                      RoleType           @default(USER)
  authProvider              AuthProvider       @default(LOCAL)
  googleId                  String?            @unique
  points                    Int                @default(0)
  currentPoints             Float              @default(0)
  totalSpending             Float              @default(0)
  membershipTierId          String?
  isEmailVerified           Boolean            @default(false)
  isPhoneVerified           Boolean            @default(false)
  isAccountLocked           Boolean            @default(false)
  forceRelogin              Boolean            @default(false)
  secureToken               String             @unique @default(uuid())
  deviceToken               String?            @db.VarChar(500)
  zaloId                    String?            @unique
  taxCode                   String?
  companyName               String?
  taxAddress                String?
  invoiceEmail              String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  memberCode                String?            @unique @db.VarChar(50)
  branchId                  String?
  resetPasswordOtpAttempts  Int                @default(0)
  resetPasswordRequestCount Int                @default(0)
  verificationOtpAttempts   Int                @default(0)
  verificationOtpLastSentAt DateTime?
  resetPasswordExpires      DateTime?
  resetPasswordLastSentAt   DateTime?
  resetPasswordOtp          String?
  resetPasswordRequestDate  DateTime?          @db.Date
  verificationOtp           String?
  verificationOtpExpires    DateTime?
  addresses                 Address[]
  chatSessions              ChatSession[]
  notifications             Notification[]
  orders                    Order[]
  pointTransactions         PointTransaction[]
  auditLogs                 AuditLog[]
  reservations              Reservation[]
  branch                    Branch?            @relation(fields: [branchId], references: [id])
  membershipTier            MembershipTier?    @relation(fields: [membershipTierId], references: [id])
  favoriteItems             Product[]          @relation("UserFavoriteItems")

  @@index([branchId], map: "User_branchId_fkey")
  @@index([membershipTierId], map: "User_membershipTierId_fkey")
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  recipientName String?
  phone         String?
  province      String
  district      String?
  ward          String
  streetDetail  String
  isDefault     Boolean  @default(false)
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Address_userId_fkey")
}

model Branch {
  id                    String        @id @default(uuid())
  name                  String
  branchCode            String        @unique
  phone                 String?
  email                 String?
  province              String?
  district              String?
  ward                  String?
  street                String?
  latitude              Float?
  longitude             Float?
  openTime              String?
  closeTime             String?
  onlineOrderingEnabled Boolean       @default(true)
  servingType           ServingType   @default(DINE_IN)
  splitKitchenTickets   Boolean       @default(false)
  printCancelTicket     Boolean       @default(false)
  allowedRadiusMeters   Int           @default(50)
  qrSecretKey           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  orders                Order[]
  reservations          Reservation[]
  users                 User[]
  banners               Banner[]      @relation("BannerToBranch")
  categories            Category[]    @relation("CategoryToBranch")
  products              Product[]     @relation("ProductToBranch")
  vouchers              Voucher[]     @relation("VoucherToBranch")
  flashSales            FlashSale[]   @relation("FlashSaleToBranch")
  combos                Combo[]       @relation("ComboToBranch")
}

model Banner {
  id          String    @id @default(uuid())
  imageUrl    String
  altText     String?
  linkUrl     String?
  active      Boolean   @default(true)
  bannerOrder Int       @default(0)
  popup       Boolean   @default(false)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  branches    Branch[]  @relation("BannerToBranch")
}

model Category {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  image        String?
  description  String?   @db.Text
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
  branches     Branch[]  @relation("CategoryToBranch")
}

model Product {
  id                   String          @id @default(uuid())
  itemCode             String          @unique
  name                 String
  slug                 String          @unique
  description          String?         @db.Text
  post                 String?         @db.Text
  price                Float
  oldPrice             Float?
  discountedPrice      Float?
  flashSalePrice       Float?
  unit                 String?         @default("phần")
  taxPercentage        Float           @default(0)
  isTaxIncludedInPrice Boolean         @default(true)
  badge                String?
  imageUrl             String?
  videoUrl             String?         @db.Text
  available            Boolean         @default(true)
  isBestSeller         Boolean         @default(false)
  isAiRecommended      Boolean         @default(false)
  avgRating            Float           @default(0)
  soldQuantity         Int             @default(0)
  isRedeemable         Boolean         @default(false)
  redemptionPoints     Int?
  categoryId           String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  spiciness            Int             @default(0)
  targetAudience       String?         @default("Mọi lứa tuổi")
  FlashSaleItem        FlashSaleItem[]
  optionGroups         OptionGroup[]
  orderItems           OrderItem[]
  category             Category        @relation(fields: [categoryId], references: [id])
  branches             Branch[]        @relation("ProductToBranch")
  favoritedBy          User[]          @relation("UserFavoriteItems")
  ComboItem            ComboItem[]

  @@index([categoryId], map: "Product_categoryId_fkey")
}

model OptionGroup {
  id             String       @id @default(uuid())
  productId      String
  name           String
  isRequired     Boolean      @default(false)
  multipleChoice Boolean      @default(false)
  minSelect      Int          @default(0)
  maxSelect      Int          @default(1)
  displayOrder   Int          @default(0)
  createdAt      DateTime     @default(now())
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionItems    OptionItem[]

  @@index([productId], map: "OptionGroup_productId_fkey")
}

model OptionItem {
  id               String            @id @default(uuid())
  optionGroupId    String
  name             String
  priceAdjustment  Float             @default(0)
  isDefault        Boolean           @default(false)
  available        Boolean           @default(true)
  displayOrder     Int               @default(0)
  maxQuantity      Int               @default(1)
  optionGroup      OptionGroup       @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  orderItemOptions OrderItemOption[]

  @@index([optionGroupId], map: "OptionItem_optionGroupId_fkey")
}

model Reservation {
  id              String            @id @default(uuid())
  userId          String
  branchId        String
  reservationDate DateTime          @db.Date
  reservationTime String
  partySize       Int
  tablePreference String?
  specialRequests String?           @db.Text
  status          ReservationStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  branch          Branch            @relation(fields: [branchId], references: [id])
  user            User              @relation(fields: [userId], references: [id])

  @@index([branchId], map: "Reservation_branchId_fkey")
  @@index([userId], map: "Reservation_userId_fkey")
}

model Order {
  id                 String             @id @default(uuid())
  orderCode          String             @unique
  userId             String
  branchId           String
  customerName       String
  customerPhone      String
  deliveryAddress    String             @db.Text
  latitude           Float?
  longitude          Float?
  note               String?            @db.Text
  subTotal           Float
  shippingFee        Float              @default(0)
  discountAmount     Float              @default(0)
  totalAmount        Float
  voucherId          String?
  paymentMethod      String             @default("COD")
  paymentStatus      String             @default("PENDING")
  transactionId      String?
  pointsUsed         Int                @default(0)
  pointsAwarded      Int                @default(0)
  status             OrderStatus        @default(PENDING)
  cancelReason       String?            @db.Text
  canceledBy         String?
  isInvoiceRequested Boolean            @default(false)
  invoiceCompanyName String?
  isViewedByAdmin    Boolean            @default(false)
  invoiceTaxCode     String?
  invoiceAddress     String?            @db.Text
  invoiceEmail       String?
  confirmedAt        DateTime?
  deliveringAt       DateTime?
  deliveredAt        DateTime?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  branch             Branch             @relation(fields: [branchId], references: [id])
  user               User               @relation(fields: [userId], references: [id])
  voucher            Voucher?           @relation(fields: [voucherId], references: [id])
  orderItems         OrderItem[]
  PointTransaction   PointTransaction[]

  @@index([branchId], map: "Order_branchId_fkey")
  @@index([userId], map: "Order_userId_fkey")
  @@index([voucherId], map: "Order_voucherId_fkey")
}

model OrderItem {
  id                  String            @id @default(uuid())
  orderId             String
  productId           String
  quantity            Int
  priceAtSale         Float
  originalPriceAtSale Float
  note                String?           @db.Text
  optionsTextSnapshot String?           @db.Text
  isFlashSaleItem     Boolean           @default(false)
  flashSaleId         String?
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product           @relation(fields: [productId], references: [id])
  selectedOptions     OrderItemOption[]

  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([productId], map: "OrderItem_productId_fkey")
}

model OrderItemOption {
  id                    String     @id @default(uuid())
  orderItemId           String
  optionItemId          String
  nameAtSale            String
  priceAdjustmentAtSale Float
  optionItem            OptionItem @relation(fields: [optionItemId], references: [id])
  orderItem             OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([optionItemId], map: "OrderItemOption_optionItemId_fkey")
  @@index([orderItemId], map: "OrderItemOption_orderItemId_fkey")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  title       String
  content     String           @db.Text
  type        NotificationType @default(SYSTEM)
  isRead      Boolean          @default(false)
  referenceId String?
  url         String?
  imageUrl    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Notification_userId_fkey")
}

model Voucher {
  id                String          @id @default(uuid())
  code              String          @unique
  title             String
  description       String?         @db.Text
  discountType      DiscountType    @default(FIXED_AMOUNT)
  discountValue     Float
  maxDiscount       Float?
  minOrderValue     Float           @default(0)
  usageLimit        Int?
  usageLimitPerUser Int?            @default(1)
  usedCount         Int             @default(0)
  isPublic          Boolean         @default(true)
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean         @default(true)
  imageUrl          String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  orders            Order[]
  membershipTiers   MembershipTier[] @relation("VoucherToMembershipTier")
  branches          Branch[]        @relation("VoucherToBranch")
}

model FlashSale {
  id        String          @id @default(uuid())
  name      String
  startTime DateTime
  endTime   DateTime
  isActive  Boolean         @default(true)
  imageUrl  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     FlashSaleItem[]
  branches  Branch[]        @relation("FlashSaleToBranch")
  membershipTiers MembershipTier[] @relation("FlashSaleToMembershipTier")
}

model FlashSaleItem {
  id                 String    @id @default(uuid())
  flashSaleId        String
  productId          String
  flashSalePrice     Float
  stock              Int
  sold               Int       @default(0)
  maxQuantityPerUser Int?
  flashSale          FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product            Product   @relation(fields: [productId], references: [id])

  @@index([flashSaleId], map: "FlashSaleItem_flashSaleId_fkey")
  @@index([productId], map: "FlashSaleItem_productId_fkey")
}

model MembershipTier {
  id                String             @id @default(uuid())
  name              String             @unique
  minSpending       Float              @default(0)
  pointMultiplier   Float              @default(1)
  discountPercent   Float              @default(0)
  imageUrl          String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  pointTransactions PointTransaction[]
  users             User[]
  vouchers          Voucher[]          @relation("VoucherToMembershipTier")
  flashSales        FlashSale[]        @relation("FlashSaleToMembershipTier")
  combos            Combo[]            @relation("ComboToMembershipTier")
}

model PointTransaction {
  id                 String                 @id @default(uuid())
  userId             String
  membershipTierId   String?
  membershipTierName String?
  balanceBefore      Int
  amount             Int
  balanceAfter       Int
  source             PointTransactionSource
  orderId            String?
  orderCode          String?
  referenceCode      String?
  description        String?                @db.Text
  expiresAt          DateTime?
  createdBy          String?
  createdAt          DateTime               @default(now())
  membershipTier     MembershipTier?        @relation(fields: [membershipTierId], references: [id])
  order              Order?                 @relation(fields: [orderId], references: [id])
  user               User                   @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, source])
  @@index([userId, membershipTierId])
  @@index([orderCode])
  @@index([orderId])
  @@index([referenceCode])
  @@index([membershipTierId], map: "PointTransaction_membershipTierId_fkey")
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String?
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  user      User?         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([updatedAt])
}

model ChatMessage {
  id             String          @id @default(uuid())
  sessionId      String
  senderType     ChatSenderType
  content        String          @db.Text
  functionName   String?
  functionArgs   String?         @db.Text
  functionResult String?         @db.Text
  actionType     ChatActionType?
  actionPayload  String?         @db.Text
  createdAt      DateTime        @default(now())
  session        ChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

enum RoleType {
  ADMIN
  MANAGER
  CHEF
  USER
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
}

enum ServingType {
  DINE_IN
  TAKE_AWAY
  DELIVERY
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DELIVERING
  COMPLETED
  CANCELLED
}

enum NotificationType {
  ORDER
  PROMOTION
  REWARD
  SYSTEM
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIP
}

enum PointTransactionSource {
  ORDER
  REWARD
  SYSTEM
  ADMIN
  BONUS
  BIRTHDAY
  REFUND
  EXPIRED
  PROMOTION
}

enum ChatSenderType {
  USER
  AI
  TOOL
  SYSTEM
}

enum ChatActionType {
  ADD_TO_CART
  ADD_ALL_TO_CART
  SHOW_PRODUCT
  SHOW_ORDER
  CONFIRM_CANCEL
  CONFIRM_RESERVATION
  SHOW_VOUCHERS
  NAVIGATE
  REQUEST_LOCATION
  ORDER_PREVIEW
  PLACE_ORDER
}

model Combo {
  id            String      @id @default(uuid())
  name          String
  description   String?     @db.Text
  price         Float
  originalPrice Float?
  imageUrl      String?
  isActive      Boolean     @default(true)
  usageLimit    Int?
  usedCount     Int         @default(0)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  branches      Branch[]    @relation("ComboToBranch")
  items         ComboItem[]
  membershipTiers MembershipTier[] @relation("ComboToMembershipTier")
}

model ComboItem {
  id        String  @id @default(uuid())
  comboId   String
  productId String
  quantity  Int     @default(1)
  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([comboId])
  @@index([productId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  target    String
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "AuditLog_userId_fkey")
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
