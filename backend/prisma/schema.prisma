  vouchers          ArticleVoucher[]
  reactions         ArticleReaction[]
  comments          ArticleComment[]
  favorites         ArticleFavorite[]
  interactionEvents ArticleInteractionEvent[]
  campaigns         ArticleNotificationCampaign[]

