model Article {
  id            String            @id @default(uuid())
  title         String
  slug          String            @unique
  excerpt       String?           @db.Text
  content       String            @db.LongText
  thumbnailUrl  String?           @db.Text
  coverImageUrl String?           @db.Text
  authorId      String
  articleType   ArticleType       @default(NEWS)
  status        ArticleStatus     @default(DRAFT)
  visibility    ArticleVisibility @default(PUBLIC)
  publishedAt   DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  // Counters & Engagement Flags
  viewCount     Int     @default(0)
  shareCount    Int     @default(0)
  isFeatured    Boolean @default(false)
  allowComment  Boolean @default(true)
  allowReaction Boolean @default(true)
  allowShare    Boolean @default(true)

  // SEO
  seoTitle       String?
  seoDescription String? @db.Text
  canonicalUrl   String?

  // Promotion Details
  promotionStartAt DateTime?
  promotionEndAt   DateTime?
  promotionLabel   String?
  promotionTerms   String?   @db.Text

  // Relations
  author            User                          @relation("ArticleAuthor", fields: [authorId], references: [id])
  branches          Branch[]                      @relation("ArticleToBranch")
  membershipTiers   MembershipTier[]              @relation("ArticleToMembershipTier")
  products          ArticleProduct[]
  vouchers          ArticleVoucher[]
  reactions         ArticleReaction[]
  comments          ArticleComment[]
  favorites         ArticleFavorite[]
  interactionEvents ArticleInteractionEvent[]
  campaigns         ArticleNotificationCampaign[]

  @@index([authorId])
  @@index([status, publishedAt])
  @@index([articleType, status])
  @@index([visibility])
  @@index([isFeatured])
  @@index([createdAt])
}

model ArticleProduct {
  id           String  @id @default(uuid())
  articleId    String
  productId    String
  displayOrder Int     @default(0)
  article      Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([articleId, productId])
  @@index([productId])
  @@index([articleId])
}

model ArticleVoucher {
  id        String  @id @default(uuid())
  articleId String
  voucherId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([articleId, voucherId])
  @@index([voucherId])
  @@index([articleId])
}

model ArticleReaction {
  id        String       @id @default(uuid())
  articleId String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([articleId, type])
  @@index([userId])
}

model ArticleComment {
  id        String        @id @default(uuid())
  articleId String
  userId    String
  parentId  String?
  content   String        @db.Text
  status    CommentStatus @default(ACTIVE)
  isEdited  Boolean       @default(false)
  editedAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  article Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
