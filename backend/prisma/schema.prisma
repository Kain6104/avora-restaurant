  user               User                   @relation(fields: [userId], references: [id])
  orderReview        OrderReview?

  @@index([userId, createdAt])
  @@index([userId, source])
  @@index([userId, membershipTierId])
  @@index([orderCode])
  @@index([orderId])
  @@index([referenceCode])
  @@index([membershipTierId], map: "PointTransaction_membershipTierId_fkey")
}

model ChatSession {
  id          String        @id @default(uuid())
  userId      String?
  title       String?
  contextData String?       @db.Text
  channel     String?       @default("TEXT")
  createdAt   DateTime      @default(now())
