}

model RestaurantTable {
  id                   String                 @id @default(uuid())
  branchId             String
  areaId               String?
  tableCode            String
  name                 String
  capacity             Int
  minCapacity          Int                    @default(1)
  status               TableOperationalStatus @default(ACTIVE)
