model FarmGardenAsset {
  id               String             @id @default(uuid())
  code             String             @unique
  name             String
  category         String
  originalUrl      String?
  avifUrl          String?
  webpUrl          String?
  fallbackUrl      String
  originalFormat   String
  mimeType         String
  originalFileSize Int
  width            Int
  height           Int
  hasAlpha         Boolean            @default(true)
  defaultAnchorX   Float              @default(0.5)
  defaultAnchorY   Float              @default(1.0)
  defaultScale     Float              @default(1.0)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  objects          FarmGardenObject[]
}

model FarmGardenObject {
  id              String                @id @default(uuid())
  objectKey       String
  layoutVersionId String
  objectType      FarmGardenObjectType
  assetId         String?
  parentId        String?
  plotIndex       Int?
  name            String?
  positionX       Float
  positionY       Float
  width           Float
  height          Float
  scaleX          Float                 @default(1.0)
  scaleY          Float                 @default(1.0)
  rotation        Float                 @default(0.0)
  opacity         Float                 @default(1.0)
  zIndex          Int                   @default(0)
  anchorX         Float                 @default(0.5)
  anchorY         Float                 @default(1.0)
  flipX           Boolean               @default(false)
  flipY           Boolean               @default(false)
  isVisible       Boolean               @default(true)
  isLocked        Boolean               @default(false)
  displayMode     FarmGardenDisplayMode @default(ALWAYS)
  deviceMode      FarmGardenDeviceMode  @default(ALL)
  animationConfig Json?
  styleConfig     Json?
  startAt         DateTime?
  endAt           DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  layoutVersion FarmGardenLayoutVersion @relation(fields: [layoutVersionId], references: [id], onDelete: Cascade)
  asset         FarmGardenAsset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  parent        FarmGardenObject?       @relation("GardenObjectHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      FarmGardenObject[]      @relation("GardenObjectHierarchy")

  @@unique([layoutVersionId, objectKey])
  @@unique([layoutVersionId, plotIndex])
  @@index([layoutVersionId, objectType])
  @@index([parentId])
