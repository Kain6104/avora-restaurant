enum FarmGardenLayoutStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FarmGardenObjectType {
  PLOT
  DECORATION
  TREE
  EFFECT
}

enum FarmGardenDisplayMode {
  ALWAYS
  DAY_ONLY
  NIGHT_ONLY
}

enum FarmGardenDeviceMode {
  ALL
  DESKTOP_ONLY
  MOBILE_ONLY
}

model FarmGardenLayout {
  id          String                    @id @default(uuid())
  code        String                    @unique
  name        String
  description String?                   @db.Text
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  versions    FarmGardenLayoutVersion[]
}

model FarmGardenLayoutVersion {
  id                String                 @id @default(uuid())
  layoutId          String
  version           Int
  status            FarmGardenLayoutStatus
  revision          Int                    @default(0)
  createdByUserId   String
  publishedByUserId String?
  publishedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  layout          FarmGardenLayout   @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  createdByUser   User               @relation("GardenLayoutCreatedBy", fields: [createdByUserId], references: [id])
  publishedByUser User?              @relation("GardenLayoutPublishedBy", fields: [publishedByUserId], references: [id])
