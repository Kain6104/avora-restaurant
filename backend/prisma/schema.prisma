  endAt           DateTime
  blockType       String   @default("FULL_BLOCK") // FULL_BLOCK, CAPACITY_BLOCK
  blockedCapacity Int?
  areaId          String?
  reason          String
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, startAt, endAt])
}

model ReservationReminderLog {
  id            String      @id @default(uuid())
  reservationId String
  reminderType  String // REMINDER_24H, REMINDER_2H
  scheduledFor  DateTime
  sentAt        DateTime    @default(now())
  status        String      @default("SENT")
  error         String?     @db.Text
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, reminderType])
  @@index([reservationId])
}

model ReservationSlotLock {
  id                    String   @id @default(uuid())
  branchId              String
  slotKey               String // YYYY-MM-DD_HH:mm
  currentBookedCapacity Int      @default(0)
  updatedAt             DateTime @updatedAt
  branch                Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, slotKey])
  @@index([branchId, slotKey])
}

model ReservationWaitlist {
  id               String    @id @default(uuid())
  branchId         String
  userId           String?
  customerName     String
  customerPhone    String
  customerEmail    String?
  requestedStartAt DateTime
  partySize        Int
  status           String    @default("WAITING") // WAITING, NOTIFIED, CONVERTED, CANCELLED, EXPIRED
  note             String?   @db.Text
  notifiedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  branch           Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, requestedStartAt])
  @@index([customerPhone])
}

model OrderRelation {
  id            String            @id @default(uuid())
  parentOrderId String
  childOrderId  String
  type          OrderRelationType // SPLIT_FROM, MERGED_INTO
  metadata      String?           @db.Text
  createdAt     DateTime          @default(now())

  parentOrder Order @relation("ParentOrderRelations", fields: [parentOrderId], references: [id], onDelete: Cascade)
  childOrder  Order @relation("ChildOrderRelations", fields: [childOrderId], references: [id], onDelete: Cascade)

  @@index([parentOrderId])
  @@index([childOrderId])
}

model OrderItemTransferLog {
  id                 String   @id @default(uuid())
  sourceOrderId      String
  targetOrderId      String
  productId          String
  quantity           Int
  actorId            String?
  reason             String?
  sourceItemSnapshot String?  @db.Text
  createdAt          DateTime @default(now())

  @@index([sourceOrderId])
  @@index([targetOrderId])
  @@index([createdAt])
}

model OrderSequence {
  id         String   @id @default(uuid())
  branchId   String
  date       String // Format: DDMMYY e.g. "070926"
  type       String   @default("POS")
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date, type])
  @@index([branchId, date])
}

model OrderServiceCharge {
  id            String   @id @default(uuid())
  orderId       String
  name          String
  amount        Float
  note          String?  @db.Text
  isTaxable     Boolean  @default(false)
  taxPercentage Float?   @default(0)
  createdBy     String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model TableSession {
  id              String             @id @default(uuid())
  branchId        String
  tableId         String
  status          TableSessionStatus @default(ACTIVE)
  openedAt        DateTime           @default(now())
  closedAt        DateTime?
  guestCount      Int                @default(1)
  cashierId       String?
  order           Order?
  table           RestaurantTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  branch          Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  qrOrderSessions QrOrderSession[]

  @@index([branchId, tableId, status])
}

model OrderPayment {
  id             String              @id @default(uuid())
  orderId        String
  paymentMethod  String // CASH, CARD, TRANSFER, PAYOS, MOMO, VNPAY, POINT
  amount         Float
  status         PaymentRecordStatus @default(COMPLETED)
  transactionRef String?
  cashReceived   Float?
  cashChange     Float?
  cardType       String?
  cardLast4      String?
  note           String?             @db.Text
  cashierId      String?
  shiftId        String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shift   CashShift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  refunds PaymentRefund[]

  @@index([orderId])
  @@index([shiftId])
  @@index([paymentMethod])
  @@index([createdAt])
}

model PaymentRefund {
  id             String   @id @default(uuid())
  orderPaymentId String
  amount         Float
  reason         String?  @db.Text
  cashierId      String?
  createdAt      DateTime @default(now())

  payment OrderPayment @relation(fields: [orderPaymentId], references: [id], onDelete: Cascade)

  @@index([orderPaymentId])
}

model CashShift {
  id              String      @id @default(uuid())
  branchId        String
  cashierId       String
  status          ShiftStatus @default(OPEN)
  openedAt        DateTime    @default(now())
  closedAt        DateTime?
  openingBalance  Float       @default(0)
  closingBalance  Float?
  expectedBalance Float?
  cashDifference  Float?
  totalRevenue    Float       @default(0)
  totalCash       Float       @default(0)
  totalCard       Float       @default(0)
  totalTransfer   Float       @default(0)
  orderCount      Int         @default(0)
  note            String?     @db.Text
  openedById      String
  closedById      String?

  branch   Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashier  User           @relation("CashierShifts", fields: [cashierId], references: [id])
  openedBy User           @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedBy User?          @relation("ShiftClosedBy", fields: [closedById], references: [id])
  payments OrderPayment[]

  @@index([branchId, cashierId, status])
  @@index([openedAt])
}

model IdempotencyRecord {
  key       String   @id
  action    String
  response  String   @db.LongText
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model PrintTemplate {
  id      String            @id @default(uuid())
  name    String
  type    PrintTemplateType
  content String            @db.LongText

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  isDefault Boolean @default(false)

  paperSize String? @default("80mm")
  settings  Json?

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions  PrintTemplateVersion[]
  printJobs PrintJob[]

  @@index([branchId])
  @@index([branchId, type])
}

model PrintTemplateVersion {
  id              String   @id @default(uuid())
  printTemplateId String
  version         Int
  content         String   @db.LongText
  paperSize       String?
  settings        Json?
  createdBy       String?
  createdAt       DateTime @default(now())

  printTemplate PrintTemplate @relation(fields: [printTemplateId], references: [id], onDelete: Cascade)

  @@index([printTemplateId])
  @@index([printTemplateId, version])
}

enum PrintTemplateType {
  RECEIPT
  TEMP_BILL
  KITCHEN
  BAR
  ITEM_LABEL
  KITCHEN_TICKET
  ONLINE_ORDER
}

model VoucherPaymentMethod {
  voucherId       String
  paymentMethodId String

  voucher       Voucher       @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@id([voucherId, paymentMethodId])
  @@index([paymentMethodId])
}

enum PrinterConnectionType {
  NETWORK_DIRECT
  PRINT_AGENT
}

enum PrinterStatus {
  ONLINE
  OFFLINE
  ERROR
}

enum PrinterPayloadType {
  ESC_POS
  HTML
  PDF
  ZPL
}

enum PrintRouteRole {
  PREPARATION
  LABEL
  EXPEDITOR
}

enum PrintJobStatus {
  PENDING
  PROCESSING
  DISPATCHED
  PRINTED
  FAILED
  UNKNOWN
  CANCELED
}

enum PrintJobEventType {
  NEW_ITEM
  ADD_QUANTITY
  CANCEL_ITEM
  RETURN_ITEM
  ITEM_LABEL
  REPRINT
}

model KitchenStation {
  id          String   @id @default(uuid())
  branchId    String
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch          Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  stationPrinters KitchenStationPrinter[]
  productRoutes   ProductPrintRoute[]
  printJobs       PrintJob[]
  kitchenEvents   KitchenEvent[]

  @@unique([branchId, code])
  @@index([branchId])
}

model Printer {
  id             String                @id @default(uuid())
  branchId       String
  name           String
  connectionType PrinterConnectionType @default(NETWORK_DIRECT)
  payloadType    PrinterPayloadType    @default(ESC_POS)
  ipAddress      String?
  port           Int                   @default(9100)
  agentId        String?
  paperSize      String                @default("80mm")
  labelWidthMm   Int?
  labelHeightMm  Int?
  isActive       Boolean               @default(true)
  status         PrinterStatus         @default(ONLINE)
  lastSeenAt     DateTime?
  lastPrintAt    DateTime?
  lastError      String?               @db.Text
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  branch          Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  agent           PrintAgent?             @relation(fields: [agentId], references: [id], onDelete: SetNull)
  stationPrinters KitchenStationPrinter[]
  printJobs       PrintJob[]
  branchSettings  BranchPrinterSetting[]

  @@index([branchId])
  @@index([agentId])
}

model PrintAgent {
  id         String    @id @default(uuid())
  branchId   String
  agentCode  String    @unique
  name       String
  secretHash String
  salt       String
  isActive   Boolean   @default(true)
  ipAddress  String?
  version    String?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  printers Printer[]

  @@index([branchId])
}

model KitchenStationPrinter {
  id           String   @id @default(uuid())
  stationId    String
  printerId    String
  isPrimary    Boolean  @default(true)
  priority     Int      @default(1)
  isActive     Boolean  @default(true)
  printPurpose String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  station KitchenStation @relation(fields: [stationId], references: [id], onDelete: Restrict)
  printer Printer        @relation(fields: [printerId], references: [id], onDelete: Restrict)

  @@unique([stationId, printerId])
  @@index([stationId])
  @@index([printerId])
}

model ProductPrintRoute {
  id        String            @id @default(uuid())
  productId String
  branchId  String
  stationId String
  routeRole PrintRouteRole    @default(PREPARATION)
  printType PrintTemplateType @default(KITCHEN_TICKET)
  copies    Int               @default(1)
  priority  Int               @default(1)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  station KitchenStation @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@index([productId, branchId])
  @@index([branchId])
  @@index([stationId])
}

model PrintJob {
  id              String             @id @default(uuid())
  orderId         String
  orderItemId     String?
  branchId        String
  stationId       String
  printerId       String
  printTemplateId String?
  routeId         String?
  routeRole       PrintRouteRole     @default(PREPARATION)
  payloadType     PrinterPayloadType @default(ESC_POS)
  printType       PrintTemplateType  @default(KITCHEN_TICKET)
  eventType       PrintJobEventType  @default(NEW_ITEM)

  quantity         Int @default(1)
  quantityDelta    Int @default(1)
  printedQtyBefore Int @default(0)
  copies           Int @default(1)

  contentHtml  String  @db.LongText
  payloadData  String? @db.LongText
  snapshotData Json?

  status         PrintJobStatus @default(PENDING)
  attemptCount   Int            @default(0)
  maxAttempts    Int            @default(3)
  errorMessage   String?        @db.Text
  idempotencyKey String         @unique

  reprintOfId   String?
  reprintReason String? @db.Text
  reprintedBy   String?

  metadata  Json?
  printedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem     OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  station       KitchenStation @relation(fields: [stationId], references: [id], onDelete: Restrict)
  printer       Printer        @relation(fields: [printerId], references: [id], onDelete: Restrict)
  printTemplate PrintTemplate? @relation(fields: [printTemplateId], references: [id], onDelete: SetNull)

  @@index([branchId, status])
  @@index([orderId])
  @@index([orderItemId])
  @@index([printerId])
  @@index([reprintOfId])
}

model KitchenEvent {
  id          String            @id @default(uuid())
  orderId     String
  branchId    String
  stationId   String?
  eventType   PrintJobEventType
  itemSummary Json
  createdById String?
  createdAt   DateTime          @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branch  Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  station KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([branchId, createdAt])
}

model BranchPrinterSetting {
  id             String    @id @default(uuid())
  branchId       String
  purpose        String // RECEIPT, TEMP_BILL, KITCHEN, BAR, ITEM_LABEL
  printerId      String?
  agentPrinterId String?
  printerName    String
  driverName     String?
  portName       String?
  paperSize      String    @default("80mm")
  copies         Int       @default(1)
  isEnabled      Boolean   @default(true)
  autoPrint      Boolean   @default(false)
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  printer Printer? @relation(fields: [printerId], references: [id], onDelete: SetNull)

  @@unique([branchId, purpose])
  @@index([branchId])
  @@index([printerId])
}

// ==========================================
// HỆ THỐNG PHÂN QUYỀN RBAC ENTERPRISE
// ==========================================

enum ScopeType {
  GLOBAL
  BRANCH
  MIXED
}

enum BranchScopeType {
  ALL_BRANCHES
  SELECTED_BRANCHES
}

enum RiskLevel {
  NORMAL
  SENSITIVE
  CRITICAL
}

model AccessRole {
  id          String    @id @default(uuid())
  code        String    @unique @db.VarChar(100)
  name        String    @db.VarChar(200)
  description String?   @db.Text
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  scopeType   ScopeType @default(BRANCH)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@index([isSystem])
  @@index([isActive])
}

model Permission {
  key         String    @id @db.VarChar(100)
  groupKey    String    @db.VarChar(100)
  name        String    @db.VarChar(200)
  description String?   @db.Text
  scopeType   ScopeType @default(BRANCH)
  riskLevel   RiskLevel @default(NORMAL)
  sortOrder   Int       @default(0)

  roles RolePermission[]

  @@index([groupKey])
}

model RolePermission {
  id            String @id @default(uuid())
  roleId        String
  permissionKey String

  role       AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@index([permissionKey])
  @@index([roleId])
}

model UserRoleAssignment {
  id          String          @id @default(uuid())
  userId      String
  roleId      String
  branchScope BranchScopeType @default(ALL_BRANCHES)
  isPrimary   Boolean         @default(false)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     AccessRole       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branches UserRoleBranch[]

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model UserRoleBranch {
  id           String @id @default(uuid())
  assignmentId String
  branchId     String

  assignment UserRoleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, branchId])
  @@index([assignmentId])
  @@index([branchId])
}

// ====================================================================
// BUFFET ENGINE & QR ORDER ENGINE MODELS
// ====================================================================

model BuffetPackage {
  id           String   @id @default(uuid())
  branchId     String
  name         String
  description  String?  @db.Text
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch   Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tickets  BuffetPackageTicket[]
  items    BuffetPackageItem[]
  sessions BuffetSession[]

  @@index([branchId, active])
}

model BuffetPackageTicket {
  id              String   @id @default(uuid())
  buffetPackageId String
  productId       String
  createdAt       DateTime @default(now())

  buffetPackage BuffetPackage @relation(fields: [buffetPackageId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([buffetPackageId, productId])
  @@index([productId])
}

model BuffetPackageItem {
  id                  String   @id @default(uuid())
  buffetPackageId     String
  productId           String
  displayOrder        Int      @default(0)
  maxQuantityPerRound Int?
  availableForQr      Boolean  @default(true)
  allowRetailPurchase Boolean  @default(true)
  createdAt           DateTime @default(now())

  buffetPackage BuffetPackage @relation(fields: [buffetPackageId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([buffetPackageId, productId])
  @@index([productId])
}

model BuffetSession {
  id                  String              @id @default(uuid())
  orderId             String
  buffetPackageId     String
  status              BuffetSessionStatus @default(ACTIVE)
  activatedAt         DateTime            @default(now())
  deactivatedAt       DateTime?
  activatedById       String?
  packageNameSnapshot String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buffetPackage BuffetPackage @relation(fields: [buffetPackageId], references: [id])
  orderItems    OrderItem[]

  @@index([orderId, status])
  @@index([buffetPackageId])
}

model QrOrderSession {
  id             String          @id @default(uuid())
  orderId        String
  tableSessionId String
  branchId       String
  tableId        String
  tokenHash      String          @unique
  status         QrSessionStatus @default(ACTIVE)
  createdAt      DateTime        @default(now())
  expiresAt      DateTime?
  closedAt       DateTime?
  lastActivityAt DateTime?
  createdById    String?

  order           Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tableSession    TableSession          @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  table           RestaurantTable       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  branch          Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  guests          QrOrderGuest[]
  rounds          QrOrderRound[]
  serviceRequests TableServiceRequest[]

  @@index([orderId, status])
  @@index([tableSessionId])
  @@index([branchId, tableId])
}

model QrOrderGuest {
  id               String   @id @default(uuid())
  qrOrderSessionId String
  guestName        String
  userId           String?
  deviceSessionId  String
  memberVerified   Boolean  @default(false)
  joinedAt         DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  status           String   @default("ACTIVE") // ACTIVE, LEFT

  qrOrderSession QrOrderSession @relation(fields: [qrOrderSessionId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  rounds         QrOrderRound[]

  @@index([qrOrderSessionId, status])
  @@index([userId])
  @@index([deviceSessionId])
}

model QrOrderRound {
  id               String   @id @default(uuid())
  qrOrderSessionId String
  qrGuestId        String?
  orderId          String
  roundNumber      Int      @default(1)
  idempotencyKey   String   @unique
  status           String   @default("SUBMITTED")
  submittedAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  qrOrderSession QrOrderSession @relation(fields: [qrOrderSessionId], references: [id], onDelete: Cascade)
  guest          QrOrderGuest?  @relation(fields: [qrGuestId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]

  @@index([qrOrderSessionId])
  @@index([orderId])
  @@index([qrGuestId])
}

model TableServiceRequest {
  id                String                    @id @default(uuid())
  orderId           String?
  tableId           String
  tableSessionId    String?
  branchId          String
  qrOrderSessionId  String?
  qrGuestId         String?
  requestType       TableServiceRequestType
  paymentMethodCode String?
  status            TableServiceRequestStatus @default(OPEN)
  note              String?                   @db.Text
  acknowledgedAt    DateTime?
  completedAt       DateTime?
  acknowledgedById  String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  order          Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  table          RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  qrOrderSession QrOrderSession? @relation(fields: [qrOrderSessionId], references: [id], onDelete: SetNull)

  @@index([branchId, status])
  @@index([tableId, status])
  @@index([orderId])
}

model DesktopLaunchCode {
  id           String    @id @default(uuid())
  code         String    @unique @db.VarChar(128)
  userId       String
  branchId     String?
  deviceId     String?
  appVersion   String?
  expiresAt    DateTime
  consumedAt   DateTime?
  consumedByIp String?
  createdIp    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model PosDevice {
  id           String    @id @default(uuid())
  deviceId     String    @unique @db.VarChar(128)
  deviceSecret String    @db.VarChar(255)
  name         String?   @db.VarChar(100)
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([deviceId])
}

