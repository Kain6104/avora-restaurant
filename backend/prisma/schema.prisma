  @@index([startTime, endTime, isActive])
  @@index([status])
}

model FlashSaleSlot {
  id            String    @id @default(uuid())
  flashSaleId   String
  name          String
  startTime     DateTime
  endTime       DateTime
  teaserStartAt DateTime?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  flashSale FlashSale           @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  items     FlashSaleItem[]
  reminders FlashSaleReminder[]

  @@index([flashSaleId])
  @@index([startTime, endTime])
}

model FlashSaleItem {
  id                    String  @id @default(uuid())
  flashSaleId           String
  flashSaleSlotId       String?
  productId             String
  flashSalePrice        Float
  originalPriceSnapshot Float?
  stock                 Int
  reservedStock         Int     @default(0)
  sold                  Int     @default(0)
  maxQuantityPerUser    Int?
  maxQuantityPerOrder   Int?
  sortOrder             Int     @default(0)
  isActive              Boolean @default(true)

  flashSale FlashSale      @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  slot      FlashSaleSlot? @relation(fields: [flashSaleSlotId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])

  @@index([flashSaleId], map: "FlashSaleItem_flashSaleId_fkey")
  @@index([flashSaleSlotId])
  @@index([productId], map: "FlashSaleItem_productId_fkey")
}

model FlashSaleAuditLog {
  id          String   @id @default(uuid())
  flashSaleId String
  userId      String?
  userName    String?
  action      String
  oldValue    String?  @db.LongText
  newValue    String?  @db.LongText
  branchId    String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)

  @@index([flashSaleId])
  @@index([createdAt])
}

model FlashSaleReminder {
  id          String   @id @default(uuid())
  userId      String
  flashSaleId String
  slotId      String?
  productId   String?
  reminded    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashSale FlashSale      @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  slot      FlashSaleSlot? @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([userId, flashSaleId, slotId, productId])
  @@index([userId])
  @@index([flashSaleId])
}

model MembershipTier {
  id                String             @id @default(uuid())
  name              String             @unique
  minSpending       Float              @default(0)
  pointMultiplier   Float              @default(1)
  discountPercent   Float              @default(0)
  imageUrl          String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  pointTransactions PointTransaction[]
  users             User[]
  vouchers          Voucher[]          @relation("VoucherToMembershipTier")
  flashSales        FlashSale[]        @relation("FlashSaleToMembershipTier")
  combos            Combo[]            @relation("ComboToMembershipTier")
  articles          Article[]          @relation("ArticleToMembershipTier")
}

model PointTransaction {
  id                 String                 @id @default(uuid())
  userId             String
  membershipTierId   String?
  membershipTierName String?
  balanceBefore      Int
  amount             Int
  balanceAfter       Int
  source             PointTransactionSource
  orderId            String?
  orderCode          String?
  referenceCode      String?
  description        String?                @db.Text
  expiresAt          DateTime?
  createdBy          String?
