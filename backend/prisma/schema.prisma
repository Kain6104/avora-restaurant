model Article {
  id            String            @id @default(uuid())
  title         String
  slug          String            @unique
  excerpt       String?           @db.Text
  content       String            @db.LongText
  thumbnailUrl  String?           @db.Text
  coverImageUrl String?           @db.Text
  authorId      String
  articleType   ArticleType       @default(NEWS)
  status        ArticleStatus     @default(DRAFT)
  visibility    ArticleVisibility @default(PUBLIC)
  publishedAt   DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  // Counters & Engagement Flags
  viewCount     Int     @default(0)
  shareCount    Int     @default(0)
  isFeatured    Boolean @default(false)
  allowComment  Boolean @default(true)
  allowReaction Boolean @default(true)
  allowShare    Boolean @default(true)

  // SEO
  seoTitle       String?
  seoDescription String? @db.Text
  canonicalUrl   String?

  // Promotion Details
  promotionStartAt DateTime?
  promotionEndAt   DateTime?
  promotionLabel   String?
  promotionTerms   String?   @db.Text

  // Relations
  author            User                          @relation("ArticleAuthor", fields: [authorId], references: [id])
  branches          Branch[]                      @relation("ArticleToBranch")
  membershipTiers   MembershipTier[]              @relation("ArticleToMembershipTier")
  products          ArticleProduct[]
  vouchers          ArticleVoucher[]
  reactions         ArticleReaction[]
  comments          ArticleComment[]
  favorites         ArticleFavorite[]
  interactionEvents ArticleInteractionEvent[]
  campaigns         ArticleNotificationCampaign[]

  @@index([authorId])
  @@index([status, publishedAt])
  @@index([articleType, status])
  @@index([visibility])
  @@index([isFeatured])
  @@index([createdAt])
}

model ArticleProduct {
  id           String  @id @default(uuid())
  articleId    String
  productId    String
  displayOrder Int     @default(0)
  article      Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([articleId, productId])
  @@index([productId])
  @@index([articleId])
}

model ArticleVoucher {
  id        String  @id @default(uuid())
  articleId String
  voucherId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([articleId, voucherId])
  @@index([voucherId])
  @@index([articleId])
}

model ArticleReaction {
  id        String       @id @default(uuid())
  articleId String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([articleId, type])
  @@index([userId])
}

model ArticleComment {
  id        String        @id @default(uuid())
  articleId String
  userId    String
  parentId  String?
  content   String        @db.Text
  status    CommentStatus @default(ACTIVE)
  isEdited  Boolean       @default(false)
  editedAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  article Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  ArticleComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ArticleComment[] @relation("CommentReplies")

  @@index([articleId, createdAt])
  @@index([parentId])
  @@index([userId])
  @@index([status])
}

model ArticleFavorite {
  id        String   @id @default(uuid())
  articleId String
  userId    String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([userId, createdAt])
  @@index([articleId])
}

model ArticleInteractionEvent {
  id        String                 @id @default(uuid())
  articleId String
  userId    String?
  sessionId String?
  productId String?
  voucherId String?
  type      ArticleInteractionType
  ipAddress String?
  userAgent String?
  createdAt DateTime               @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, type, createdAt])
  @@index([articleId, productId])
  @@index([userId, type])
}

model ArticleNotificationCampaign {
  id              String         @id @default(uuid())
  articleId       String
  createdById     String
  title           String
  content         String         @db.Text
  targetType      String // ALL, BRANCH, MEMBERSHIP_TIER, SPECIFIC_USERS, TIER_AND_BRANCH
  targetBranchIds String?        @db.Text // JSON string
  targetTierIds   String?        @db.Text // JSON string
  targetUserIds   String?        @db.Text // JSON string
  totalRecipients Int            @default(0)
  sentCount       Int            @default(0)
  failedCount     Int            @default(0)
  status          CampaignStatus @default(DRAFT)
  idempotencyKey  String?        @unique
  createdAt       DateTime       @default(now())
  sentAt          DateTime?

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

