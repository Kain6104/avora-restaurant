  thumbnailUrl  String?           @db.Text
  coverImageUrl String?           @db.Text
  authorId      String
  articleType   ArticleType       @default(NEWS)
  status        ArticleStatus     @default(DRAFT)
  visibility    ArticleVisibility @default(PUBLIC)
  publishedAt   DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  // Counters & Engagement Flags
  viewCount     Int     @default(0)
  shareCount    Int     @default(0)
  isFeatured    Boolean @default(false)
  allowComment  Boolean @default(true)
  allowReaction Boolean @default(true)
  allowShare    Boolean @default(true)

  // SEO
  seoTitle       String?
  seoDescription String? @db.Text
  canonicalUrl   String?

  // Promotion Details
  promotionStartAt DateTime?
  promotionEndAt   DateTime?
  promotionLabel   String?
  promotionTerms   String?   @db.Text

