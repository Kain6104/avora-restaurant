  FRUIT
  FANTASY_FOOD
}

enum FarmRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

enum FarmMutationType {
  COLOR_MUTATION
  GIANT_MUTATION
  GOLDEN_MUTATION
  CRYSTAL_MUTATION
  SAKURA_MUTATION
  MOONLIGHT_MUTATION
  RAINBOW_MUTATION
  AVORA_MUTATION
}

enum FarmItemType {
  SEED
  CROP
  MUTATION_CROP
  FERTILIZER
  TOOL
  DECORATION
  EVENT
}

enum FarmWeatherType {
  SUNNY
  RAIN
  SAKURA_WIND
  MOONLIGHT
  GOLDEN_HOUR
  AURORA
  FESTIVAL_NIGHT
}

enum FarmMissionType {
  DAILY
  WEEKLY
  ACHIEVEMENT
  EVENT
}

enum FarmRewardCategory {
  VOUCHER
  FOOD_DISCOUNT
  FREE_SHIPPING
  SPECIAL_GIFT
  COSMETIC
}

model UserFarm {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  level                Int      @default(1)
  exp                  Int      @default(0)
  totalExp             Int      @default(0)
  farmCoin             Int      @default(100)
  energy               Int      @default(100)
  maxEnergy            Int      @default(100)
  lastEnergyRecoveryAt DateTime @default(now())

  treeExp            Int    @default(0)
  treeLevel          Int    @default(1)
  selectedTheme      String @default("JAPANESE_GARDEN")
  unlockedPlotsCount Int    @default(6)

  activeWeather    FarmWeatherType @default(SUNNY)
  weatherExpiresAt DateTime?

  dailyWaterCount      Int      @default(0)
  dailyWaterResetAt    DateTime @default(now())
  dailyGatherCount     Int      @default(0)
  dailyGatherResetAt   DateTime @default(now())
  hasCompletedTutorial Boolean  @default(false)
  pendingLevelUp       Boolean  @default(false)

  luckyEnvelopeTickets            Int @default(0)
  totalLuckyEnvelopesOpened       Int @default(0)
  totalLuckyEnvelopeTicketsEarned Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plots           FarmPlot[]
  inventory       FarmInventoryItem[]
  collections     FarmCollection[]
  activityLogs    FarmActivityLog[]
  redemptions     FarmRewardRedemption[]
  userDecorations FarmUserDecoration[]
  transactions    FarmTransaction[]

  @@index([level])
  @@index([farmCoin])
}

model FarmPlot {
  id     String   @id @default(uuid())
  farmId String
  farm   UserFarm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  plotIndex Int // 0..24
  gridRow   Int
  gridCol   Int
  worldX    Float?
  worldY    Float?

  status        FarmPlotStatus @default(LOCKED)
  soilQuality   Float          @default(1.0)
  waterLevel    Float          @default(100.0)
  lastWateredAt DateTime?

  fertilizerItemId String?
  fertilizerBonus  Float   @default(0.0)

  cropInstanceId String?           @unique
  cropInstance   FarmCropInstance? @relation(fields: [cropInstanceId], references: [id], onDelete: SetNull)

  unlockCost  Int @default(0)
  unlockLevel Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, plotIndex])
  @@index([farmId, status])
}

model FarmCrop {
  id             String           @id @default(uuid())
  code           String           @unique
  name           String
  category       FarmCropCategory
  rarity         FarmRarity       @default(COMMON)
  description    String?          @db.Text
  iconUrl        String?
  spriteAtlasKey String?

  growDuration        Int // Tính bằng giây
  seedPrice           Int
  sellPrice           Int
  baseYield           Int @default(4)
  rewardExp           Int @default(20)
  rewardFarmCoin      Int @default(15)
  rewardLoyaltyPoints Int @default(0)

  baseMutationRate Float   @default(0.05)
  minFarmLevel     Int     @default(1)
  isAvailable      Boolean @default(true)
  isEventOnly      Boolean @default(false)
  eventId          String?
  sortOrder        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mutations         FarmCropMutation[]
  instances         FarmCropInstance[]
  collections       FarmCollection[]
  recipeIngredients FarmRecipeIngredient[]

  @@index([category])
  @@index([rarity])
  @@index([minFarmLevel])
}

model FarmCropMutation {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  sourceCropId String
  sourceCrop   FarmCrop @relation(fields: [sourceCropId], references: [id], onDelete: Cascade)

  mutationType   FarmMutationType
  rarity         FarmRarity       @default(RARE)
  description    String?          @db.Text
  spriteKey      String?
  colorHex       String?
  glowEffect     String?
  particleEffect String?
  soundEffect    String?

  mutationChance      Float // Tỷ lệ tương đối
  yieldMultiplier     Float   @default(1.5)
  rewardExp           Int     @default(60)
  rewardFarmCoin      Int     @default(50)
  rewardLoyaltyPoints Int     @default(1)
  sellPrice           Int?
  collectionScore     Int     @default(100)
  isEventOnly         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instances   FarmCropInstance[]
  collections FarmCollection[]

  @@index([sourceCropId])
  @@index([rarity])
}

model FarmCropInstance {
  id         String            @id @default(uuid())
  cropId     String
  crop       FarmCrop          @relation(fields: [cropId], references: [id])
  mutationId String?
  mutation   FarmCropMutation? @relation(fields: [mutationId], references: [id])

  plot FarmPlot?

  plantedAt   DateTime  @default(now())
  stage1At    DateTime
  stage2At    DateTime
  stage3At    DateTime
  readyAt     DateTime
  harvestedAt DateTime?

  isMutated Boolean @default(false)

  cropNameSnapshot       String
  growDurationSnapshot   Int
  baseYieldSnapshot      Int
  mutationRateSnapshot   Float
  rewardExpSnapshot      Int
  rewardFarmCoinSnapshot Int

  calculatedYield  Int?
  gatheredCount    Int  @default(0)
  maxGatherAllowed Int  @default(1)
  wateredCount     Int  @default(0)
  fertilizedCount  Int  @default(0)
  version          Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cropId])
  @@index([readyAt])
  @@index([harvestedAt])
}

model FarmInventoryItem {
  id     String   @id @default(uuid())
  farmId String
  farm   UserFarm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  itemType    FarmItemType
  referenceId String
  itemName    String
  itemCode    String
  rarity      FarmRarity   @default(COMMON)
  quantity    Int          @default(0)
  isLocked    Boolean      @default(false)
  isSeen      Boolean      @default(false)
  seenAt      DateTime?
  metadata    Json?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, itemType, referenceId])
  @@index([farmId, itemType])
  @@index([farmId, isSeen])
}

model FarmCollection {
  id     String   @id @default(uuid())
  farmId String
  farm   UserFarm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  cropId     String
  crop       FarmCrop          @relation(fields: [cropId], references: [id])
  mutationId String?
  mutation   FarmCropMutation? @relation(fields: [mutationId], references: [id])

  isUnlocked        Boolean  @default(true)
  firstDiscoveredAt DateTime @default(now())
  harvestCount      Int      @default(1)
  highestYield      Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, cropId, mutationId])
  @@index([farmId])
}

model FarmMission {
  id          String          @id @default(uuid())
  code        String          @unique
  title       String
  description String?         @db.Text
  type        FarmMissionType
  actionType  String // PLANT, WATER, HARVEST, DISCOVER_MUTATION, HELP_FRIEND, ORDER_COMPLETED
  targetCount Int

  rewardExp           Int           @default(50)
  rewardFarmCoin      Int           @default(30)
  rewardLoyaltyPoints Int           @default(0)
  rewardItemId        String?
  rewardItemType      FarmItemType?
  rewardItemQty       Int           @default(0)

  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress FarmMissionProgress[]
}

model FarmMissionProgress {
  id        String      @id @default(uuid())
  userId    String
  missionId String
  mission   FarmMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  currentCount Int       @default(0)
  isCompleted  Boolean   @default(false)
  isClaimed    Boolean   @default(false)
  periodKey    String // "2026-09-13" (Daily), "2026-W37" (Weekly), "LIFETIME" (Achievement)
  completedAt  DateTime?
  claimedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, missionId, periodKey])
  @@index([userId, isClaimed])
}

model FarmReward {
  id          String             @id @default(uuid())
  code        String             @unique
  title       String
  description String?            @db.Text
  imageUrl    String?
  category    FarmRewardCategory

  voucherId String?
  voucher   Voucher? @relation(fields: [voucherId], references: [id])

  costFarmCoin      Int     @default(0)
  costLoyaltyPoints Int     @default(0)
  stock             Int?
  redeemedCount     Int     @default(0)
  limitPerUser      Int     @default(1)
  minFarmLevel      Int     @default(1)
  requiredTierId    String?

  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions FarmRewardRedemption[]

  @@index([category])
  @@index([isActive])
}

model FarmRewardRedemption {
  id       String     @id @default(uuid())
  userId   String
  farmId   String
  farm     UserFarm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  rewardId String
  reward   FarmReward @relation(fields: [rewardId], references: [id])

  farmCoinSpent      Int     @default(0)
  loyaltyPointsSpent Int     @default(0)
  voucherCodeIssued  String?
  customerVoucherId  String?
  pointTxId          String?
  status             String  @default("COMPLETED")

  createdAt DateTime @default(now())

  @@index([userId, rewardId])
  @@index([createdAt])
}

model FarmFriendAction {
  id           String   @id @default(uuid())
  actorUserId  String
  actorUser    User     @relation("FarmFriendActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  targetFarmId String
  plotIndex    Int
  actionType   String // WATER, GATHER
  yieldTaken   Int      @default(0)
  isFriend     Boolean  @default(false)
  actionDate   DateTime @db.Date
  createdAt    DateTime @default(now())

  @@index([actorUserId, actionDate])
  @@index([targetFarmId, actionDate])
}

model FarmFriendship {
  id        String   @id @default(uuid())
  userId    String
  friendId  String
  status    String   @default("ACCEPTED") // PENDING, ACCEPTED
  createdAt DateTime @default(now())

  user   User @relation("UserFarmFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendFarmUsers", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

model FarmActivityLog {
  id        String   @id @default(uuid())
  userId    String
  farmId    String
  farm      UserFarm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  action    String // PLANT, WATER, FERTILIZE, HARVEST, MUTATION, PURCHASE, REDEEM, FRIEND_HELP, FRIEND_GATHER
  plotIndex Int?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, action, createdAt])
  @@index([farmId, createdAt])
}

model FarmDecoration {
  id            String  @id @default(uuid())
  code          String  @unique
  name          String
  category      String // FENCE, LANTERN, SAKURA, BENCH, STATUE, KOI_POND, PATH
  iconUrl       String?
  spriteKey     String
  priceFarmCoin Int     @default(100)
  buffType      String? // GROWTH_SPEED, MUTATION_CHANCE, TREE_XP
  buffValue     Float   @default(0.0)
  unlockLevel   Int     @default(1)
  isAvailable   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FarmUserDecoration {
  id     String   @id @default(uuid())
  farmId String
  farm   UserFarm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  decorationCode String
  placedX        Float
  placedY        Float
  isPlaced       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
}

model FarmRecipe {
  id                  String  @id @default(uuid())
  code                String  @unique
  name                String
  description         String? @db.Text
  dishImageUrl        String?
  rewardExp           Int     @default(100)
  rewardFarmCoin      Int     @default(80)
  rewardLoyaltyPoints Int     @default(5)
  voucherRewardId     String?
  unlockLevel         Int     @default(5)
  isActive            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients FarmRecipeIngredient[]
}

model FarmRecipeIngredient {
  id          String     @id @default(uuid())
  recipeId    String
  recipe      FarmRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  cropId      String
  crop        FarmCrop   @relation(fields: [cropId], references: [id])
  requiredQty Int        @default(1)

  @@unique([recipeId, cropId])
}

model FarmPlantAsset {
  id           String  @id @default(uuid())
  cropCode     String // e.g. "JAPANESE_RICE", "STRAWBERRY", "GRAPE"
  cropName     String?
  assetType    String // "STAGE" or "MUTATION"
  stageIndex   Int? // 0..5
  mutationCode String? // e.g. "MOONLIGHT_RICE", "GOLDEN_RICE"
  mutationName String? // e.g. "Lúa Nguyệt Quang"

  originalUrl String?
  avifUrl     String
  webpUrl     String
  fallbackUrl String?

  originalFormat   String? @default("png")
  originalFileSize Int?    @default(0)
  avifFileSize     Int?    @default(0)
  webpFileSize     Int?    @default(0)

  width    Int?    @default(128)
  height   Int?    @default(136)
  hasAlpha Boolean @default(true)

  renderScale   Float @default(1.0)
  renderOffsetX Float @default(0.0)
  renderOffsetY Float @default(0.0)
  anchorX       Float @default(0.5)
  anchorY       Float @default(0.85)

  version  Int     @default(1)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cropCode, assetType, stageIndex, mutationCode])
  @@index([cropCode])
  @@index([assetType])
}

model FarmLuckyEnvelopeConfig {
  id                         String   @id @default(uuid())
  key                        String   @unique @default("DEFAULT")
  isEventActive              Boolean  @default(true)
  allowExistingTicketsToOpen Boolean  @default(true)
  maxVisibleEnvelopes        Int      @default(8)
  ticketsPerMission          Int      @default(1)
  updatedAt                  DateTime @updatedAt
}

model FarmLuckyEnvelopeReward {
  id           String     @id @default(uuid())
  name         String
  description  String?    @db.Text
  rewardType   String // COIN, EXP, ENERGY, SEED, FERTILIZER, MUTATION_CROP, DECORATION, CUSTOM
  referenceId  String? // e.g. 'ORGANIC_MUTATION_FERTILIZER', 'JAPANESE_RICE'
  minAmount    Int        @default(1)
  maxAmount    Int        @default(1)
  rarity       FarmRarity @default(COMMON)
  weight       Float      @default(50) // Weighted Random Selection
  imageUrl     String?
  isActive     Boolean    @default(true)
  globalStock  Int? // null = unlimited
  claimedStock Int        @default(0)
  perUserLimit Int? // null = unlimited
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  openings FarmLuckyEnvelopeOpening[]

  @@index([rarity])
  @@index([isActive])
}

model FarmLuckyEnvelopeOpening {
  id       String                  @id @default(uuid())
  userId   String
  user     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId String
  reward   FarmLuckyEnvelopeReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  rewardType   String
  rewardName   String
  rewardAmount Int
  rarity       FarmRarity
  referenceId  String?
  ticketSource String     @default("MISSION")
  missionId    String?

  openedAt DateTime @default(now())

  @@index([userId, openedAt])
  @@index([rewardId])
}

model FarmTransaction {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation("UserFarmTransactions", fields: [userId], references: [id], onDelete: Cascade)
  farmId            String?
  farm              UserFarm? @relation(fields: [farmId], references: [id], onDelete: Cascade)
  type              String // SEED_PURCHASE, ITEM_PURCHASE, PRODUCE_SALE, VOUCHER_REDEMPTION, COIN_TO_POINT_EXCHANGE, MISSION_REWARD, LEVEL_REWARD, ADMIN_GIFT, MAINTENANCE_GIFT, FRIEND_STEAL_GAIN, FRIEND_STEAL_LOSS, FRIEND_WATER, SYSTEM_COMPENSATION, LUCKY_ENVELOPE_REWARD
  source            String    @default("SYSTEM") // SHOP, REDEMPTION, EXCHANGE, MAILBOX, SOCIAL, MISSION, LUCKY_ENVELOPE, ADMIN
  referenceId       String?
  itemId            String?
  itemCode          String?
  itemNameSnapshot  String?
  itemIconUrl       String?
  quantity          Int       @default(0)
  unitPrice         Float     @default(0)
  totalValue        Float     @default(0)
  farmCoinDelta     Int       @default(0)
  avoraPointDelta   Int       @default(0)
  balanceCoinAfter  Int?
  balancePointAfter Int?
  status            String    @default("COMPLETED")
  metadata          Json?
  createdAt         DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([type, createdAt])
  @@index([referenceId])
  @@index([farmId])
}

model FarmMail {
  id          String    @id @default(uuid())
  title       String
  sender      String    @default("Hệ thống AVORA")
  content     String    @db.Text
  bannerUrl   String?
  type        String    @default("SYSTEM") // MAINTENANCE, EVENT, COMPENSATION, ADMIN_CUSTOM, SYSTEM, SEASONAL
  targetType  String    @default("ALL") // ALL, SPECIFIC_USERS, LEVEL_RANGE, MEMBERSHIP_TIER, INACTIVE_USERS, BRANCH
  targetValue String?
  rewards     Json // Array of rewards: [{ type: 'COIN'|'AVORA_POINT'|'SEED'|'PRODUCE'|'ITEM'|'MYSTERY_PACK'|'VOUCHER'|'DECORATION', code?: string, name: string, quantity: number, iconUrl?: string, voucherId?: string }]
  sentAt      DateTime  @default(now())
  scheduledAt DateTime?
  status      String    @default("SENT") // SCHEDULED, SENT, REVOKED
  isRevoked   Boolean   @default(false)
  revokedAt   DateTime?
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userMails FarmUserMail[]

  @@index([type, sentAt])
  @@index([status, isRevoked])
}

model FarmUserMail {
  id        String    @id @default(uuid())
  mailId    String
  mail      FarmMail  @relation(fields: [mailId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation("UserFarmMails", fields: [userId], references: [id], onDelete: Cascade)
  isRead    Boolean   @default(false)
  isClaimed Boolean   @default(false)
  claimedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([mailId, userId])
  @@index([userId, isClaimed])
  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model FarmSocialActivity {
  id          String   @id @default(uuid())
  farmOwnerId String
  farmOwner   User     @relation("FarmOwnerActivities", fields: [farmOwnerId], references: [id], onDelete: Cascade)
  actorUserId String
  actorUser   User     @relation("ActorSocialActivities", fields: [actorUserId], references: [id], onDelete: Cascade)
  action      String // VISIT, WATER, STEAL, HELP, GIFT
  plotIndex   Int?
  cropId      String?
  cropCode    String?
  cropName    String?
  quantity    Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([farmOwnerId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model FarmExchangeSetting {
  id                     String   @id @default("default")
  coinPerPoint           Int      @default(5)
  minCoins               Int      @default(100)
  maxCoinsPerTransaction Int      @default(50000)
  dailyLimitCoins        Int      @default(100000)
  exchangeStep           Int      @default(1)
  isEnabled              Boolean  @default(true)
  updatedAt              DateTime @updatedAt
  createdAt              DateTime @default(now())
}

// ==========================================
// AVORA FARM - GLOBAL GARDEN LAYOUT SYSTEM
// ==========================================

enum FarmGardenLayoutStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FarmGardenObjectType {
  PLOT
  DECORATION
  TREE
  EFFECT
}

enum FarmGardenDisplayMode {
  ALWAYS
  DAY_ONLY
  NIGHT_ONLY
}

enum FarmGardenDeviceMode {
  ALL
  DESKTOP_ONLY
  MOBILE_ONLY
}

model FarmGardenLayout {
  id          String                    @id @default(uuid())
  code        String                    @unique
  name        String
  description String?                   @db.Text
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  versions    FarmGardenLayoutVersion[]
}

model FarmGardenLayoutVersion {
  id                String                 @id @default(uuid())
  layoutId          String
  version           Int
  status            FarmGardenLayoutStatus
  revision          Int                    @default(0)
  createdByUserId   String
  publishedByUserId String?
  publishedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  layout          FarmGardenLayout   @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  createdByUser   User               @relation("GardenLayoutCreatedBy", fields: [createdByUserId], references: [id])
  publishedByUser User?              @relation("GardenLayoutPublishedBy", fields: [publishedByUserId], references: [id])
  objects         FarmGardenObject[]

  @@unique([layoutId, version])
  @@index([layoutId, status])
  @@index([publishedAt])
}

model FarmGardenAsset {
  id               String             @id @default(uuid())
  code             String             @unique
  name             String
  category         String
  originalUrl      String?
  avifUrl          String?
  webpUrl          String?
  fallbackUrl      String
  originalFormat   String
  mimeType         String
  originalFileSize Int
  width            Int
  height           Int
  hasAlpha         Boolean            @default(true)
  defaultAnchorX   Float              @default(0.5)
  defaultAnchorY   Float              @default(1.0)
  defaultScale     Float              @default(1.0)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  objects          FarmGardenObject[]
}

model FarmGardenObject {
  id              String                @id @default(uuid())
  objectKey       String
  layoutVersionId String
  objectType      FarmGardenObjectType
  assetId         String?
  parentId        String?
  plotIndex       Int?
  name            String?
  positionX       Float
  positionY       Float
  width           Float
  height          Float
  scaleX          Float                 @default(1.0)
  scaleY          Float                 @default(1.0)
  rotation        Float                 @default(0.0)
  opacity         Float                 @default(1.0)
  zIndex          Int                   @default(0)
  anchorX         Float                 @default(0.5)
  anchorY         Float                 @default(1.0)
  flipX           Boolean               @default(false)
  flipY           Boolean               @default(false)
  isVisible       Boolean               @default(true)
  isLocked        Boolean               @default(false)
  displayMode     FarmGardenDisplayMode @default(ALWAYS)
  deviceMode      FarmGardenDeviceMode  @default(ALL)
  animationConfig Json?
  styleConfig     Json?
  startAt         DateTime?
  endAt           DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  layoutVersion FarmGardenLayoutVersion @relation(fields: [layoutVersionId], references: [id], onDelete: Cascade)
  asset         FarmGardenAsset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  parent        FarmGardenObject?       @relation("GardenObjectHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      FarmGardenObject[]      @relation("GardenObjectHierarchy")

  @@unique([layoutVersionId, objectKey])
  @@unique([layoutVersionId, plotIndex])
  @@index([layoutVersionId, objectType])
  @@index([parentId])
}

model FarmLevelConfig {
  id             String   @id @default(uuid())
  level          Int      @unique
  expRequired    Int      @default(100)
  coinCost       Int      @default(0)
  pointCost      Int      @default(0)
  requiredCrops  Json? // Mảng nông sản yêu cầu: [{ cropCode: string, quantity: number }]
  speedBoost     Float    @default(0)
  energyBonus    Int      @default(5)
  sellPriceBoost Float    @default(0)
  unlockTitle    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([level])
}

// ==========================================
// HỆ THỐNG ĐÁNH GIÁ & TRẢI NGHIỆM KHÁCH HÀNG (REVIEWS & RATINGS)
// ==========================================

enum ProductReviewStatus {
  ACTIVE
  HIDDEN
  DELETED
}

enum OrderReviewStatus {
  ACTIVE
  HIDDEN
  MODERATED
}

enum ReviewMediaType {
  IMAGE
  VIDEO
}

enum ReviewReactionType {
  LIKE
  DISLIKE
}

model ProductReview {
  id                  String              @id @default(uuid())
  userId              String
  productId           String
  rating              Int // 1 - 5 (Integer)
  content             String              @db.Text
  isVerifiedPurchase  Boolean             @default(false)
  verifiedOrderId     String?
  verifiedOrderItemId String?
  purchasedAt         DateTime?
  status              ProductReviewStatus @default(ACTIVE)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  product           Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  verifiedOrder     Order?           @relation("VerifiedOrderReviews", fields: [verifiedOrderId], references: [id], onDelete: SetNull)
  verifiedOrderItem OrderItem?       @relation("VerifiedOrderItemReviews", fields: [verifiedOrderItemId], references: [id], onDelete: SetNull)
  media             ReviewMedia[]
  reactions         ReviewReaction[]
  reply             ReviewReply?

  @@unique([userId, productId])
  @@index([productId, status])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
  @@index([verifiedOrderId])
}

model ReviewMedia {
  id              String          @id @default(uuid())
  productReviewId String?
  orderReviewId   String?
  followUpId      String?
  mediaType       ReviewMediaType @default(IMAGE)
  url             String          @db.Text
  thumbnailUrl    String?         @db.Text
  mimeType        String
  sizeBytes       Int
  width           Int?
  height          Int?
  durationSeconds Float?
  displayOrder    Int             @default(0)
  createdAt       DateTime        @default(now())

  productReview ProductReview?       @relation(fields: [productReviewId], references: [id], onDelete: Cascade)
  orderReview   OrderReview?         @relation(fields: [orderReviewId], references: [id], onDelete: Cascade)
  followUp      OrderReviewFollowUp? @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  @@index([productReviewId])
  @@index([orderReviewId])
  @@index([followUpId])
}

model ReviewReaction {
  id        String             @id @default(uuid())
  reviewId  String
  userId    String
  type      ReviewReactionType
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId, type])
  @@index([userId])
}

model ReviewReply {
  id              String   @id @default(uuid())
  productReviewId String?  @unique
  orderReviewId   String?  @unique
  adminId         String
  content         String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  productReview ProductReview? @relation(fields: [productReviewId], references: [id], onDelete: Cascade)
  orderReview   OrderReview?   @relation(fields: [orderReviewId], references: [id], onDelete: Cascade)
  admin         User           @relation("AdminReviewReplies", fields: [adminId], references: [id])

  @@index([adminId])
}

model OrderReview {
  id                   String            @id @default(uuid())
  orderId              String
  userId               String
  overallRating        Int // 1 - 5 (Integer)
  foodRating           Int?
  serviceRating        Int?
  deliveryRating       Int?
  content              String            @db.Text
  rewardPointsSnapshot Int               @default(999)
  rewardGranted        Boolean           @default(false)
  rewardGrantedAt      DateTime?
  pointTransactionId   String?           @unique
  reviewExpiresAt      DateTime
  status               OrderReviewStatus @default(ACTIVE)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  order            Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  pointTransaction PointTransaction?     @relation(fields: [pointTransactionId], references: [id], onDelete: SetNull)
  media            ReviewMedia[]
  followUps        OrderReviewFollowUp[]
  reply            ReviewReply?

  @@unique([orderId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model OrderReviewFollowUp {
  id            String   @id @default(uuid())
  orderReviewId String
  userId        String
  content       String   @db.Text
  createdAt     DateTime @default(now())

  orderReview OrderReview   @relation(fields: [orderReviewId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  media       ReviewMedia[]

  @@index([orderReviewId, createdAt])
  @@index([userId])
}
