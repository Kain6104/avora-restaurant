generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  phone        String?      @unique
  passwordHash String?
  fullName     String
  username     String?      @unique
  avatarUrl    String?
  birthdate    DateTime?    @db.Date
  role         RoleType     @default(USER)
  authProvider AuthProvider @default(LOCAL)
  googleId     String?      @unique

  // Thông tin thành viên & Điểm thưởng
  points           Int     @default(0)
  currentPoints    Float   @default(0)
  totalSpending    Float   @default(0)
  membershipTierId String?

  // Xác thực & Bảo mật
  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  isAccountLocked Boolean @default(false)
  forceRelogin    Boolean @default(false)
  secureToken     String  @unique @default(uuid())
  deviceToken     String? @db.VarChar(500)
  zaloId          String? @unique

  // OTP Đăng ký & Xác thực tài khoản
  verificationOtp           String?
  verificationOtpExpires    DateTime?
  verificationOtpAttempts   Int       @default(0)
  verificationOtpLastSentAt DateTime?

  // OTP Quên mật khẩu
  resetPasswordOtp          String?
  resetPasswordExpires      DateTime?
  resetPasswordOtpAttempts  Int       @default(0)
  resetPasswordLastSentAt   DateTime?
  resetPasswordRequestCount Int       @default(0)
  resetPasswordRequestDate  DateTime? @db.Date

  // OTP Đổi Email từ Admin
  pendingNewEmail          String?
  changeEmailOtp           String?
  changeEmailOtpExpires    DateTime?
  changeEmailOtpAttempts   Int       @default(0)
  changeEmailOtpLastSentAt DateTime?

  // Thông tin xuất hóa đơn VAT
  taxCode      String?
  companyName  String?
  taxAddress   String?
  invoiceEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Mã thành viên dùng để quét QR/Barcode tại quầy
  memberCode String? @unique @db.VarChar(50)

  // Quan hệ
  orders            Order[]
  cashierShifts     CashShift[]        @relation("CashierShifts")
  openedShifts      CashShift[]        @relation("ShiftOpenedBy")
  closedShifts      CashShift[]        @relation("ShiftClosedBy")
  reservations      Reservation[]
  favoriteItems     Product[]          @relation("UserFavoriteItems")
  addresses         Address[]
  notifications     Notification[]
  membershipTier    MembershipTier?    @relation(fields: [membershipTierId], references: [id])
  pointTransactions PointTransaction[]
  chatSessions      ChatSession[]
  auditLogs         AuditLog[]

  // Bài viết / Tin tức
  articles         Article[]                     @relation("ArticleAuthor")
  articleReactions ArticleReaction[]
  articleComments  ArticleComment[]
  savedArticles    ArticleFavorite[]
  createdCampaigns ArticleNotificationCampaign[]

  // Chi nhánh hay ghé/mặc định
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // Phân quyền động RBAC
  roleAssignments UserRoleAssignment[]

  // Flash Sale Reminders
  flashSaleReminders FlashSaleReminder[]

  // Ví voucher khách hàng đã lưu
  savedVouchers CustomerVoucher[]
  qrOrderGuests QrOrderGuest[]
  desktopLaunchCodes DesktopLaunchCode[]
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  recipientName String?
  phone         String?
  province      String
  ward          String
  streetDetail  String
  isDefault     Boolean  @default(false)
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Address_userId_fkey")
}

model Branch {
  id                    String          @id @default(uuid())
  name                  String
  branchCode            String          @unique
  phone                 String?
  email                 String?
  province              String?
  district              String?
  ward                  String?
  street                String?
  latitude              Float?
  longitude             Float?
  openTime              String?
  closeTime             String?
  onlineOrderingEnabled Boolean         @default(true)
  servingType           ServingType     @default(DINE_IN)
  // Cấu hình In ấn & Phiếu bếp (Branch Print Settings)
  splitKitchenTickets   Boolean         @default(false)
  printCancelTicket     Boolean         @default(false)
  autoPrintReceipt      Boolean         @default(true)
  autoPrintTempBill     Boolean         @default(false)
  excludeBuffetItemsFromTempBill Boolean @default(false)
  removeBuffetItemsOnCheckout    Boolean @default(false)
  receiptCopies         Int             @default(1)
  kitchenCopies         Int             @default(1)
  defaultPaperSize      String?         @default("80mm")
  defaultReceiptPrinterId String?
  allowedRadiusMeters   Int             @default(50)
  qrSecretKey           String?
  qrAutoSendToKitchen   Boolean         @default(false)
  // Cấu hình Đặt bàn (Reservation)
  capacity                       Int                   @default(80)
  reservationSlotMinutes         Int                   @default(30)
  reservationDurationMinutes     Int                   @default(90)
  reservationBufferMinutes       Int                   @default(15)
  minPartySize                   Int                   @default(1)
  maxPartySize                   Int                   @default(30)
  advanceBookingDays             Int                   @default(30)
  minAdvanceMinutes              Int                   @default(60)
  reservationEnabled             Boolean               @default(true)
  reservationModifyCutoffMinutes Int                   @default(60)
  noShowGraceMinutes             Int                   @default(30)
  reservationMode                String                @default("AUTO") // AUTO, TABLE, CAPACITY

  // Cấu hình Tích điểm & Quy đổi ưu đãi theo chi nhánh (Loyalty Program)
  isLoyaltyOnlineEnabled         Boolean               @default(true) // Bật/tắt tích điểm đơn Online
  loyaltyEarnRateOnline          Float                 @default(40)   // Tỷ lệ tích điểm Online: 40đ = 1 điểm
  isLoyaltyPosEnabled            Boolean               @default(true) // Bật/tắt tích điểm đơn POS/tại quán
  loyaltyEarnRatePos             Float                 @default(40)   // Tỷ lệ tích điểm POS: 40đ = 1 điểm
  allowDirectDiscount            Boolean               @default(true) // Bật/tắt quy đổi điểm thành giảm giá trực tiếp
  pointRedeemRate                Float                 @default(1)    // 1 điểm = X đ (mặc định 1đ)
  allowRedeemVoucherOnline       Boolean               @default(true) // Bật/tắt quy đổi điểm thành voucher (đặt Online)
  allowRedeemItemPos             Boolean               @default(true) // Bật/tắt quy đổi điểm sang món (tại cửa hàng POS)

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  orders                Order[]
  reservations          Reservation[]
  users                 User[]
  banners               Banner[]        @relation("BannerToBranch")
  categories            Category[]      @relation("CategoryToBranch")
  products              Product[]       @relation("ProductToBranch")
  redeemableProducts    Product[]       @relation("ProductRedeemableBranches")
  vouchers              Voucher[]       @relation("VoucherToBranch")
  flashSales            FlashSale[]     @relation("FlashSaleToBranch")
  combos                Combo[]         @relation("ComboToBranch")
  operatingSlots        OperatingSlot[]
  paymentMethods        PaymentMethod[] @relation("PaymentMethodToBranch")
  articles              Article[]       @relation("ArticleToBranch")
  restaurantAreas       RestaurantArea[]
  restaurantTables      RestaurantTable[]
  specialHours          BranchSpecialHours[]
  reservationBlocks     ReservationBlock[]
  slotLocks             ReservationSlotLock[]
  waitlists             ReservationWaitlist[]
  tableSessions         TableSession[]
  cashShifts            CashShift[]
  printTemplates        PrintTemplate[]
  kitchenStations       KitchenStation[]
  printers              Printer[]
  printAgents           PrintAgent[]
  productRoutes         ProductPrintRoute[]
  printJobs             PrintJob[]
  kitchenEvents         KitchenEvent[]
  branchPrinterSettings BranchPrinterSetting[]
  buffetPackages        BuffetPackage[]
  qrOrderSessions       QrOrderSession[]
  tableServiceRequests  TableServiceRequest[]
  orderSequences        OrderSequence[]
  assignedUserRoles     UserRoleBranch[]
}

model Banner {
  id              String              @id @default(uuid())
  title           String?
  description     String?             @db.Text
  imageUrl        String
  mobileImageUrl  String?
  altText         String?
  linkUrl         String?
  active          Boolean             @default(true)
  bannerOrder     Int                 @default(0)
  popup           Boolean             @default(false)
  position        String              @default("HERO") // HERO, POPUP, PROMO
  targetAudience  String              @default("ALL")  // ALL, MEMBERS_ONLY, VIP_ONLY
  popupFrequency  String              @default("ONCE_PER_SESSION") // ONCE_PER_SESSION, EVERY_PAGE_LOAD
  startDate       DateTime?
  endDate         DateTime?
  viewCount       Int                 @default(0)
  clickCount      Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  branches        Branch[]            @relation("BannerToBranch")
  interactions    BannerInteraction[]
}

model BannerInteraction {
  id        String   @id @default(uuid())
  bannerId  String
  banner    Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  type      String   // "VIEW" or "CLICK"
  userId    String?  // Id của người dùng thành viên nếu đã đăng nhập
  sessionId String?  // Mã phiên duyệt web để chống spam lặp lại
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([bannerId, type])
  @@index([bannerId, userId])
  @@index([createdAt])
}

model Category {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  image        String?
  description  String?   @db.Text
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
  branches     Branch[]  @relation("CategoryToBranch")
}

model Product {
  id                   String           @id @default(uuid())
  itemCode             String           @unique
  name                 String
  slug                 String           @unique
  description          String?          @db.Text
  post                 String?          @db.Text
  price                Float
  oldPrice             Float?
  discountedPrice      Float?
  flashSalePrice       Float?
  unit                 String?          @default("phần")
  taxPercentage        Float            @default(0)
  badge                String?
  imageUrl             String?
  videoUrl             String?          @db.Text
  available            Boolean          @default(true)
  isBestSeller         Boolean          @default(false)
  isAiRecommended      Boolean          @default(false)
  avgRating            Float            @default(0)
  soldQuantity         Int              @default(0)
  isRedeemable         Boolean          @default(false)
  redemptionPoints     Int?
  categoryId           String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  spiciness            Int              @default(0)
  targetAudience       String?          @default("Mọi lứa tuổi")
  FlashSaleItem        FlashSaleItem[]
  optionGroups         OptionGroup[]
  orderItems           OrderItem[]
  category             Category         @relation(fields: [categoryId], references: [id])
  branches             Branch[]         @relation("ProductToBranch")
  salesChannels        Json?
  secondaryImages      Json?
  redeemAllBranches    Boolean          @default(true)
  redeemableBranches   Branch[]         @relation("ProductRedeemableBranches")
  favoritedBy          User[]           @relation("UserFavoriteItems")
  ComboItem            ComboItem[]
  articleProducts      ArticleProduct[]
  printRoutes          ProductPrintRoute[]
  buffetPackageTickets BuffetPackageTicket[]
  buffetPackageItems   BuffetPackageItem[]

  @@index([categoryId], map: "Product_categoryId_fkey")
}

model OptionGroup {
  id             String       @id @default(uuid())
  productId      String
  name           String
  isRequired     Boolean      @default(false)
  multipleChoice Boolean      @default(false)
  minSelect      Int          @default(0)
  maxSelect      Int          @default(1)
  displayOrder   Int          @default(0)
  createdAt      DateTime     @default(now())
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionItems    OptionItem[]

  @@index([productId], map: "OptionGroup_productId_fkey")
}

model OptionItem {
  id               String            @id @default(uuid())
  optionGroupId    String
  name             String
  priceAdjustment  Float             @default(0)
  isDefault        Boolean           @default(false)
  available        Boolean           @default(true)
  displayOrder     Int               @default(0)
  maxQuantity      Int               @default(1)
  optionGroup      OptionGroup       @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  orderItemOptions OrderItemOption[]

  @@index([optionGroupId], map: "OptionItem_optionGroupId_fkey")
}

model Reservation {
  id              String            @id @default(uuid())
  reservationCode String?           @unique
  userId          String?
  branchId        String
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  startAt         DateTime?
  endAt           DateTime?
  // Legacy fields (giữ tương thích)
  reservationDate DateTime          @db.Date
  reservationTime String
  partySize       Int
  tablePreference String?
  occasion        String?
  seatingPreference String?
  specialRequests String?           @db.Text
  internalNote    String?           @db.Text
  source          ReservationSource @default(WEB)
  status          ReservationStatus @default(PENDING)
  checkInToken    String?           @unique

  // Trạng thái vận hành & Timeline
  checkedInAt     DateTime?
  seatedAt        DateTime?
  completedAt     DateTime?
  canceledAt      DateTime?
  cancelReason    String?           @db.Text
  canceledBy      String?
  noShowAt        DateTime?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  branch          Branch            @relation(fields: [branchId], references: [id])
  user            User?             @relation(fields: [userId], references: [id])
  tables          ReservationTable[]
  reminderLogs    ReservationReminderLog[]

  @@index([branchId], map: "Reservation_branchId_fkey")
  @@index([userId], map: "Reservation_userId_fkey")
  @@index([branchId, startAt, endAt])
  @@index([branchId, status, startAt])
  @@index([userId, startAt])
  @@index([customerPhone])
}

model Order {
  id                          String             @id @default(uuid())
  orderCode                   String?            @unique
  temporaryOrderCode          String?            @unique
  userId                      String?
  branchId                    String
  customerName                String
  customerPhone               String
  deliveryAddress             String?            @db.Text
  latitude                    Float?
  longitude                   Float?
  note                        String?            @db.Text
  subTotal                    Float
  shippingFee                 Float              @default(0)
  discountAmount              Float              @default(0)
  discountReason              String?            @db.Text
  discountPercent             Float?
  discountType                String?
  shippingDiscount            Float              @default(0)
  shippingDiscountReason      String?            @db.Text
  serviceChargeTotal          Float              @default(0)
  taxAmount                   Float              @default(0)
  vatPriceModeSnapshot        String?
  totalAmount                 Float
  voucherId                   String?
  shippingVoucherId           String?
  discountVoucherCodeSnapshot String?
  shippingVoucherCodeSnapshot String?
  isVoucherRefunded           Boolean            @default(false)
  paymentMethod               String             @default("COD")
  paymentStatus               String             @default("PENDING")
  transactionId               String?
  pointsUsed                  Int                @default(0)
  pointsAwarded               Int                @default(0)
  status                      OrderStatus        @default(PENDING)
  cancelReason                String?            @db.Text
  canceledBy                  String?
  isInvoiceRequested          Boolean            @default(false)
  invoiceCompanyName          String?
  isViewedByAdmin             Boolean            @default(false)
  invoiceTaxCode              String?
  invoiceAddress              String?            @db.Text
  invoiceEmail                String?
  isInvoiceExported           Boolean            @default(false)
  invoiceExportedAt           DateTime?
  invoiceExportedBy           String?
  confirmedAt                 DateTime?
  deliveringAt                DateTime?
  deliveredAt                 DateTime?
  canceledAt                  DateTime?
  operatingSlotId             String?
  deliveryDate                DateTime?          @db.Date
  deliverySlotSnapshot        String?
  orderType                   SlotOrderType      @default(DELIVERY)

  // Snapshots khoảng cách & Routing thực tế
  deliveryDistanceMeters      Int?
  deliveryDurationSeconds     Int?
  shippingProvider            String?
  shippingCalculatedAt        DateTime?
  shippingOriginLatitude      Float?
  shippingOriginLongitude     Float?
  shippingDestinationLatitude Float?
  shippingDestinationLongitude Float?

  // POS Enterprise Engine Fields
  orderSource                 OrderSource        @default(WEB)
  tableId                     String?
  tableSessionId              String?            @unique
  guestCount                  Int                @default(1)
  cashierId                   String?
  cashierName                 String?
  version                     Int                @default(1)
  kitchenStatus               KitchenStatus      @default(PENDING)
  sentToKitchenAt             DateTime?
  kitchenReadyAt              DateTime?
  servedAt                    DateTime?

  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  branch                      Branch             @relation(fields: [branchId], references: [id])
  user                        User?              @relation(fields: [userId], references: [id])
  voucher                     Voucher?           @relation("OrderDiscountVoucher", fields: [voucherId], references: [id])
  shippingVoucher             Voucher?           @relation("OrderShippingVoucher", fields: [shippingVoucherId], references: [id])
  operatingSlot               OperatingSlot?     @relation(fields: [operatingSlotId], references: [id])
  table                       RestaurantTable?   @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableSession                TableSession?      @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  orderItems                  OrderItem[]
  PointTransaction            PointTransaction[]
  parentRelations             OrderRelation[]    @relation("ParentOrderRelations")
  childRelations              OrderRelation[]    @relation("ChildOrderRelations")
  payments                    OrderPayment[]
  printJobs                   PrintJob[]
  kitchenEvents               KitchenEvent[]
  serviceCharges              OrderServiceCharge[]
  buffetSessions              BuffetSession[]
  qrOrderSessions             QrOrderSession[]
  tableServiceRequests        TableServiceRequest[]

  @@index([branchId], map: "Order_branchId_fkey")
  @@index([userId], map: "Order_userId_fkey")
  @@index([voucherId], map: "Order_voucherId_fkey")
  @@index([shippingVoucherId], map: "Order_shippingVoucherId_fkey")
  @@index([operatingSlotId], map: "Order_operatingSlotId_fkey")
  @@index([tableId])
  @@index([cashierId])
  @@index([orderSource])
  @@index([status])
  @@index([kitchenStatus])
  @@index([temporaryOrderCode])
  @@index([createdAt])
  @@index([branchId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                  String            @id @default(uuid())
  orderId             String
  productId           String
  quantity            Int
  priceAtSale         Float
  originalPriceAtSale Float
  discountAmount      Float             @default(0)
  discountReason      String?           @db.Text
  note                String?           @db.Text
  optionsTextSnapshot String?           @db.Text
  isFlashSaleItem     Boolean           @default(false)
  flashSaleId         String?
  flashSaleSlotId     String?
  flashSaleNameSnapshot String?
  flashSalePriceSnapshot Float?

  // Tax Snapshot Fields
  taxPercentageAtSale Float             @default(0)
  taxableAmountAtSale Float             @default(0)
  taxAmountAtSale     Float             @default(0)
  vatPriceModeSnapshot String?
  isVatInclusive      Boolean           @default(true)

  // POS & KDS Fields
  kitchenStatus       KitchenStatus     @default(PENDING)
  stationId           String?
  sentToKitchenAt     DateTime?
  acknowledgedAt      DateTime?
  readyAt             DateTime?
  servedAt            DateTime?
  isKitchenPrinted    Boolean           @default(false)
  sentQuantity        Int               @default(0)
  printedQuantity     Int               @default(0)
  printVersion        Int               @default(0)
  orderedById         String?
  orderedByName       String?

  // Buffet & Source Engine Fields
  pricingMode                  OrderItemPricingMode @default(REGULAR)
  buffetSessionId              String?
  buffetPackageId              String?
  buffetPackageNameSnapshot    String?
  buffetReferencePriceSnapshot Float?
  source                       OrderItemSource      @default(POS)
  qrOrderRoundId               String?
  excludedFromFinalReceipt     Boolean              @default(false)

  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product           @relation(fields: [productId], references: [id])
  selectedOptions     OrderItemOption[]
  printJobs           PrintJob[]
  buffetSession       BuffetSession?    @relation(fields: [buffetSessionId], references: [id], onDelete: SetNull)
  qrOrderRound        QrOrderRound?     @relation(fields: [qrOrderRoundId], references: [id], onDelete: SetNull)

  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([productId], map: "OrderItem_productId_fkey")
  @@index([productId, orderId])
  @@index([kitchenStatus])
  @@index([stationId])
  @@index([pricingMode])
  @@index([buffetSessionId])
  @@index([source])
  @@index([qrOrderRoundId])
}

model OrderItemOption {
  id                    String     @id @default(uuid())
  orderItemId           String
  optionItemId          String
  nameAtSale            String
  priceAdjustmentAtSale Float
  quantity              Int        @default(1)
  optionItem            OptionItem @relation(fields: [optionItemId], references: [id])
  orderItem             OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([optionItemId], map: "OrderItemOption_optionItemId_fkey")
  @@index([orderItemId], map: "OrderItemOption_orderItemId_fkey")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  title       String
  content     String           @db.Text
  type        NotificationType @default(SYSTEM)
  isRead      Boolean          @default(false)
  readAt      DateTime?
  referenceId String?
  url         String?
  imageUrl    String?
  branchId    String?
  eventId     String?          @db.VarChar(191)
  eventType   String?          @db.VarChar(100)
  category    String?          @db.VarChar(50)
  priority    Int              @default(1)
  actorId     String?
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Notification_userId_fkey")
  @@index([userId, isRead])
  @@index([branchId])
  @@index([eventType])
  @@unique([eventId, userId])
}

model Voucher {
  id               String       @id @default(uuid())
  code             String       @unique
  title            String
  description      String?      @db.Text
  discountType     DiscountType @default(FIXED_AMOUNT) // PERCENTAGE, FIXED_AMOUNT, FREE_SHIP
  discountValue    Float // Phần trăm hoặc số tiền
  maxDiscount      Float? // Giảm tối đa (cho loại %)
  minOrderValue    Float        @default(0) // Đơn tối thiểu
  isFirstOrderOnly Boolean      @default(false)

  usageLimit        Int? // Tổng số lượt dùng của toàn hệ thống
  usageLimitPerUser Int?    @default(1) // Số lần tối đa 1 user được dùng
  usedCount         Int     @default(0)
  isPublic          Boolean @default(true) // Hiển thị công khai hay mã ẩn phải tự nhập
  membershipTierId  String?

  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  imageUrl  String?
  applicableScope String @default("ALL") // ALL, POS, ONLINE
  applicableProductsScope String @default("ALL") // ALL, CATEGORY, SPECIFIC_PRODUCTS, BEST_SELLER, SLOW_SELLER
  applicableProductIds    String? @db.Text
  applicableCategoryIds   String? @db.Text
  targetCustomerScope     String @default("ALL") // ALL, NEW_CUSTOMER, SPECIFIC_CUSTOMERS, MEMBERSHIP_TIER
  targetCustomerIds       String? @db.Text

  orders          Order[]          @relation("OrderDiscountVoucher")
  shippingOrders  Order[]          @relation("OrderShippingVoucher")
  membershipTiers MembershipTier[] @relation("VoucherToMembershipTier")
  branches        Branch[]         @relation("VoucherToBranch")
  articleVouchers ArticleVoucher[]
  appliesToAllPaymentMethods Boolean                @default(true)
  voucherPaymentMethods      VoucherPaymentMethod[]
  customerVouchers           CustomerVoucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerVoucher {
  id        String    @id @default(uuid())
  userId    String
  voucherId String
  savedAt   DateTime  @default(now())
  isUsed    Boolean   @default(false)
  usedAt    DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucher   Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([userId, voucherId])
