model CustomRecipeItem {
  id              String              @id @default(uuid())
  recipeId        String
  recipe          CustomUserRecipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      ArchitectIngredient @relation(fields: [ingredientId], references: [id])
  gram            Float
  calculatedPrice Float

  createdAt DateTime @default(now())

  @@index([recipeId])
  @@index([ingredientId])
}

// =========================================================================
// AUTO-PANTRY™ SUBSCRIPTION SCHEMAS
// =========================================================================

enum SubscriptionPlanType {
  WEEKLY_5_DAYS // T2 - T6
  WEEKLY_7_DAYS // Cả tuần
  MONTHLY_20_DAYS // 20 ngày làm việc
  MONTHLY_30_DAYS // Trọn tháng
  CUSTOM_SCHEDULE // Lịch tự chọn ngày
}

enum SubscriptionMealSlot {
  LUNCH // Giao 11:15 - 11:45
  DINNER // Giao 18:00 - 18:30
  FULL_DAY // Cả trưa và tối
}

enum SubscriptionStatus {
  PENDING_PAYMENT // Chờ thanh toán kích hoạt
  ACTIVE // Đang hoạt động
  PAUSED // Tạm dừng
  EXPIRED // Hết hạn chu kỳ
  CANCELLED // Đã hủy
}

enum DeliveryScheduleStatus {
  SCHEDULED // Đã lên lịch
  PAUSED_SKIPPED // Khách tạm hoãn ngày này
  PREPARING // Đang nấu tại bếp
  DELIVERING // Đang giao hàng
  DELIVERED // Giao thành công
  CANCELLED // Hủy bỏ
}

model MealSubscriptionPlan {
  id            String               @id @default(uuid())
  code          String               @unique
  name          String
  description   String               @db.Text
  planType      SubscriptionPlanType
  mealSlot      SubscriptionMealSlot
  totalMeals    Int
  basePrice     Float
  discountPrice Float
  isActive      Boolean              @default(true)

  subscriptions UserMealSubscription[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

model UserMealSubscription {
  id               String               @id @default(uuid())
  subscriptionCode String               @unique
  userId           String
  user             User                 @relation("UserMealSubscriptions", fields: [userId], references: [id], onDelete: Restrict)
  planId           String
  plan             MealSubscriptionPlan @relation(fields: [planId], references: [id])

  status   SubscriptionStatus   @default(PENDING_PAYMENT)
  mealSlot SubscriptionMealSlot
  branchId String               @default("AVO-Q1")

  recipientName     String
  recipientPhone    String
  deliveryAddress   String  @db.Text
  deliveryLatitude  Float?
  deliveryLongitude Float?
  deliveryTimeSlot  String  @default("11:30")
  deliveryNote      String? @db.Text

  isAutoSurprise            Boolean @default(true)
  dietaryPreferencesJson    String? @db.Text
  dislikedIngredientIdsJson String? @db.Text

  startDate      DateTime
  endDate        DateTime
  remainingMeals Int
  usedMeals      Int      @default(0)

  autoRenew          Boolean @default(true)
  sePayCustomerToken String?

  schedules SubscriptionDeliverySchedule[]
  createdAt DateTime                       @default(now())
  updatedAt DateTime                       @updatedAt

  @@index([userId, status])
  @@index([status, startDate, endDate])
}

model SubscriptionDeliverySchedule {
  id             String               @id @default(uuid())
  subscriptionId String
  subscription   UserMealSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  deliveryDate DateTime               @db.Date
  deliverySlot String                 @default("11:30")
  status       DeliveryScheduleStatus @default(SCHEDULED)

  productId      String?
  product        Product?          @relation("ScheduleProduct", fields: [productId], references: [id], onDelete: SetNull)
  customRecipeId String?
  customRecipe   CustomUserRecipe? @relation(fields: [customRecipeId], references: [id], onDelete: SetNull)

  generatedOrderId String? @unique
  order            Order?  @relation("ScheduleOrder", fields: [generatedOrderId], references: [id], onDelete: SetNull)

  pauseReason     String?   @db.Text
  rescheduledDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, deliveryDate])
  @@index([deliveryDate, status])
}

model Cart {
  id             String    @id @default(uuid())
  userId         String?   @unique
  guestTokenHash String?   @unique
  branchId       String?
  cartVersion    Int       @default(1)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items  CartItem[]

  @@index([userId])
  @@index([guestTokenHash])
  @@index([branchId])
}

model CartItem {
  id                  String   @id @default(uuid())
  cartId              String
  productId           String
  quantity            Int      @default(1)
  priceAtSale         Float
  originalPriceAtSale Float
  optionsTextSnapshot String?  @db.Text
  selectedOptionsJson Json?
  isFlashSaleItem     Boolean  @default(false)
  flashSaleId         String?
  isCombo             Boolean  @default(false)
  comboId             String?
  note                String?  @db.Text
  isCustomRecipe      Boolean  @default(false)
  customRecipeData    Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
}

// ==========================================
// AVORA BANK CONNECT (VIETCOMBANK GATEWAY)
// ==========================================

model BankConnectedDevice {
  id                             String    @id @default(uuid())
  deviceId                       String    @unique
  deviceName                     String
  appVersion                     String    @default("1.0.0")
  publicKeyPem                   String    @db.Text
  status                         String    @default("ACTIVE") // ACTIVE, REVOKED, SUSPENDED
  batteryLevel                   Int?
  isCharging                     Boolean?
  networkType                    String?
  isNotificationAccessGranted    Boolean?
  isPowerSaveMode                Boolean?
  isIgnoringBatteryOptimizations Boolean?
  lastHeartbeatAt                DateTime?
  lastIp                         String?
  pairedAt                       DateTime  @default(now())
  pairedByUserId                 String?
  revokedAt                      DateTime?
  revokedByUserId                String?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  transactions BankTransaction[]
  logs         BankConnectionLog[]

  @@index([status])
}

model BankPairingCode {
  id              String   @id @default(uuid())
  code            String   @unique
  expiresAt       DateTime
  isUsed          Boolean  @default(false)
  usedByDeviceId  String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([code, isUsed])
}

model BankTransaction {
  id                  String    @id @default(uuid())
  eventId             String    @unique
  deviceId            String
  bank                String    @default("VIETCOMBANK")
  accountNumberMasked String
  accountNumber       String?
  direction           String // CREDIT, DEBIT
  amount              BigInt // in VND
  balanceAfter        BigInt? // in VND
  currency            String    @default("VND")
  occurredAt          DateTime
  receivedAt          DateTime  @default(now())
  counterparty        String?
  transferContent     String?   @db.Text
  bankReference       String?
  fingerprint         String    @unique
  rawText             String?   @db.Text
  parserVersion       String    @default("1.0.0")
  matchingStatus      String    @default("UNMATCHED") // MATCHED, UNMATCHED, REVIEW_REQUIRED, DUPLICATE, IGNORED
  orderId             String?
  matchedAt           DateTime?
  isArchived          Boolean   @default(false)
  archivedAt          DateTime?
  archivedByUserId    String?
  archiveReason       String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  device         BankConnectedDevice         @relation(fields: [deviceId], references: [deviceId])
  order          Order?                      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderMatches   BankTransactionOrderMatch[]
  overpaidRefund OverpaidRefund?

  @@index([deviceId])
  @@index([bankReference])
  @@index([matchingStatus])
  @@index([isArchived])
  @@index([occurredAt])
  @@index([createdAt])
  @@index([orderId])
}

model BankTransactionOrderMatch {
  id            String   @id @default(uuid())
  transactionId String
  orderId       String
  matchedAmount BigInt
  matchedBy     String   @default("AUTO") // AUTO or USER_ID
  matchedAt     DateTime @default(now())
  notes         String?  @db.Text
  createdAt     DateTime @default(now())

  transaction BankTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([orderId])
}

model BankConnectionLog {
  id        String   @id @default(uuid())
  deviceId  String?
  action    String // PAIR, HEARTBEAT, EVENT_RECEIVED, REVOKE, ERROR
  ip        String?
  userAgent String?
  details   String?  @db.Text
  createdAt DateTime @default(now())

  device BankConnectedDevice? @relation(fields: [deviceId], references: [deviceId], onDelete: SetNull)

  @@index([deviceId])
  @@index([action])
  @@index([createdAt])
}

model OverpaidRefund {
  id                  String    @id @default(uuid())
  transactionId       String    @unique
  orderId             String
  overpaidAmount      BigInt    // in VND
  status              String    @default("REFUND_PENDING") // REFUND_PENDING, REFUND_PROCESSING, REFUNDED, REFUND_FAILED
  refundBankReference String?
  refundedAmount      BigInt?
  refundedAt          DateTime?
  refundedByUserId    String?
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  transaction BankTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model BankScanJob {
  id                       String    @id @default(uuid())
  scanJobId                String    @unique
  branchId                 String?
  orderId                  String?
  requestedByUserId        String?
  status                   String    @default("SCAN_REQUESTED") // SCAN_REQUESTED, DEVICE_RECEIVED, SCANNING, SCAN_COMPLETED, TRANSACTION_FOUND, TRANSACTION_SYNCED, NO_MATCHING_NOTIFICATION, DEVICE_OFFLINE, SCAN_TIMEOUT
  activeNotificationsCount Int?      @default(0)
  newTransactionsCount     Int?      @default(0)
  resultMessage            String?   @db.Text
  createdAt                DateTime  @default(now())
  completedAt              DateTime?

  @@index([scanJobId])
  @@index([branchId])
  @@index([createdAt])
}


// =========================================================================
// PHASE 3: ENTERPRISE INVENTORY, RECIPE COSTING & SUPPLY CHAIN INTELLIGENCE
// =========================================================================

enum InventoryTransactionType {
  OPENING_BALANCE
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  STOCK_TRANSFER_OUT
  STOCK_TRANSFER_IN
  ORDER_RESERVATION
  ORDER_RESERVATION_RELEASE
  RECIPE_CONSUMPTION
  STOCK_ADJUSTMENT
  STOCK_COUNT_GAIN
  STOCK_COUNT_LOSS
  WASTE
  SPOILAGE
  PREPARATION_LOSS
  SUPPLIER_RETURN
}

enum RecipeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CONVERTED_TO_PO
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  SENT_TO_SUPPLIER
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  REJECTED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum StockTransferStatus {
  DRAFT
  REQUESTED
  APPROVED
  DISPATCHED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  REJECTED
  CANCELLED
}

enum StocktakeStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum InventoryWasteReason {
  EXPIRED
  DAMAGED
  PREPARATION_WASTE
  KITCHEN_SPOILAGE
  CUSTOMER_RETURN
  STAFF_MEAL
  COMPLIMENTARY
  TRAINING
  INVENTORY_ADJUSTMENT
  OTHER
}

enum StorageCondition {
  AMBIENT
  CHILLED
  FROZEN
  DRY
  COOL_DARK
}

model IngredientCategory {
  id           String       @id @default(uuid())
  code         String       @unique
  name         String
  description  String?      @db.Text
  color        String?      @default("#da251d")
  displayOrder Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  ingredients  Ingredient[]

  @@index([isActive])
}

model IngredientUnit {
  id          String   @id @default(uuid())
  name        String
  symbol      String   @unique
  description String?  @db.Text
  isBaseUnit  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  primaryIngredients  Ingredient[]               @relation("IngredientPrimaryUnit")
  purchaseIngredients Ingredient[]               @relation("IngredientPurchaseUnit")
  storageIngredients  Ingredient[]               @relation("IngredientStorageUnit")
  conversionsFrom     IngredientUnitConversion[] @relation("UnitConversionsFrom")
  conversionsTo       IngredientUnitConversion[] @relation("UnitConversionsTo")
}

model Ingredient {
  id                      String           @id @default(uuid())
  code                    String           @unique
  name                    String
  description             String?          @db.Text
  imageUrl                String?
  categoryId              String
  category                IngredientCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Units
  primaryUnitId           String
  primaryUnit             IngredientUnit   @relation("IngredientPrimaryUnit", fields: [primaryUnitId], references: [id], onDelete: Restrict)
  purchaseUnitId          String?
  purchaseUnit            IngredientUnit?  @relation("IngredientPurchaseUnit", fields: [purchaseUnitId], references: [id], onDelete: SetNull)
  storageUnitId           String?
  storageUnit             IngredientUnit?  @relation("IngredientStorageUnit", fields: [storageUnitId], references: [id], onDelete: SetNull)

  // Explicit Conversion Multipliers to Primary Unit (e.g., 1 purchaseUnit = factor * primaryUnit)
  purchaseToPrimaryFactor Float            @default(1.0)
  storageToPrimaryFactor  Float            @default(1.0)

  // Inventory Thresholds (stored in primary unit)
  minimumStock            Decimal          @default(0) @db.Decimal(14, 4)
  maximumStock            Decimal          @default(0) @db.Decimal(14, 4)
  reorderThreshold        Decimal          @default(0) @db.Decimal(14, 4)

  // Costing & Valuation (in VND)
  averagePurchaseCost     Decimal          @default(0) @db.Decimal(14, 2)
  latestPurchaseCost      Decimal          @default(0) @db.Decimal(14, 2)
  costPerPrimaryUnit      Decimal          @default(0) @db.Decimal(14, 4)

  // Default Supplier & Storage
  defaultSupplierId       String?
  defaultSupplier         Supplier?        @relation("IngredientDefaultSupplier", fields: [defaultSupplierId], references: [id], onDelete: SetNull)
  storageCondition        StorageCondition @default(AMBIENT)
  shelfLifeDays           Int?
  isActive                Boolean          @default(true)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  balances                InventoryBalance[]
  batches                 IngredientBatch[]
  recipeIngredients       RecipeIngredient[]
  recipeOptionModifiers   RecipeOptionModifier[]
  unitConversionsFrom     IngredientUnitConversion[] @relation("FromUnitConversions")
  unitConversionsTo       IngredientUnitConversion[] @relation("ToUnitConversions")
  supplierIngredients     SupplierIngredient[]
  ledgerTransactions      InventoryTransaction[]
  wasteItems              InventoryWaste[]
  reservations            InventoryReservation[]
  purchaseRequestItems    PurchaseRequestItem[]
  purchaseOrderItems      PurchaseOrderItem[]
  goodsReceiptItems       GoodsReceiptItem[]
  stockTransferItems      StockTransferItem[]
  stocktakeItems          StocktakeItem[]

  @@index([categoryId])
  @@index([isActive])
  @@index([defaultSupplierId])
}

model IngredientUnitConversion {
  id               String         @id @default(uuid())
  ingredientId     String
  ingredient       Ingredient     @relation("FromUnitConversions", fields: [ingredientId], references: [id], onDelete: Cascade)
  fromUnitId       String
  fromUnit         IngredientUnit @relation("UnitConversionsFrom", fields: [fromUnitId], references: [id], onDelete: Restrict)
  toUnitId         String
  toUnit           IngredientUnit @relation("UnitConversionsTo", fields: [toUnitId], references: [id], onDelete: Restrict)
  conversionFactor Float
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  IngredientToConversion Ingredient[] @relation("ToUnitConversions")

  @@unique([ingredientId, fromUnitId, toUnitId])
  @@index([ingredientId])
}

model Warehouse {
  id                   String                 @id @default(uuid())
  code                 String                 @unique
  name                 String
  description          String?                @db.Text
  branchId             String?
  branch               Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  managerId            String?
  managerName          String?
  storageZone          String?                // KITCHEN_STORAGE, BAR_STORAGE, FROZEN_STORAGE, DRY_STORAGE, CENTRAL_HUB
  isCentral            Boolean                @default(false)
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  locations            WarehouseLocation[]
  balances             InventoryBalance[]
  batches              IngredientBatch[]
  ledgerTransactions   InventoryTransaction[]
  reservations         InventoryReservation[]
  purchaseRequests     PurchaseRequest[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  transfersOut         StockTransfer[]        @relation("TransfersFromWarehouse")
  transfersIn          StockTransfer[]        @relation("TransfersToWarehouse")
  stocktakes           Stocktake[]
  wasteRecords         InventoryWaste[]

  @@index([branchId])
  @@index([isCentral, isActive])
}

model WarehouseLocation {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zone        String    @db.VarChar(50)
  aisle       String?   @db.VarChar(50)
  shelf       String?   @db.VarChar(50)
  bin         String?   @db.VarChar(50)
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  batches     IngredientBatch[]

  @@unique([warehouseId, zone, aisle, shelf, bin])
  @@index([warehouseId])
}

model InventoryBalance {
  id             String     @id @default(uuid())
  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  // Quantities in primary base unit
  currentStock   Decimal    @default(0) @db.Decimal(14, 4)
  reservedStock  Decimal    @default(0) @db.Decimal(14, 4)
  availableStock Decimal    @default(0) @db.Decimal(14, 4) // currentStock - reservedStock
  valuation      Decimal    @default(0) @db.Decimal(14, 2) // currentStock * averagePurchaseCost

  lastCountDate  DateTime?
  lastReceivedAt DateTime?
  lastConsumedAt DateTime?
  updatedAt      DateTime   @updatedAt

  @@unique([ingredientId, warehouseId])
  @@index([warehouseId])
  @@index([ingredientId])
}

model IngredientBatch {
  id                String            @id @default(uuid())
  batchNumber       String            @db.VarChar(100)
  ingredientId      String
  ingredient        Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  warehouseId       String
  warehouse         Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  locationId        String?
  location          WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  supplierId        String?
  supplier          Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  receivedDate      DateTime          @default(now())
  expirationDate    DateTime
  initialQuantity   Decimal           @db.Decimal(14, 4)
  remainingQuantity Decimal           @db.Decimal(14, 4)
  unitCost          Decimal           @db.Decimal(14, 2)
  status            String            @default("ACTIVE") // ACTIVE, DEPLETED, EXPIRED, BLOCKED
  storageCondition  StorageCondition  @default(AMBIENT)
  notes             String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  transactions      InventoryTransaction[]
  wasteRecords      InventoryWaste[]
  transferItems     StockTransferItem[]
  stocktakeItems    StocktakeItem[]

  @@unique([batchNumber, ingredientId, warehouseId])
  @@index([ingredientId, warehouseId, expirationDate])
  @@index([status, expirationDate])
}

model InventoryTransaction {
  id                     String                   @id @default(uuid())
  transactionCode        String                   @unique
  ingredientId           String
  ingredient             Ingredient               @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  ingredientNameSnapshot String
  branchId               String
  branch                 Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouseId            String
  warehouse              Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  batchId                String?
  batch                  IngredientBatch?         @relation(fields: [batchId], references: [id], onDelete: SetNull)
  type                   InventoryTransactionType

  // Quantity movements in primary unit
  quantityIn             Decimal                  @default(0) @db.Decimal(14, 4)
  quantityOut            Decimal                  @default(0) @db.Decimal(14, 4)
  unitSymbol             String
  unitCost               Decimal                  @default(0) @db.Decimal(14, 4)
  totalCost              Decimal                  @default(0) @db.Decimal(14, 2)

  // Balance snapshots after transaction
  beforeQuantity         Decimal                  @db.Decimal(14, 4)
  afterQuantity          Decimal                  @db.Decimal(14, 4)

  // Document references
  sourceReference        String?
  orderId                String?
  order                  Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItemId            String?
  orderItem              OrderItem?               @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  purchaseOrderId        String?
  purchaseOrder          PurchaseOrder?           @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceiptId         String?
  goodsReceipt           GoodsReceipt?            @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  stockTransferId        String?
  stockTransfer          StockTransfer?           @relation(fields: [stockTransferId], references: [id], onDelete: SetNull)
  stocktakeId            String?
  stocktake              Stocktake?               @relation(fields: [stocktakeId], references: [id], onDelete: SetNull)
  wasteId                String?
  wasteRecord            InventoryWaste?          @relation(fields: [wasteId], references: [id], onDelete: SetNull)

  // Audit and Concurrency
  actorId                String?
  actorName              String?
  notes                  String?                  @db.Text
  idempotencyKey         String?                  @unique
  correlationId          String?
  createdAt              DateTime                 @default(now())

  @@index([ingredientId, warehouseId, createdAt])
  @@index([branchId, type, createdAt])
  @@index([orderId])
  @@index([orderItemId])
  @@index([purchaseOrderId])
  @@index([stockTransferId])
  @@index([correlationId])
}

model InventoryReservation {
  id               String     @id @default(uuid())
  orderId          String
  order            Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId      String
  orderItem        OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ingredientId     String
  ingredient       Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  warehouseId      String
  warehouse        Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  reservedQuantity Decimal    @db.Decimal(14, 4)
  unitSymbol       String
  status           String     @default("ACTIVE") // ACTIVE, CONSUMED, RELEASED
  releasedAt       DateTime?
  consumedAt       DateTime?
  createdAt        DateTime   @default(now())

  @@index([orderId, orderItemId])
  @@index([ingredientId, warehouseId, status])
}

model Recipe {
  id             String          @id @default(uuid())
  code           String          @unique
  name           String
  description    String?         @db.Text
  productId      String?         @unique
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  isSemiFinished Boolean         @default(false)
  servingSize    Float           @default(1.0)
  yieldQuantity  Float           @default(1.0)
  yieldUnit      String          @default("phần")
  activeVersionId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  versions       RecipeVersion[]

  @@index([isSemiFinished])
}

model RecipeVersion {
  id                     String           @id @default(uuid())
  recipeId               String
  recipe                 Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  versionNumber          Int              @default(1)
  status                 RecipeStatus     @default(DRAFT)
  effectiveDate          DateTime         @default(now())

  costPerServing         Decimal          @default(0) @db.Decimal(14, 2)
  totalRecipeCost        Decimal          @default(0) @db.Decimal(14, 2)
  preparationLossPercent Float            @default(0)
  notes                  String?          @db.Text

  createdById            String?
  createdByName          String?
  approvedById           String?
  approvedByName         String?
  approvedAt             DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  ingredients            RecipeIngredient[]
  optionModifiers        RecipeOptionModifier[]

  @@unique([recipeId, versionNumber])
  @@index([recipeId, status])
}

model RecipeIngredient {
  id                     String        @id @default(uuid())
  recipeVersionId        String
  recipeVersion          RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  ingredientId           String
  ingredient             Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity               Decimal       @db.Decimal(14, 4)
  unitSymbol             String
  unitCostSnapshot       Decimal       @default(0) @db.Decimal(14, 4)
  totalCostSnapshot      Decimal       @default(0) @db.Decimal(14, 2)
  preparationLossPercent Float         @default(0)
  isSubstitutable        Boolean       @default(false)
  notes                  String?

  @@index([recipeVersionId])
  @@index([ingredientId])
}

model RecipeOptionModifier {
  id                String        @id @default(uuid())
  recipeVersionId   String
  recipeVersion     RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  optionItemId      String
  optionItem        OptionItem    @relation(fields: [optionItemId], references: [id], onDelete: Cascade)
  ingredientId      String
  ingredient        Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantityDelta     Decimal       @db.Decimal(14, 4) // e.g. +30g or -10g
  unitSymbol        String
  costDeltaSnapshot Decimal       @default(0) @db.Decimal(14, 2)
  notes             String?

  @@index([recipeVersionId])
  @@index([optionItemId])
  @@index([ingredientId])
}

model Supplier {
  id                String               @id @default(uuid())
  code              String               @unique
  name              String
  contactPerson     String?
  phone             String?
  email             String?
  address           String?
  taxCode           String?
  paymentTerms      String               @default("COD") // COD, NET15, NET30, NET45
  bankName          String?
  bankAccountNumber String?
  bankAccountHolder String?
  status            String               @default("ACTIVE") // ACTIVE, SUSPENDED, INACTIVE
  rating            Float                @default(5.0)
  notes             String?              @db.Text
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  defaultIngredients Ingredient[]        @relation("IngredientDefaultSupplier")
  supplierIngredients SupplierIngredient[]
  batches            IngredientBatch[]
  purchaseOrders     PurchaseOrder[]

  @@index([status])
}

model SupplierIngredient {
  id                  String     @id @default(uuid())
  supplierId          String
  supplier            Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  ingredientId        String
  ingredient          Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  supplierProductCode String?
  purchasePrice       Decimal    @db.Decimal(14, 2)
  purchaseUnitSymbol  String
  leadTimeDays        Int        @default(1)
  minOrderQuantity    Decimal    @default(1) @db.Decimal(14, 4)
  isPreferred         Boolean    @default(false)
  updatedAt           DateTime   @updatedAt

  @@unique([supplierId, ingredientId])
  @@index([supplierId])
  @@index([ingredientId])
}

model PurchaseRequest {
  id              String                @id @default(uuid())
  requestCode     String                @unique
  branchId        String
  branch          Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouseId     String
  warehouse       Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status          PurchaseRequestStatus @default(PENDING)
  requiredDate    DateTime
  reason          String?               @db.Text
  requestedById   String?
  requestedByName String?
  approvedById    String?
  approvedByName  String?
  approvedAt      DateTime?
  notes           String?               @db.Text
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  items           PurchaseRequestItem[]
  purchaseOrders  PurchaseOrder[]

  @@index([branchId, status])
  @@index([warehouseId])
}

model PurchaseRequestItem {
  id                String          @id @default(uuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  ingredientId      String
  ingredient        Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  requestedQuantity Decimal         @db.Decimal(14, 4)
  approvedQuantity  Decimal?        @db.Decimal(14, 4)
  unitSymbol        String
  estimatedCost     Decimal         @default(0) @db.Decimal(14, 2)

  @@index([purchaseRequestId])
  @@index([ingredientId])
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  orderCode            String              @unique
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branchId             String
  branch               Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouseId          String
  warehouse            Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  purchaseRequestId    String?
  purchaseRequest      PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  status               PurchaseOrderStatus @default(DRAFT)
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?

  subtotal             Decimal             @default(0) @db.Decimal(14, 2)
  taxAmount            Decimal             @default(0) @db.Decimal(14, 2)
  shippingFee          Decimal             @default(0) @db.Decimal(14, 2)
  totalAmount          Decimal             @default(0) @db.Decimal(14, 2)
  notes                String?             @db.Text

  createdById          String?
  createdByName        String?
  approvedById         String?
  approvedByName       String?
  approvedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  items                PurchaseOrderItem[]
  receipts             GoodsReceipt[]
  transactions         InventoryTransaction[]

  @@index([supplierId])
  @@index([branchId, status])
  @@index([warehouseId])
  @@index([orderDate])
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId     String
  ingredient       Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  orderQuantity    Decimal       @db.Decimal(14, 4)
  receivedQuantity Decimal       @default(0) @db.Decimal(14, 4)
  unitSymbol       String
  unitPrice        Decimal       @db.Decimal(14, 2)
  taxPercent       Float         @default(0)
  totalAmount      Decimal       @db.Decimal(14, 2)

  goodsReceiptItems GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([ingredientId])
}

model GoodsReceipt {
  id                     String             @id @default(uuid())
  receiptCode            String             @unique
  purchaseOrderId        String?
  purchaseOrder          PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  branchId               String
  branch                 Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouseId            String
  warehouse              Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receiptDate            DateTime           @default(now())
  supplierInvoiceNumber  String?
  deliveryNoteNumber     String?
  status                 GoodsReceiptStatus @default(DRAFT)
  totalAmount            Decimal            @default(0) @db.Decimal(14, 2)

  receivedById           String?
  receivedByName         String?
  confirmedById          String?
  confirmedByName        String?
  confirmedAt            DateTime?
  notes                  String?            @db.Text
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  items                  GoodsReceiptItem[]
  transactions           InventoryTransaction[]

  @@index([purchaseOrderId])
  @@index([branchId, status])
  @@index([warehouseId])
  @@index([receiptDate])
}

model GoodsReceiptItem {
  id                  String             @id @default(uuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  ingredientId        String
  ingredient          Ingredient         @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  batchNumber         String?
  expirationDate      DateTime?
  receivedQuantity    Decimal            @db.Decimal(14, 4)
  rejectedQuantity    Decimal            @default(0) @db.Decimal(14, 4)
  rejectionReason     String?
  unitSymbol          String
  unitCost            Decimal            @db.Decimal(14, 2)
  totalAmount         Decimal            @db.Decimal(14, 2)
  storageLocation     String?

  @@index([goodsReceiptId])
  @@index([ingredientId])
}

model StockTransfer {
  id              String              @id @default(uuid())
  transferCode    String              @unique
  fromBranchId    String
  fromBranch      Branch              @relation("TransfersFromBranch", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranchId      String
  toBranch        Branch              @relation("TransfersToBranch", fields: [toBranchId], references: [id], onDelete: Restrict)
  fromWarehouseId String
  fromWarehouse   Warehouse           @relation("TransfersFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouseId   String
  toWarehouse     Warehouse           @relation("TransfersToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  status          StockTransferStatus @default(DRAFT)

  requestedById   String?
  requestedByName String?
  approvedById    String?
  approvedByName  String?
  dispatchedById  String?
  dispatchedByName String?
  dispatchedAt    DateTime?
  receivedById    String?
  receivedByName  String?
  receivedAt      DateTime?
  notes           String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  items           StockTransferItem[]
  transactions    InventoryTransaction[]

  @@index([fromBranchId, toBranchId, status])
  @@index([fromWarehouseId, toWarehouseId])
  @@index([createdAt])
}

model StockTransferItem {
  id                 String           @id @default(uuid())
  stockTransferId    String
  stockTransfer      StockTransfer    @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  ingredientId       String
  ingredient         Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  batchId            String?
  batch              IngredientBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  requestedQuantity  Decimal          @db.Decimal(14, 4)
  dispatchedQuantity Decimal          @default(0) @db.Decimal(14, 4)
  receivedQuantity   Decimal          @default(0) @db.Decimal(14, 4)
  unitSymbol         String
  unitCost           Decimal          @default(0) @db.Decimal(14, 2)
  notes              String?

  @@index([stockTransferId])
  @@index([ingredientId])
}

model Stocktake {
  id                    String          @id @default(uuid())
  stocktakeCode         String          @unique
  warehouseId           String
  warehouse             Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  branchId              String
  branch                Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  status                StocktakeStatus @default(DRAFT)
  isBlindCount          Boolean         @default(false)

  totalSystemQuantity   Decimal         @default(0) @db.Decimal(14, 4)
  totalActualQuantity   Decimal         @default(0) @db.Decimal(14, 4)
  totalVarianceQuantity Decimal         @default(0) @db.Decimal(14, 4)
  totalVarianceValue    Decimal         @default(0) @db.Decimal(14, 2)

  conductedById         String?
  conductedByName       String?
  conductedAt           DateTime?
  approvedById          String?
  approvedByName        String?
  approvedAt            DateTime?
  notes                 String?         @db.Text
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  items                 StocktakeItem[]
  transactions          InventoryTransaction[]

  @@index([branchId, warehouseId, status])
  @@index([createdAt])
}

model StocktakeItem {
  id               String           @id @default(uuid())
  stocktakeId      String
  stocktake        Stocktake        @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  ingredientId     String
  ingredient       Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  batchId          String?
  batch            IngredientBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  systemQuantity   Decimal          @db.Decimal(14, 4)
  actualQuantity   Decimal          @db.Decimal(14, 4)
  varianceQuantity Decimal          @db.Decimal(14, 4) // actual - system
  unitSymbol       String
  unitCost         Decimal          @db.Decimal(14, 2)
  varianceValue    Decimal          @db.Decimal(14, 2) // varianceQuantity * unitCost
  reason           String?
  notes            String?

  @@index([stocktakeId])
  @@index([ingredientId])
}

model InventoryWaste {
  id                String               @id @default(uuid())
  wasteCode         String               @unique
  branchId          String
  branch            Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouseId       String
  warehouse         Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  ingredientId      String
  ingredient        Ingredient           @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  batchId           String?
  batch             IngredientBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)

  orderId           String?
  orderItemId       String?

  quantity          Decimal              @db.Decimal(14, 4)
  unitSymbol        String
  unitCost          Decimal              @db.Decimal(14, 2)
  totalLossValue    Decimal              @db.Decimal(14, 2)
  reason            InventoryWasteReason @default(EXPIRED)
  explanation       String?              @db.Text

  reportedById      String?
  reportedByName    String?
  approvedById      String?
  approvedByName    String?
  approvedAt        DateTime?
  evidenceImageUrl  String?
  notes             String?              @db.Text
  createdAt         DateTime             @default(now())

  transactions      InventoryTransaction[]

  @@index([branchId, warehouseId, reason])
  @@index([ingredientId])
  @@index([createdAt])
}

// =========================================================================
// PHASE 3.1 — OPERATIONAL INVENTORY POLICY & EXCEPTION MONITORING
// =========================================================================

enum InventoryTrackingPolicy {
  STRICT_TRACKING
  WARN_AND_ALLOW
  MANUAL_CONSUMPTION
}

enum InventoryExceptionType {
  MISSING_RECIPE
  INSUFFICIENT_STOCK
  NEGATIVE_STOCK_ATTEMPT
  EXPIRED_BATCH_BLOCKED
  QUARANTINED_BATCH_BLOCKED
  RESERVATION_FAILED
  CONSUMPTION_FAILED
  MANUAL_CONSUMPTION_PENDING
  OFFLINE_SYNC_CONFLICT
}

enum InventoryExceptionStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model InventoryOperationalException {
  id               String                   @id @default(uuid())
  branchId         String
  branch           Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  warehouseId      String?
  orderId          String?
  orderCode        String?
  orderItemId      String?
  productId        String?
  product          Product?                 @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName      String?
  recipeVersionId  String?
  ingredientId     String?
  ingredientName   String?
  exceptionType    InventoryExceptionType
  policyApplied    InventoryTrackingPolicy
  status           InventoryExceptionStatus @default(OPEN)
  severity         String                   @default("WARNING") // CRITICAL, WARNING, INFO
  failureReason    String                   @db.Text
  recommendedAction String?                 @db.Text
  correlationId    String?
  actorId          String?
  actorName        String?
  detectedAt       DateTime                 @default(now())
  resolvedById     String?
  resolvedByName   String?
  resolutionNotes  String?                  @db.Text
  resolvedAt       DateTime?

  @@index([branchId, status, detectedAt])
  @@index([exceptionType, status])
  @@index([orderId])
  @@index([correlationId])
}

// ====================================================================
// HỆ THỐNG CHẤM CÔNG & LỊCH CA NHÂN VIÊN (ATTENDANCE & SHIFT MANAGEMENT)
// Tương đương 100% nghiệp vụ SUSHI WA Legacy
// ====================================================================

model Shift {
  id              String      @id @default(uuid())
  shiftDate       DateTime    @map("shift_date") @db.Date
  roleId          String?     @map("role_id")
  name            String
  startTime       String      @map("start_time") // HH:mm
  endTime         String      @map("end_time")   // HH:mm
  gracePeriodMins Int         @default(5) @map("grace_period_mins")
  branchId        String?     @map("branch_id")
  isSplitShift    Boolean     @default(false) @map("is_split_shift")
  startTime2      String?     @map("start_time_2") // HH:mm
  endTime2        String?     @map("end_time_2")   // HH:mm
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  role            AccessRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  branch          Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedUsers   User[]      @relation("ShiftAssignedUsers")
  attendances     Attendance[]

  @@index([shiftDate])
  @@index([roleId])
  @@index([branchId])
  @@map("shifts")
}

model Attendance {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  branchId       String      @map("branch_id")
  shiftId        String?     @map("shift_id")
  workDate       DateTime    @map("work_date") @db.Date
  checkInTime    DateTime?   @map("check_in_time")
  checkOutTime   DateTime?   @map("check_out_time")
  status         String      @default("ON_TIME") // ON_TIME, LATE, EARLY_LEAVE, LATE_AND_EARLY_LEAVE, FLEXIBLE, MISSING_CHECKOUT
  totalWorkHours Float?      @map("total_work_hours")
  notes          String?     @db.VarChar(500)
  sourceSystem   String?     @default("AVORA") @map("source_system") // AVORA or SUSHI_WA
  legacyId       String?     @map("legacy_id") // Truy vết dữ liệu migration
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch         Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shift          Shift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([userId, workDate])
  @@index([branchId, workDate])
  @@index([workDate])
  @@map("attendances")
}

model AttendanceLog {
  id                 String    @id @default(uuid())
  userId             String?   @map("user_id")
  branchId           String?   @map("branch_id")
  scanTime           DateTime  @default(now()) @map("scan_time")
  scanType           String    @map("scan_type") // CHECK_IN, CHECK_OUT, MANUAL_ADD, UPDATE_RECORD, DELETE_RECORD
  clientLatitude     Float     @default(0) @map("client_latitude")
  clientLongitude    Float     @default(0) @map("client_longitude")
  distanceCalculated Float     @default(0) @map("distance_calculated")
  clientAccuracy     Float     @default(0) @map("client_accuracy")
  isSuccess          Boolean   @default(false) @map("is_success")
  errorCode          String?   @map("error_code")
  deviceId           String?   @map("device_id")
  rawQrData          String?   @map("raw_qr_data") @db.Text
  shiftName          String?   @map("shift_name")
  createdAt          DateTime  @default(now()) @map("created_at")

  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch             Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([userId, scanTime])
  @@index([branchId, scanTime])
  @@index([scanTime])
  @@map("attendance_logs")
}

model WebPushSubscription {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  deviceInstallationId String    @map("device_installation_id") @db.VarChar(64)
  endpoint             String    @unique @db.VarChar(500)
  p256dh               String    @db.Text
  auth                 String    @db.VarChar(255)
  platform             String    @db.VarChar(20) // IOS, ANDROID, DESKTOP
  browser              String?   @db.VarChar(50)
  userAgent            String?   @map("user_agent") @db.Text
  sessionId            String?   @map("session_id") @db.VarChar(128)
  branchId             String?   @map("branch_id")
  status               String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, REVOKED, EXPIRED
  categoryPreferences  Json?     @map("category_preferences")
  sessionExpiresAt     DateTime? @map("session_expires_at")
  lastSeenAt           DateTime  @default(now()) @map("last_seen_at")
  revokedAt            DateTime? @map("revoked_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([sessionId])
  @@index([deviceInstallationId])
  @@index([branchId])
  @@index([status])
  @@map("web_push_subscriptions")
}

model StaffNotificationPreference {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  orderEnabled   Boolean  @default(true) @map("order_enabled")
  itemEnabled    Boolean  @default(true) @map("item_enabled")
  kitchenEnabled Boolean  @default(true) @map("kitchen_enabled")
  qrOrderEnabled Boolean  @default(true) @map("qr_order_enabled")
  serviceEnabled Boolean  @default(true) @map("service_enabled")
  paymentEnabled Boolean  @default(true) @map("payment_enabled")
  tableEnabled   Boolean  @default(true) @map("table_enabled")
  buffetEnabled  Boolean  @default(true) @map("buffet_enabled")
  alertEnabled   Boolean  @default(true) @map("alert_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_notification_preferences")
}



