enum ArchitectIngredientCategory {
  BASE_CARB // Tinh bột nền
  PROTEIN // Đạm chính
  GREENS_VEGGIES // Rau xanh & chất xơ
  SIGNATURE_SAUCE // Nước sốt độc quyền
  CRUNCH_TOPPING // Topping giòn rắc mặt
}

model ArchitectIngredient {
  id          String                      @id @default(uuid())
  code        String                      @unique
  name        String
  category    ArchitectIngredientCategory
  description String?                     @db.Text
  imageUrl    String                      @db.Text
  baseGram    Float                       @default(100)
  price       Float

  // Dinh dưỡng trên baseGram
  calories Float
  protein  Float
  carbs    Float
  fat      Float
  fiber    Float @default(0)
  sodiumMg Float @default(0)

  // Flavor Profile (Thang điểm 0 - 10)
  spiciness Int @default(0)
  sweetness Int @default(0)
  saltiness Int @default(0)
  sourness  Int @default(0)
  richness  Int @default(0)
  umami     Int @default(0)

  // Cảnh báo dị ứng & Chế độ ăn
  allergensJson String? @db.Text // JSON string: ["PEANUT", "SEAFOOD"]
  isVegan       Boolean @default(false)
  isKeto        Boolean @default(false)
  isGlutenFree  Boolean @default(false)

  isAvailable Boolean @default(true)
  sortOrder   Int     @default(0)

  recipeItems CustomRecipeItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([category, isAvailable])
}

model CustomUserRecipe {
  id            String  @id @default(uuid())
  recipeCode    String  @unique
  userId        String?
  user          User?   @relation("UserCustomRecipes", fields: [userId], references: [id], onDelete: SetNull)
  recipeName    String
  creatorName   String  @default("Thực khách sành ăn")
  description   String? @db.Text
  coverImageUrl String? @db.Text

  totalPrice    Float
  totalCalories Float
  totalProtein  Float
  totalCarbs    Float
  totalFat      Float

  isPublic      Boolean @default(true)
  forkCount     Int     @default(0)
  likeCount     Int     @default(0)
  affiliateCode String? @unique

  items      CustomRecipeItem[]
  orderItems OrderItem[]
  schedules  SubscriptionDeliverySchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

