  user        User?         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([updatedAt])
}

model ChatMessage {
  id             String          @id @default(uuid())
  sessionId      String
  senderType     ChatSenderType
  content        String          @db.Text
  functionName   String?
  functionArgs   String?         @db.Text
  functionResult String?         @db.Text
