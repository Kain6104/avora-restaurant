  @@index([branchId, areaId])
}

model ReservationTable {
  reservationId String
  tableId       String
  createdAt     DateTime        @default(now())
  reservation   Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table         RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@id([reservationId, tableId])
  @@index([tableId, reservationId])
}

model BranchSpecialHours {
  id        String   @id @default(uuid())
  branchId  String
  date      DateTime @db.Date
  openTime  String?
  closeTime String?
  isClosed  Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date])
  @@index([branchId, date])
}

model ReservationBlock {
  id              String   @id @default(uuid())
  branchId        String
  startAt         DateTime
  endAt           DateTime
  blockType       String   @default("FULL_BLOCK") // FULL_BLOCK, CAPACITY_BLOCK
  blockedCapacity Int?
  areaId          String?
  reason          String
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, startAt, endAt])
}

model ReservationReminderLog {
  id            String      @id @default(uuid())
  reservationId String
  reminderType  String // REMINDER_24H, REMINDER_2H
  scheduledFor  DateTime
  sentAt        DateTime    @default(now())
  status        String      @default("SENT")
  error         String?     @db.Text
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, reminderType])
  @@index([reservationId])
}

model ReservationSlotLock {
  id                    String   @id @default(uuid())
  branchId              String
  slotKey               String // YYYY-MM-DD_HH:mm
  currentBookedCapacity Int      @default(0)
  updatedAt             DateTime @updatedAt
  branch                Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, slotKey])
  @@index([branchId, slotKey])
}

model ReservationWaitlist {
  id               String    @id @default(uuid())
  branchId         String
  userId           String?
  customerName     String
  customerPhone    String
  customerEmail    String?
  requestedStartAt DateTime
  partySize        Int
  status           String    @default("WAITING") // WAITING, NOTIFIED, CONVERTED, CANCELLED, EXPIRED
  note             String?   @db.Text
  notifiedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  branch           Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, requestedStartAt])
  @@index([customerPhone])
}

model OrderRelation {
  id            String            @id @default(uuid())
  parentOrderId String
  childOrderId  String
  type          OrderRelationType // SPLIT_FROM, MERGED_INTO
  metadata      String?           @db.Text
  createdAt     DateTime          @default(now())

  parentOrder Order @relation("ParentOrderRelations", fields: [parentOrderId], references: [id], onDelete: Cascade)
  childOrder  Order @relation("ChildOrderRelations", fields: [childOrderId], references: [id], onDelete: Cascade)

  @@index([parentOrderId])
  @@index([childOrderId])
}

model OrderItemTransferLog {
  id                 String   @id @default(uuid())
  sourceOrderId      String
  targetOrderId      String
  productId          String
  quantity           Int
  actorId            String?
  reason             String?
  sourceItemSnapshot String?  @db.Text
  createdAt          DateTime @default(now())

  @@index([sourceOrderId])
  @@index([targetOrderId])
  @@index([createdAt])
}

model OrderSequence {
  id         String   @id @default(uuid())
  branchId   String
  date       String // Format: DDMMYY e.g. "070926"
  type       String   @default("POS")
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date, type])
  @@index([branchId, date])
}

model OrderServiceCharge {
  id            String   @id @default(uuid())
  orderId       String
  name          String
  amount        Float
  note          String?  @db.Text
  isTaxable     Boolean  @default(false)
  taxPercentage Float?   @default(0)
  createdBy     String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model TableSession {
  id              String             @id @default(uuid())
  branchId        String
  tableId         String
  status          TableSessionStatus @default(ACTIVE)
  openedAt        DateTime           @default(now())
  closedAt        DateTime?
  guestCount      Int                @default(1)
  cashierId       String?
  order           Order?
  table           RestaurantTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  branch          Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  qrOrderSessions QrOrderSession[]

  @@index([branchId, tableId, status])
}

model OrderPayment {
  id             String              @id @default(uuid())
  orderId        String
  paymentMethod  String // CASH, CARD, TRANSFER, PAYOS, MOMO, VNPAY, POINT
  amount         Float
  status         PaymentRecordStatus @default(COMPLETED)
  transactionRef String?
  cashReceived   Float?
  cashChange     Float?
  cardType       String?
  cardLast4      String?
  note           String?             @db.Text
  cashierId      String?
  shiftId        String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shift   CashShift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  refunds PaymentRefund[]

  @@index([orderId])
  @@index([shiftId])
  @@index([paymentMethod])
  @@index([createdAt])
}

model PaymentRefund {
  id               String             @id @default(uuid())
  orderPaymentId   String
  amount           Float
  reason           String?            @db.Text
  cashierId        String?
  refundMethod     String?            // CASH, BANK_TRANSFER, CARD, EWALLET
  status           String             @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, FAILED
  shiftId          String?
  bankReference    String?
  bankDestination  String?
  approvedById     String?
  approvedByName   String?
  executedById     String?
  executedByName   String?
  cancellationId   String?
  taxInvoiceAction String?            // NONE, CANCEL, ADJUST, REPLACE
  taxInvoiceStatus String?            @default("NONE") // NONE, PENDING, COMPLETED
  taxInvoiceNotes  String?            @db.Text
  createdAt        DateTime           @default(now())

  payment          OrderPayment       @relation(fields: [orderPaymentId], references: [id], onDelete: Cascade)
  shift            CashShift?         @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  cancellation     OrderCancellation? @relation(fields: [cancellationId], references: [id], onDelete: SetNull)

  @@index([orderPaymentId])
  @@index([shiftId])
  @@index([cancellationId])
}

model CashShift {
  id              String          @id @default(uuid())
  branchId        String
  cashierId       String
  status          ShiftStatus     @default(OPEN)
  openedAt        DateTime        @default(now())
  closedAt        DateTime?
  openingBalance  Float           @default(0)
  closingBalance  Float?
  expectedBalance Float?
  cashDifference  Float?
  totalRevenue    Float           @default(0)
  totalCash       Float           @default(0)
  totalCard       Float           @default(0)
  totalTransfer   Float           @default(0)
  orderCount      Int             @default(0)
  note            String?         @db.Text
  openedById      String
  closedById      String?

  branch   Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashier  User            @relation("CashierShifts", fields: [cashierId], references: [id])
  openedBy User            @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedBy User?           @relation("ShiftClosedBy", fields: [closedById], references: [id])
  payments OrderPayment[]
  refunds  PaymentRefund[]

  @@index([branchId, cashierId, status])
  @@index([openedAt])
}

model IdempotencyRecord {
  key       String   @id
  action    String
  response  String   @db.LongText
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model PrintTemplate {
  id      String            @id @default(uuid())
  name    String
  type    PrintTemplateType
  content String            @db.LongText

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  isDefault Boolean @default(false)

  paperSize String? @default("80mm")
  settings  Json?

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions  PrintTemplateVersion[]
  printJobs PrintJob[]

  @@index([branchId])
  @@index([branchId, type])
}

model PrintTemplateVersion {
  id              String   @id @default(uuid())
  printTemplateId String
  version         Int
  content         String   @db.LongText
  paperSize       String?
  settings        Json?
  createdBy       String?
  createdAt       DateTime @default(now())

  printTemplate PrintTemplate @relation(fields: [printTemplateId], references: [id], onDelete: Cascade)

  @@index([printTemplateId])
  @@index([printTemplateId, version])
}

enum PrintTemplateType {
  RECEIPT
  TEMP_BILL
  KITCHEN
  BAR
  ITEM_LABEL
  KITCHEN_TICKET
  ONLINE_ORDER
}

model VoucherPaymentMethod {
  voucherId       String
  paymentMethodId String

  voucher       Voucher       @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@id([voucherId, paymentMethodId])
  @@index([paymentMethodId])
}

enum PrinterConnectionType {
  NETWORK_DIRECT
  PRINT_AGENT
}

enum PrinterStatus {
  ONLINE
  OFFLINE
  ERROR
}

enum PrinterPayloadType {
  ESC_POS
  HTML
  PDF
  ZPL
}

enum PrintRouteRole {
  PREPARATION
  LABEL
  EXPEDITOR
}

enum PrintJobStatus {
  PENDING
  PROCESSING
  DISPATCHED
  PRINTED
  FAILED
  UNKNOWN
  CANCELED
}

enum PrintJobEventType {
  NEW_ITEM
  ADD_QUANTITY
  CANCEL_ITEM
  RETURN_ITEM
  ITEM_LABEL
  REPRINT
}

model KitchenStation {
  id          String   @id @default(uuid())
  branchId    String
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch          Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  stationPrinters KitchenStationPrinter[]
  productRoutes   ProductPrintRoute[]
  printJobs       PrintJob[]
  kitchenEvents   KitchenEvent[]

  @@unique([branchId, code])
  @@index([branchId])
}

model Printer {
  id             String                @id @default(uuid())
  branchId       String
  name           String
  connectionType PrinterConnectionType @default(NETWORK_DIRECT)
  payloadType    PrinterPayloadType    @default(ESC_POS)
  ipAddress      String?
  port           Int                   @default(9100)
  agentId        String?
  paperSize      String                @default("80mm")
  labelWidthMm   Int?
  labelHeightMm  Int?
  isActive       Boolean               @default(true)
  status         PrinterStatus         @default(ONLINE)
  lastSeenAt     DateTime?
  lastPrintAt    DateTime?
  lastError      String?               @db.Text
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  branch          Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  agent           PrintAgent?             @relation(fields: [agentId], references: [id], onDelete: SetNull)
  stationPrinters KitchenStationPrinter[]
  printJobs       PrintJob[]
  branchSettings  BranchPrinterSetting[]

  @@index([branchId])
  @@index([agentId])
}

model PrintAgent {
  id         String    @id @default(uuid())
  branchId   String
  agentCode  String    @unique
  name       String
  secretHash String
  salt       String
  isActive   Boolean   @default(true)
  ipAddress  String?
  version    String?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  printers Printer[]

  @@index([branchId])
}

model KitchenStationPrinter {
  id           String   @id @default(uuid())
  stationId    String
  printerId    String
  isPrimary    Boolean  @default(true)
  priority     Int      @default(1)
  isActive     Boolean  @default(true)
  printPurpose String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  station KitchenStation @relation(fields: [stationId], references: [id], onDelete: Restrict)
  printer Printer        @relation(fields: [printerId], references: [id], onDelete: Restrict)

  @@unique([stationId, printerId])
  @@index([stationId])
  @@index([printerId])
}

model ProductPrintRoute {
  id        String            @id @default(uuid())
  productId String
  branchId  String
  stationId String
  routeRole PrintRouteRole    @default(PREPARATION)
  printType PrintTemplateType @default(KITCHEN_TICKET)
  copies    Int               @default(1)
  priority  Int               @default(1)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  station KitchenStation @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@index([productId, branchId])
  @@index([branchId])
  @@index([stationId])
}

model PrintJob {
  id              String             @id @default(uuid())
  orderId         String
  orderItemId     String?
  branchId        String
  stationId       String?
  printerId       String?
  printTemplateId String?
  printerName     String?
  templateName    String?
  templateVersion Int?
  paperSize       String?
  printedById     String?
  printedByName   String?
  routeId         String?
  routeRole       PrintRouteRole     @default(PREPARATION)
  payloadType     PrinterPayloadType @default(ESC_POS)
  printType       PrintTemplateType  @default(KITCHEN_TICKET)
  eventType       PrintJobEventType  @default(NEW_ITEM)

  quantity         Float @default(1)
  quantityDelta    Float @default(1)
  printedQtyBefore Float @default(0)
  copies           Int @default(1)

  contentHtml  String  @db.LongText
  payloadData  String? @db.LongText
  snapshotData Json?

  status         PrintJobStatus @default(PENDING)
  attemptCount   Int            @default(0)
  maxAttempts    Int            @default(3)
  errorMessage   String?        @db.Text
  idempotencyKey String         @unique

  reprintOfId   String?
  reprintReason String? @db.Text
  reprintedBy   String?

  metadata  Json?
  printedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  order         Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem     OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  branch        Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  station       KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  printer       Printer?        @relation(fields: [printerId], references: [id], onDelete: SetNull)
  printTemplate PrintTemplate?  @relation(fields: [printTemplateId], references: [id], onDelete: SetNull)

  @@index([branchId, status])
  @@index([orderId])
  @@index([orderItemId])
  @@index([printerId])
  @@index([reprintOfId])
}

model OrderAuditLog {
  id             String   @id @default(uuid())
  orderId        String
  orderCode      String?
  action         String
  category       String   @default("ORDER") // ORDER, PAYMENT, CANCEL, ITEM, KITCHEN, PRINT, POINTS, ADMIN
  actorId        String?
  actorName      String?
  actorUsername  String?
  actorAvatarUrl String?
  actorRole      String?
  branchId       String?
  branchName     String?
  ipAddress      String?
  userAgent      String?  @db.Text
  reason         String?  @db.Text
  oldValue       Json?
  newValue       Json?
  metadata       Json?
  correlationId  String?
  isSensitive    Boolean  @default(false)
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([orderCode])
  @@index([action])
  @@index([category])
  @@index([actorId])
  @@index([branchId, createdAt])
  @@index([correlationId])
}

model OrderCancellation {
  id                          String             @id @default(uuid())
  cancellationCode            String             @unique
  orderId                     String             @unique
  orderCode                   String?
  branchId                    String
  cancellationType            CancellationType
  status                      CancellationStatus @default(CANCELLED)

  // Financial Snapshots
  originalTotal               Float
  subtotal                    Float              @default(0)
  discountAmount              Float              @default(0)
  taxAmount                   Float              @default(0)
  serviceChargeTotal          Float              @default(0)
  shippingFee                 Float              @default(0)

  // Paid & Refund Tracking
  totalCollected              Float              @default(0)
  totalRefunded               Float              @default(0)
  requestedRefundAmount       Float              @default(0)
  retainedAmount              Float              @default(0)

  // Customer & Cashier Snapshots
  customerName                String?
  customerPhone               String?
  customerSnapshot            Json?
  cashierId                   String?
  cashierName                 String?

  // Reason & Explanation
  reasonCode                  String
  explanation                 String?            @db.Text
  notes                       String?            @db.Text

  // Multi-step Actors
  requestedById               String?
  requestedByName             String?
  requestedByRole             String?
  requestedAt                 DateTime           @default(now())

  approvedById                String?
  approvedByName              String?
  approvedByRole              String?
  approvedAt                  DateTime?

  rejectedById                String?
  rejectedByName              String?
  rejectedByRole              String?
  rejectedAt                  DateTime?
  rejectionReason             String?            @db.Text

  cancelledById               String?
  cancelledByName             String?
  cancelledByRole             String?
  cancelledAt                 DateTime?

  completedAt                 DateTime?

  // Operational State Snapshots
  kitchenStatusSnapshot       String?
  paymentStatusSnapshot       String?
  paymentIntentStatusSnapshot String?
  paymentIntentCodeSnapshot   String?

  // Kitchen Handling
  kitchenTicketDispatched     Boolean            @default(false)
  kitchenAcknowledgedAt       DateTime?
  kitchenAcknowledgedById     String?
  wasteRecorded               Boolean            @default(false)
  wasteNotes                  String?            @db.Text

  // Tax Invoice / Electronic Invoice
  isTaxInvoiceIssued          Boolean            @default(false)
  taxInvoiceNumber            String?
  taxInvoiceSeries            String?
  taxInvoiceTaxCode           String?
  taxInvoiceAction            String?            // NONE, CANCEL, ADJUST, REPLACE
  taxInvoiceStatus            String?            @default("NONE") // NONE, PENDING, COMPLETED
  taxInvoiceNotes             String?            @db.Text
  taxInvoiceHandledById       String?
  taxInvoiceHandledAt         DateTime?

  correlationId               String?
  metadata                    Json?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  order                       Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  branch                      Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  refunds                     PaymentRefund[]

  @@index([branchId, cancellationType, createdAt])
  @@index([orderId])
  @@index([status])
  @@index([cancellationType])
  @@index([createdAt])
}

model KitchenEvent {
  id          String            @id @default(uuid())
  orderId     String
  branchId    String
  stationId   String?
  eventType   PrintJobEventType
  itemSummary Json
  createdById String?
  createdAt   DateTime          @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branch  Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  station KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([branchId, createdAt])
}

model BranchPrinterSetting {
  id             String    @id @default(uuid())
  branchId       String
  purpose        String // RECEIPT, TEMP_BILL, KITCHEN, BAR, ITEM_LABEL
  printerId      String?
  agentPrinterId String?
  printerName    String
  driverName     String?
  portName       String?
  paperSize      String    @default("80mm")
  copies         Int       @default(1)
  isEnabled      Boolean   @default(true)
  autoPrint      Boolean   @default(false)
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  printer Printer? @relation(fields: [printerId], references: [id], onDelete: SetNull)

  @@unique([branchId, purpose])
  @@index([branchId])
  @@index([printerId])
}

// ==========================================
// HỆ THỐNG PHÂN QUYỀN RBAC ENTERPRISE
// ==========================================

enum ScopeType {
  GLOBAL
  BRANCH
  MIXED
}

enum BranchScopeType {
  ALL_BRANCHES
  SELECTED_BRANCHES
}

enum RiskLevel {
  NORMAL
  SENSITIVE
  CRITICAL
}

model AccessRole {
  id          String    @id @default(uuid())
  code        String    @unique @db.VarChar(100)
  name        String    @db.VarChar(200)
  description String?   @db.Text
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  scopeType   ScopeType @default(BRANCH)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions RolePermission[]
  assignments UserRoleAssignment[]
  shifts      Shift[]

  @@index([isSystem])
  @@index([isActive])
}

model Permission {
  key         String    @id @db.VarChar(100)
  groupKey    String    @db.VarChar(100)
  name        String    @db.VarChar(200)
  description String?   @db.Text
  scopeType   ScopeType @default(BRANCH)
  riskLevel   RiskLevel @default(NORMAL)
  sortOrder   Int       @default(0)

  roles RolePermission[]

  @@index([groupKey])
}

model RolePermission {
  id            String @id @default(uuid())
  roleId        String
  permissionKey String

  role       AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@index([permissionKey])
  @@index([roleId])
}

model UserRoleAssignment {
  id          String          @id @default(uuid())
  userId      String
  roleId      String
  branchScope BranchScopeType @default(ALL_BRANCHES)
  isPrimary   Boolean         @default(false)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     AccessRole       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branches UserRoleBranch[]

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model UserRoleBranch {
  id           String @id @default(uuid())
  assignmentId String
  branchId     String

  assignment UserRoleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, branchId])
  @@index([assignmentId])
  @@index([branchId])
}

// ====================================================================
// BUFFET ENGINE & QR ORDER ENGINE MODELS
// ====================================================================

model BuffetPackage {
  id                    String   @id @default(uuid())
  branchId              String
  name                  String
  description           String?  @db.Text
  active                Boolean  @default(true)
  displayOrder          Int      @default(0)
  maxItemsPerSubmission Int?     // Giới hạn tổng số lượng món tối đa cho mỗi lượt gửi xuống bếp (null = không giới hạn)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  branch   Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tickets  BuffetPackageTicket[]
  items    BuffetPackageItem[]
  sessions BuffetSession[]

  @@index([branchId, active])
}

model BuffetPackageTicket {
  id              String   @id @default(uuid())
  buffetPackageId String
  productId       String
  createdAt       DateTime @default(now())

  buffetPackage BuffetPackage @relation(fields: [buffetPackageId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([buffetPackageId, productId])
  @@index([productId])
}

model BuffetPackageItem {
  id                  String   @id @default(uuid())
  buffetPackageId     String
  productId           String
  displayOrder        Int      @default(0)
  maxQuantityPerRound Int?
  maxTotalQuantity    Int?
  availableForQr      Boolean  @default(true)
  allowRetailPurchase Boolean  @default(true)
  createdAt           DateTime @default(now())

  buffetPackage BuffetPackage @relation(fields: [buffetPackageId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([buffetPackageId, productId])
  @@index([productId])
}

model BuffetSession {
  id                  String              @id @default(uuid())
  orderId             String
  buffetPackageId     String
  status              BuffetSessionStatus @default(ACTIVE)
  activatedAt         DateTime            @default(now())
  deactivatedAt       DateTime?
  activatedById       String?
  packageNameSnapshot String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buffetPackage BuffetPackage @relation(fields: [buffetPackageId], references: [id])
  orderItems    OrderItem[]

  @@index([orderId, status])
  @@index([buffetPackageId])
}

model QrOrderSession {
  id             String          @id @default(uuid())
  orderId        String
  tableSessionId String
  branchId       String
  tableId        String
  tokenHash      String          @unique
  status         QrSessionStatus @default(ACTIVE)
  createdAt      DateTime        @default(now())
  expiresAt      DateTime?
  closedAt       DateTime?
  lastActivityAt DateTime?
  createdById    String?

  order           Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tableSession    TableSession          @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  table           RestaurantTable       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  branch          Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  guests          QrOrderGuest[]
  rounds          QrOrderRound[]
  serviceRequests TableServiceRequest[]

  @@index([orderId, status])
  @@index([tableSessionId])
  @@index([branchId, tableId])
}

model QrOrderGuest {
  id               String   @id @default(uuid())
  qrOrderSessionId String
  guestName        String
  userId           String?
  deviceSessionId  String
  memberVerified   Boolean  @default(false)
  joinedAt         DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  status           String   @default("ACTIVE") // ACTIVE, LEFT

  qrOrderSession QrOrderSession @relation(fields: [qrOrderSessionId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  rounds         QrOrderRound[]

  @@index([qrOrderSessionId, status])
  @@index([userId])
  @@index([deviceSessionId])
}

model QrOrderRound {
  id               String    @id @default(uuid())
  qrOrderSessionId String
  qrGuestId        String?
  orderId          String
  roundNumber      Int       @default(1)
  idempotencyKey   String    @unique
  status           String    @default("SUBMITTED")
  submittedAt      DateTime  @default(now())
  approvedById     String?
  approvedByName   String?
  approvedAt       DateTime?
  rejectReason     String?   @db.Text
  itemsSnapshot    Json?
  createdAt        DateTime  @default(now())

  qrOrderSession QrOrderSession @relation(fields: [qrOrderSessionId], references: [id], onDelete: Cascade)
  guest          QrOrderGuest?  @relation(fields: [qrGuestId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]

  @@index([qrOrderSessionId])
  @@index([orderId])
  @@index([qrGuestId])
}

model TableServiceRequest {
  id                String                    @id @default(uuid())
  orderId           String?
  tableId           String
  tableSessionId    String?
  branchId          String
  qrOrderSessionId  String?
  qrGuestId         String?
  requestType       TableServiceRequestType
  paymentMethodCode String?
  status            TableServiceRequestStatus @default(OPEN)
  note              String?                   @db.Text
  acknowledgedAt    DateTime?
  completedAt       DateTime?
  acknowledgedById  String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  order          Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  table          RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  qrOrderSession QrOrderSession? @relation(fields: [qrOrderSessionId], references: [id], onDelete: SetNull)

  @@index([branchId, status])
  @@index([tableId, status])
  @@index([orderId])
}

model DesktopLaunchCode {
  id           String    @id @default(uuid())
  code         String    @unique @db.VarChar(128)
  userId       String
  branchId     String?
  deviceId     String?
  appVersion   String?
  expiresAt    DateTime
  consumedAt   DateTime?
  consumedByIp String?
  createdIp    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model PosDevice {
  id           String    @id @default(uuid())
  deviceId     String    @unique @db.VarChar(128)
  deviceSecret String    @db.VarChar(255)
  name         String?   @db.VarChar(100)
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([deviceId])
}

// ==========================================
// AVORA FARM DOMAIN MODELS & ENUMS
// ==========================================

enum FarmPlotStatus {
  LOCKED
  EMPTY
  PLOWED
  PLANTED
  DRY
  WATERED
  GROWING
  READY
  WITHERED
}

enum FarmCropCategory {
  JAPANESE_INGREDIENT
  FRUIT
  FANTASY_FOOD
}

enum FarmRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

enum FarmMutationType {
  COLOR_MUTATION
  GIANT_MUTATION
  GOLDEN_MUTATION
  CRYSTAL_MUTATION
  SAKURA_MUTATION
  MOONLIGHT_MUTATION
  RAINBOW_MUTATION
  AVORA_MUTATION
}

enum FarmItemType {
  SEED
  CROP
  MUTATION_CROP
  FERTILIZER
  TOOL
  DECORATION
  EVENT
}

enum FarmWeatherType {
  SUNNY
  RAIN
  SAKURA_WIND
  MOONLIGHT
  GOLDEN_HOUR
  AURORA
  FESTIVAL_NIGHT
}

enum FarmMissionType {
  DAILY
  WEEKLY
  ACHIEVEMENT
  EVENT
}

enum FarmRewardCategory {
  VOUCHER
  FOOD_DISCOUNT
  FREE_SHIPPING
  SPECIAL_GIFT
  COSMETIC
}

model UserFarm {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  level                Int      @default(1)
  exp                  Int      @default(0)
  totalExp             Int      @default(0)
  farmCoin             Int      @default(100)
  energy               Int      @default(100)
  maxEnergy            Int      @default(100)
  lastEnergyRecoveryAt DateTime @default(now())

  treeExp            Int    @default(0)
  treeLevel          Int    @default(1)
  selectedTheme      String @default("JAPANESE_GARDEN")
  unlockedPlotsCount Int    @default(6)

  activeWeather    FarmWeatherType @default(SUNNY)
  weatherExpiresAt DateTime?

  dailyWaterCount      Int      @default(0)
  dailyWaterResetAt    DateTime @default(now())
  dailyGatherCount     Int      @default(0)
  dailyGatherResetAt   DateTime @default(now())
  hasCompletedTutorial Boolean  @default(false)
  pendingLevelUp       Boolean  @default(false)

  luckyEnvelopeTickets            Int @default(0)
  totalLuckyEnvelopesOpened       Int @default(0)
  totalLuckyEnvelopeTicketsEarned Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plots           FarmPlot[]
  inventory       FarmInventoryItem[]
  collections     FarmCollection[]
  activityLogs    FarmActivityLog[]
  redemptions     FarmRewardRedemption[]
  userDecorations FarmUserDecoration[]
  transactions    FarmTransaction[]

  preferredTimeMode    FarmGardenDisplayMode @default(ALWAYS) // ALWAYS (Auto theo giờ), DAY_ONLY, NIGHT_ONLY
  lastEquippedTool     String                @default("NONE") // NONE, FAST_PLANT, FAST_WATER, FAST_HARVEST, SHOVEL
  selectedSeedCropCode String?               @default("STRAWBERRY")
  clientSyncVersion    Int                   @default(1) // Chống ghi đè khi mở nhiều tab WebGL

  recipeCraftLogs FarmRecipeCraftLog[]

  @@index([level])
  @@index([farmCoin])
}

model FarmRecipeCraftLog {
  id       String     @id @default(uuid())
  userId   String
  farmId   String
  farm     UserFarm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  recipeId String
  recipe   FarmRecipe @relation(fields: [recipeId], references: [id])

  expAwarded          Int      @default(0)
  farmCoinAwarded     Int      @default(0)
  loyaltyPointAwarded Int      @default(0)
  customerVoucherId   String?
  createdAt           DateTime @default(now())

  @@index([farmId, createdAt])
  @@index([userId, recipeId])
}

model FarmPlot {
  id     String   @id @default(uuid())
  farmId String
  farm   UserFarm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  plotIndex Int // 0..24
  gridRow   Int
  gridCol   Int
  worldX    Float?
  worldY    Float?

  status        FarmPlotStatus @default(LOCKED)
  soilQuality   Float          @default(1.0)
  waterLevel    Float          @default(100.0)
  lastWateredAt DateTime?

  fertilizerItemId String?
  fertilizerBonus  Float   @default(0.0)

  cropInstanceId String?           @unique
  cropInstance   FarmCropInstance? @relation(fields: [cropInstanceId], references: [id], onDelete: SetNull)

  unlockCost  Int @default(0)
  unlockLevel Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, plotIndex])
  @@index([farmId, status])
}

model FarmCrop {
  id             String           @id @default(uuid())
  code           String           @unique
  name           String
  category       FarmCropCategory
  rarity         FarmRarity       @default(COMMON)
  description    String?          @db.Text
  iconUrl        String?
  spriteAtlasKey String?

  growDuration        Int // Tính bằng giây
  seedPrice           Int
  sellPrice           Int
  baseYield           Int @default(4)
  rewardExp           Int @default(20)
  rewardFarmCoin      Int @default(15)
  rewardLoyaltyPoints Int @default(0)

  baseMutationRate Float   @default(0.05)
  minFarmLevel     Int     @default(1)
  isAvailable      Boolean @default(true)
  isEventOnly      Boolean @default(false)
  eventId          String?
  sortOrder        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mutations         FarmCropMutation[]
  instances         FarmCropInstance[]
  collections       FarmCollection[]
  recipeIngredients FarmRecipeIngredient[]

  @@index([category])
  @@index([rarity])
  @@index([minFarmLevel])
}

model FarmCropMutation {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  sourceCropId String
  sourceCrop   FarmCrop @relation(fields: [sourceCropId], references: [id], onDelete: Cascade)

  mutationType   FarmMutationType
  rarity         FarmRarity       @default(RARE)
  description    String?          @db.Text
  spriteKey      String?
  colorHex       String?
  glowEffect     String?
  particleEffect String?
  soundEffect    String?

  mutationChance      Float // Tỷ lệ tương đối
  yieldMultiplier     Float   @default(1.5)
  rewardExp           Int     @default(60)
  rewardFarmCoin      Int     @default(50)
  rewardLoyaltyPoints Int     @default(1)
  sellPrice           Int?
  collectionScore     Int     @default(100)
  isEventOnly         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instances   FarmCropInstance[]
  collections FarmCollection[]

  @@index([sourceCropId])
  @@index([rarity])
}

model FarmCropInstance {
  id         String            @id @default(uuid())
  cropId     String
  crop       FarmCrop          @relation(fields: [cropId], references: [id])
  mutationId String?
  mutation   FarmCropMutation? @relation(fields: [mutationId], references: [id])

  plot FarmPlot?

  plantedAt   DateTime  @default(now())
  stage1At    DateTime
  stage2At    DateTime
  stage3At    DateTime
  readyAt     DateTime
  harvestedAt DateTime?

  isMutated Boolean @default(false)

  cropNameSnapshot       String
  growDurationSnapshot   Int
  baseYieldSnapshot      Int
  mutationRateSnapshot   Float
  rewardExpSnapshot      Int
  rewardFarmCoinSnapshot Int

  calculatedYield  Int?
  gatheredCount    Int  @default(0)
  maxGatherAllowed Int  @default(1)
  wateredCount     Int  @default(0)
  fertilizedCount  Int  @default(0)
  version          Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cropId])
  @@index([readyAt])
  @@index([harvestedAt])
}

model FarmInventoryItem {
  id     String   @id @default(uuid())
  farmId String
  farm   UserFarm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  itemType    FarmItemType
  referenceId String
  itemName    String
  itemCode    String
  rarity      FarmRarity   @default(COMMON)
  quantity    Int          @default(0)
  isLocked    Boolean      @default(false)
  isSeen      Boolean      @default(false)
  seenAt      DateTime?
  metadata    Json?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, itemType, referenceId])
  @@index([farmId, itemType])
  @@index([farmId, isSeen])
}

model FarmCollection {
  id     String   @id @default(uuid())
  farmId String
  farm   UserFarm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  cropId     String
  crop       FarmCrop          @relation(fields: [cropId], references: [id])
  mutationId String?
  mutation   FarmCropMutation? @relation(fields: [mutationId], references: [id])

  isUnlocked        Boolean  @default(true)
  firstDiscoveredAt DateTime @default(now())
  harvestCount      Int      @default(1)
  highestYield      Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([farmId, cropId, mutationId])
  @@index([farmId])
}

model FarmMission {
  id          String          @id @default(uuid())
  code        String          @unique
  title       String
  description String?         @db.Text
  type        FarmMissionType
  actionType  String // PLANT, WATER, HARVEST, DISCOVER_MUTATION, HELP_FRIEND, ORDER_COMPLETED
  targetCount Int

  rewardExp           Int           @default(50)
  rewardFarmCoin      Int           @default(30)
  rewardLoyaltyPoints Int           @default(0)
  rewardItemId        String?
  rewardItemType      FarmItemType?
  rewardItemQty       Int           @default(0)

  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress FarmMissionProgress[]
}

model FarmMissionProgress {
  id        String      @id @default(uuid())
  userId    String
  missionId String
  mission   FarmMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  currentCount Int       @default(0)
  isCompleted  Boolean   @default(false)
  isClaimed    Boolean   @default(false)
  periodKey    String // "2026-09-13" (Daily), "2026-W37" (Weekly), "LIFETIME" (Achievement)
  completedAt  DateTime?
  claimedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, missionId, periodKey])
  @@index([userId, isClaimed])
}

model FarmReward {
  id          String             @id @default(uuid())
  code        String             @unique
  title       String
  description String?            @db.Text
  imageUrl    String?
  category    FarmRewardCategory

  voucherId String?
  voucher   Voucher? @relation(fields: [voucherId], references: [id])

  costFarmCoin      Int     @default(0)
  costLoyaltyPoints Int     @default(0)
  stock             Int?
  redeemedCount     Int     @default(0)
  limitPerUser      Int     @default(1)
  minFarmLevel      Int     @default(1)
  requiredTierId    String?

  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions FarmRewardRedemption[]

  @@index([category])
  @@index([isActive])
}

model FarmRewardRedemption {
  id       String     @id @default(uuid())
  userId   String
  farmId   String
  farm     UserFarm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  rewardId String
  reward   FarmReward @relation(fields: [rewardId], references: [id])

  farmCoinSpent      Int     @default(0)
  loyaltyPointsSpent Int     @default(0)
  voucherCodeIssued  String?
  customerVoucherId  String?
  pointTxId          String?
  status             String  @default("COMPLETED")

  createdAt DateTime @default(now())

  @@index([userId, rewardId])
  @@index([createdAt])
}

model FarmFriendAction {
  id           String   @id @default(uuid())
  actorUserId  String
  actorUser    User     @relation("FarmFriendActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  targetFarmId String
  plotIndex    Int
  actionType   String // WATER, GATHER
  yieldTaken   Int      @default(0)
  isFriend     Boolean  @default(false)
  actionDate   DateTime @db.Date
  createdAt    DateTime @default(now())

  @@index([actorUserId, actionDate])
  @@index([targetFarmId, actionDate])
}

model FarmFriendship {
  id        String   @id @default(uuid())
  userId    String
  friendId  String
  status    String   @default("ACCEPTED") // PENDING, ACCEPTED
  createdAt DateTime @default(now())

  user   User @relation("UserFarmFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendFarmUsers", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

model FarmActivityLog {
  id        String   @id @default(uuid())
  userId    String
  farmId    String
  farm      UserFarm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  action    String // PLANT, WATER, FERTILIZE, HARVEST, MUTATION, PURCHASE, REDEEM, FRIEND_HELP, FRIEND_GATHER
  plotIndex Int?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, action, createdAt])
  @@index([farmId, createdAt])
}

model FarmDecoration {
  id            String  @id @default(uuid())
  code          String  @unique
  name          String
  category      String // FENCE, LANTERN, SAKURA, BENCH, STATUE, KOI_POND, PATH
  iconUrl       String?
  spriteKey     String
  priceFarmCoin Int     @default(100)
  buffType      String? // GROWTH_SPEED, MUTATION_CHANCE, TREE_XP
  buffValue     Float   @default(0.0)
  unlockLevel   Int     @default(1)
  isAvailable   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FarmUserDecoration {
  id     String   @id @default(uuid())
  farmId String
  farm   UserFarm @relation(fields: [farmId], references: [id], onDelete: Cascade)

