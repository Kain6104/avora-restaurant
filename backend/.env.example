# Database connection string (MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/avora_db"

# Server Port
PORT=4001

# Frontend Origin URL
FRONTEND_URL="http://localhost:4000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4001/api/auth/google/callback"

# Google Gemini API Key for Chatbot
GEMINI_API_KEY="your-gemini-api-key"

# SMTP Mail Settings
SMTP_USER="your-email@example.com"
SMTP_PASS="your-smtp-password"

# Security & Token Secrets
JWT_SECRET="your-jwt-secret"
QR_ORDER_TOKEN_SECRET="your-qr-order-token-secret"
POS_PIN_LOOKUP_SECRET="your-pos-pin-lookup-secret"
CHATBOT_GUEST_SESSION_SECRET="your-chatbot-guest-session-secret"

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY="replace_with_vapid_public_key"
VAPID_PRIVATE_KEY="replace_with_vapid_private_key"
VAPID_SUBJECT="mailto:admin@example.com"

# Maps & Geocoding
OPENMAP_API_KEY="your-openmap-api-key"
