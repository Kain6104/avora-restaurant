<UserControl x:Class="AvoraPosNative.Views.TableMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="#F8FAFC">
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- Area & Status Metrics Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Table grid -->
            <RowDefinition Height="*"/>
            <!-- Bottom action toolbar for selected table -->
            <RowDefinition Height="68"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: Area Filters & Realtime Summary (LIGHT THEME) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Quick Status Metrics -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Total -->
                        <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Tổng: " Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalTablesCount}" Foreground="#0F172A" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Vacant -->
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Trống: " Foreground="#065F46" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding VacantCount}" Foreground="#065F46" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Occupied -->
                        <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#F59E0B" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Đang dùng: " Foreground="#92400E" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding OccupiedCount}" Foreground="#92400E" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Bill Printed -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#3B82F6" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="In tạm tính: " Foreground="#1E40AF" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BillPrintedCount}" Foreground="#1E40AF" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Reserved -->
                        <Border Background="#FAF5FF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#8B5CF6" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Đặt trước: " Foreground="#5B21B6" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ReservedCount}" Foreground="#5B21B6" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Refresh Button -->
                    <Button Grid.Column="1" Command="{Binding RefreshCommand}"
                            Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1"
                            Padding="12,6" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔄" Margin="0,0,6,0" FontSize="12"/>
                                        <TextBlock Text="Làm mới bàn" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Row 1: Area Filter Chips -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Areas}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" 
                                        Command="{Binding DataContext.SelectAreaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,8,0" Padding="14,7"
                                        FontSize="13" FontWeight="SemiBold"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                            <Setter Property="Foreground" Value="#334155"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E2E8F0"/>
                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- TABLE GRID CARDS -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
            <ItemsControl ItemsSource="{Binding FilteredTables}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="184" Height="150" Margin="8" CornerRadius="12" Padding="14"
                                BorderThickness="2" Cursor="Hand" MouseLeftButtonUp="OnTableCardClick">
                            <!-- Background & Border based on table status (Light Theme) -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="VACANT">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#10B981"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="OCCUPIED">
                                            <Setter Property="Background" Value="#FFFDF5"/>
                                            <Setter Property="BorderBrush" Value="#F59E0B"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="BILL_PRINTED">
                                            <Setter Property="Background" Value="#F8FAFF"/>
                                            <Setter Property="BorderBrush" Value="#3B82F6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="RESERVED">
                                            <Setter Property="Background" Value="#FCFAFF"/>
                                            <Setter Property="BorderBrush" Value="#8B5CF6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header: Table Name & Capacity -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="Black" FontSize="16" Foreground="#0F172A"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="👥" FontSize="11" Margin="0,0,3,0"/>
                                        <TextBlock Text="{Binding Capacity}" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Middle: Status Pill & Elapsed Time -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,0">
                                    <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="VACANT">
                                                        <Setter Property="Background" Value="#ECFDF5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="OCCUPIED">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="BILL_PRINTED">
                                                        <Setter Property="Background" Value="#DBEAFE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="RESERVED">
                                                        <Setter Property="Background" Value="#F3E8FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="VACANT">
                                                            <Setter Property="Foreground" Value="#047857"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="OCCUPIED">
                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="BILL_PRINTED">
                                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="RESERVED">
                                                            <Setter Property="Foreground" Value="#7E22CE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Area name / Elapsed Time -->
                                    <TextBlock Text="{Binding AreaName}" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Bottom: Subtotal / Elapsed time -->
                                <Grid Grid.Row="2">
                                    <TextBlock Text="{Binding ElapsedTimeText}" FontSize="11" FontWeight="SemiBold" Foreground="#B45309" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentTotalText}" FontWeight="Black" FontSize="14" Foreground="#E11D48" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- BOTTOM ACTION TOOLBAR -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Selected table indicator -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Bàn đang chọn:" Foreground="#64748B" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="10,0,0,0">
                        <TextBlock Text="{Binding SelectedTable.Name, FallbackValue='(Chưa chọn bàn)'}" 
                                   FontWeight="Black" Foreground="#0F172A" FontSize="14" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Operational Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Đổi bàn -->
                    <Button Content="🔄 Đổi bàn" Command="{Binding MoveTableCommand}"
                            Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                            Padding="14,10" Margin="0,0,8,0" FontWeight="Bold" FontSize="13" Cursor="Hand"/>

                    <!-- Gộp bàn -->
                    <Button Content="➕ Gộp bàn" Command="{Binding MergeTableCommand}"
                            Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                            Padding="14,10" Margin="0,0,8,0" FontWeight="Bold" FontSize="13" Cursor="Hand"/>

                    <!-- Tách bàn -->
                    <Button Content="✂️ Tách bàn" Command="{Binding SplitTableCommand}"
                            Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                            Padding="14,10" Margin="0,0,8,0" FontWeight="Bold" FontSize="13" Cursor="Hand"/>

                    <!-- Mở bàn / Vào gọi món -->
                    <Button Content="⚡ Mở bàn / Gọi món" Command="{Binding OpenTableOrderCommand}"
                            Background="#0F172A" Foreground="#FFFFFF" BorderThickness="0"
                            Padding="22,10" FontWeight="Black" FontSize="14" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
