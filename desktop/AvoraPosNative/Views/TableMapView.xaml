<UserControl x:Class="AvoraPosNative.Views.TableMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="760" d:DesignWidth="1366"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             Background="#F8FAFC">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Horizontal Combined Area & Status Bar (/admin/pos TableMap.tsx parity) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Full-Width Dense Table Cards Grid (*) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- 1. TOP HORIZONTAL AREA & STATUS BAR (Bright White & Red AVORA Theme)      -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1.5" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Area Tabs + Vertical Divider + Status Quick Filters -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Area Tabs Pill Container -->
                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,0,10,0">
                        <ItemsControl ItemsSource="{Binding Areas}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectAreaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}"
                                            Cursor="Hand" Margin="2,0" BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="areaBorder" Background="Transparent" CornerRadius="7" Padding="12,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="areaPin" Text="📍" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="areaText" Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="areaBorder" Property="Background" Value="#FFFFFF"/>
                                                        <Setter TargetName="areaText" Property="Foreground" Value="#DA251D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Vertical Divider -->
                    <Border Width="1" Height="26" Background="#E2E8F0" Margin="2,0,12,0" VerticalAlignment="Center"/>

                    <!-- Status Quick Filters -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Tất cả -->
                        <Button Command="{Binding SetStatusFilterCommand}" CommandParameter="ALL" Cursor="Hand" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusFilter}" Value="ALL">
                                            <Setter Property="Background" Value="#0F172A"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#0F172A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11,6">
                                        <TextBlock Text="{Binding TotalTablesCount, StringFormat='Tất cả ({0})'}" FontSize="12" FontWeight="Bold" Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Bàn trống -->
                        <Button Command="{Binding SetStatusFilterCommand}" CommandParameter="VACANT" Cursor="Hand" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#ECFDF5"/>
                                    <Setter Property="Foreground" Value="#047857"/>
                                    <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusFilter}" Value="VACANT">
                                            <Setter Property="Background" Value="#059669"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#059669"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11,6">
                                        <TextBlock Text="{Binding VacantCount, StringFormat='Bàn trống ({0})'}" FontSize="12" FontWeight="Bold" Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Có khách -->
                        <Button Command="{Binding SetStatusFilterCommand}" CommandParameter="OCCUPIED" Cursor="Hand" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#FEF2F2"/>
                                    <Setter Property="Foreground" Value="#DA251D"/>
                                    <Setter Property="BorderBrush" Value="#FECDD3"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusFilter}" Value="OCCUPIED">
                                            <Setter Property="Background" Value="#DA251D"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#DA251D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11,6">
                                        <TextBlock Text="{Binding OccupiedCount, StringFormat='Có khách ({0})'}" FontSize="12" FontWeight="Bold" Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Chờ TT -->
                        <Button Command="{Binding SetStatusFilterCommand}" CommandParameter="BILL_PRINTED" Cursor="Hand" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#FFFBEB"/>
                                    <Setter Property="Foreground" Value="#B45309"/>
                                    <Setter Property="BorderBrush" Value="#FDE68A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusFilter}" Value="BILL_PRINTED">
                                            <Setter Property="Background" Value="#D97706"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#D97706"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11,6">
                                        <TextBlock Text="{Binding BillPrintedCount, StringFormat='Chờ TT ({0})'}" FontSize="12" FontWeight="Bold" Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Đặt trước -->
                        <Button Command="{Binding SetStatusFilterCommand}" CommandParameter="RESERVED" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#F0F9FF"/>
                                    <Setter Property="Foreground" Value="#0369A1"/>
                                    <Setter Property="BorderBrush" Value="#BAE6FD"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusFilter}" Value="RESERVED">
                                            <Setter Property="Background" Value="#0284C7"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#0284C7"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11,6">
                                        <TextBlock Text="{Binding ReservedCount, StringFormat='Đặt trước ({0})'}" FontSize="12" FontWeight="Bold" Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </WrapPanel>

                <!-- Right: Search Input + Scroll Up/Down + Refresh -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Box -->
                    <Border Width="210" Height="34" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,0" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"
                                     VerticalContentAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Touch Scroll Up/Down Buttons -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Click="OnScrollUpClick" Width="30" Height="28" Cursor="Hand" ToolTip="Cuộn lên" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="▲" FontSize="11" FontWeight="Black" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Border Width="1" Height="18" Background="#E2E8F0" Margin="1,0"/>
                            <Button Click="OnScrollDownClick" Width="30" Height="28" Cursor="Hand" ToolTip="Cuộn xuống" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="▼" FontSize="11" FontWeight="Black" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Refresh Button -->
                    <Button Command="{Binding RefreshCommand}" Width="34" Height="34" Cursor="Hand" ToolTip="Làm mới sơ đồ bàn">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                    <TextBlock Text="🔄" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- 2. FULL-WIDTH DENSE COMPACT TABLE CARDS GRID (1-Click Opens Order!)       -->
        <!-- ========================================================================= -->
        <ScrollViewer x:Name="TablesScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14">
            <ItemsControl ItemsSource="{Binding FilteredTables}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="148" Height="104" Margin="6" CornerRadius="12" Cursor="Hand"
                                MouseLeftButtonUp="OnTableCardClick"
                                ToolTip="Nhấn vào bàn để mở đơn / gọi món ngay lập tức">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="BorderThickness" Value="1.5"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#DA251D"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding VisualStatus}" Value="OCCUPIED">
                                            <Setter Property="Background" Value="#FFF1F2"/>
                                            <Setter Property="BorderBrush" Value="#DA251D"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding VisualStatus}" Value="BILL_PRINTED">
                                            <Setter Property="Background" Value="#FFFBEB"/>
                                            <Setter Property="BorderBrush" Value="#F59E0B"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding VisualStatus}" Value="RESERVED">
                                            <Setter Property="Background" Value="#F0F9FF"/>
                                            <Setter Property="BorderBrush" Value="#0284C7"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid Margin="10,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Table Name / Number -->
                                <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="14.5" FontWeight="Black" Foreground="#0F172A"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <!-- Row 1: Divider Line -->
                                <Border Grid.Row="1" Height="1" Margin="8,7" Background="#E2E8F0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E2E8F0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VisualStatus}" Value="OCCUPIED">
                                                    <Setter Property="Background" Value="#FECDD3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Row 2: Status / Active Order Total & Elapsed Time -->
                                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- Total Amount when Occupied/Bill Printed -->
                                    <TextBlock Text="{Binding CurrentTotalText}" FontSize="13.5" FontWeight="Black" Foreground="#DA251D" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentTotalText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Status Label when Vacant or no total yet -->
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentTotalText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding VisualStatus}" Value="OCCUPIED">
                                                        <Setter Property="Foreground" Value="#DA251D"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding VisualStatus}" Value="BILL_PRINTED">
                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding VisualStatus}" Value="RESERVED">
                                                        <Setter Property="Foreground" Value="#0284C7"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Elapsed Time when Occupied -->
                                    <TextBlock Text="{Binding ElapsedTimeText, StringFormat='🕒 {0}'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElapsedTimeText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
