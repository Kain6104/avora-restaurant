<UserControl x:Class="AvoraPosNative.Views.PosSettingsDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:AvoraPosNative.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1366"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             Background="#F8FAFC">

    <Grid Background="#F8FAFC">
        <Grid.ColumnDefinitions>
            <!-- Left Full-Height Navigation Sidebar (260px) -->
            <ColumnDefinition Width="260"/>
            <!-- Right Full-Screen Content Workspace (*) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================================================= -->
        <!-- 1. LEFT FULL-HEIGHT NAVIGATION SIDEBAR (BRIGHT WHITE & AVORA RED)         -->
        <!-- ========================================================================= -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,14,10,14">
                        <!-- Group 1: QUẢN LÝ BÁN HÀNG -->
                        <StackPanel Orientation="Horizontal" Margin="12,4,12,8">
                            <TextBlock Text="🍽️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="QUẢN LÝ BÁN HÀNG" FontSize="11" FontWeight="Black" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Click="OnQuickNavClicked" Tag="TABLES" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Margin="0,0,0,2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="14,10">
                                        <TextBlock x:Name="Txt" Text="🪑 Sơ đồ phòng bàn" FontSize="13.5" FontWeight="Bold" Foreground="#334155"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFF1F2"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="#DA251D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="OnQuickNavClicked" Tag="ORDERS" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Margin="0,0,0,2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="14,10">
                                        <TextBlock x:Name="Txt" Text="🧾 Danh sách đơn hàng" FontSize="13.5" FontWeight="Bold" Foreground="#334155"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFF1F2"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="#DA251D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="OnQuickNavClicked" Tag="RESERVATIONS" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Margin="0,0,0,2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="14,10">
                                        <TextBlock x:Name="Txt" Text="📅 Lịch đặt bàn trước" FontSize="13.5" FontWeight="Bold" Foreground="#334155"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFF1F2"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="#DA251D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border Height="1" Background="#F1F5F9" Margin="8,10"/>

                        <!-- Group 2: QUẢN LÝ CHUNG & THIẾT BỊ -->
                        <StackPanel Orientation="Horizontal" Margin="12,4,12,8">
                            <TextBlock Text="⚙️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="CÀI ĐẶT &amp; THIẾT BỊ" FontSize="11" FontWeight="Black" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Item 1: Cài đặt máy in (PRINTERS) -->
                        <Button x:Name="BtnTabPrinters" Click="OnTabSelected" Tag="PRINTERS" Cursor="Hand" BorderThickness="0" HorizontalContentAlignment="Stretch" Margin="0,0,0,4"
                                Background="#DA251D" Foreground="#FFFFFF">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,11">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🖨️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Cài đặt máy in" FontSize="13.5" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Item 2: Ca bán hàng & Két tiền (SHIFT) -->
                        <Button x:Name="BtnTabShift" Click="OnTabSelected" Tag="SHIFT" Cursor="Hand" BorderThickness="0" HorizontalContentAlignment="Stretch" Margin="0,0,0,4"
                                Background="Transparent" Foreground="#334155">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,11">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💵" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ca bán hàng &amp; Két tiền" FontSize="13.5" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Item 3: Màn hình Bếp KDS (KITCHEN) -->
                        <Button x:Name="BtnTabKitchen" Click="OnTabSelected" Tag="KITCHEN" Cursor="Hand" BorderThickness="0" HorizontalContentAlignment="Stretch" Margin="0,0,0,4"
                                Background="Transparent" Foreground="#334155">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,11">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🍳" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Màn hình Bếp (KDS)" FontSize="13.5" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Item 4: Đồng bộ dữ liệu (SYNC) -->
                        <Button x:Name="BtnTabSync" Click="OnTabSelected" Tag="SYNC" Cursor="Hand" BorderThickness="0" HorizontalContentAlignment="Stretch" Margin="0,0,0,4"
                                Background="Transparent" Foreground="#334155">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,11">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔄" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Đồng bộ dữ liệu" FontSize="13.5" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Item 5: Mở két tiền nhanh -->
                        <Button Command="{Binding OpenCashDrawerQuickCommand}" Cursor="Hand" BorderThickness="0" HorizontalContentAlignment="Stretch" Margin="0,0,0,4"
                                Background="Transparent" Foreground="#334155">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="14,11">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔓" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="Txt" Text="Mở két tiền nhanh" FontSize="13.5" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFF1F2"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="#DA251D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Item 6: Thiết lập chung (GENERAL) -->
                        <Button x:Name="BtnTabGeneral" Click="OnTabSelected" Tag="GENERAL" Cursor="Hand" BorderThickness="0" HorizontalContentAlignment="Stretch" Margin="0,0,0,4"
                                Background="Transparent" Foreground="#334155">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,11">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🖥️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Thiết lập chung" FontSize="13.5" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom: Prominent Logout Button -->
                <Border Grid.Row="1" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="12">
                    <Button Command="{Binding LogoutCommand}" Cursor="Hand" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="10" Padding="14,11">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="⏻" FontSize="15" FontWeight="Black" Foreground="#DA251D" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Đăng xuất phiên thu ngân" FontSize="13.5" FontWeight="Black" Foreground="#DA251D" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FFE4E6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- 2. RIGHT FULL-SCREEN WORKSPACE CONTENT (*)                                -->
        <!-- ========================================================================= -->
        <Grid Grid.Column="1" Background="#F8FAFC">
            <!-- Panel 1: Printer & Hardware Settings (Full Screen) -->
            <Grid x:Name="PanelPrinters" Visibility="Visible">
                <views:SettingsView/>
            </Grid>

            <!-- Panel 2: Cash Shift & Drawer Management -->
            <Grid x:Name="PanelShift" Visibility="Collapsed">
                <views:CashShiftView DataContext="{Binding CashShiftVm}"/>
            </Grid>

            <!-- Panel 3: Kitchen Display System (KDS) -->
            <Grid x:Name="PanelKitchen" Visibility="Collapsed">
                <views:KitchenView DataContext="{Binding KitchenVm}"/>
            </Grid>

            <!-- Panel 4: Offline Sync & Outbox Engine -->
            <ScrollViewer x:Name="PanelSync" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel MaxWidth="920" HorizontalAlignment="Left">
                    <TextBlock Text="ĐỒNG BỘ DỮ LIỆU &amp; TRANSACTIONAL OUTBOX" FontWeight="Black" FontSize="18" Foreground="#0F172A" Margin="0,0,0,6"/>
                    <TextBlock Text="Quản lý hàng đợi đồng bộ đơn hàng Offline-First giữa máy thu ngân và máy chủ Production." FontSize="13" Foreground="#64748B" Margin="0,0,0,20"/>

                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Trạng thái kết nối" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding NetworkStatusText}" FontSize="20" FontWeight="Black" Foreground="{Binding NetworkStatusColor}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Đơn chờ đồng bộ (Outbox)" FontSize="12" Foreground="#92400E" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding PendingSyncCount}" FontSize="20" FontWeight="Black" Foreground="#B45309" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Đã đồng bộ thành công" FontSize="12" Foreground="#065F46" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SyncedCount}" FontSize="20" FontWeight="Black" Foreground="#059669" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Xung đột / Lỗi" FontSize="12" Foreground="#991B1B" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ConflictCount}" FontSize="20" FontWeight="Black" Foreground="#DA251D" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Button Command="{Binding TriggerSyncCommand}" HorizontalAlignment="Left" Cursor="Hand" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#DA251D" CornerRadius="10" Padding="24,14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🚀" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="ĐỒNG BỘ DỮ LIỆU NGAY LẬP TỨC" FontSize="13.5" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Panel 5: General System Info -->
            <ScrollViewer x:Name="PanelGeneral" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel MaxWidth="920" HorizontalAlignment="Left">
                    <TextBlock Text="THIẾT LẬP CHUNG HỆ THỐNG AVORA POS NATIVE" FontWeight="Black" FontSize="18" Foreground="#0F172A" Margin="0,0,0,6"/>
                    <TextBlock Text="Thông tin chi nhánh, tài khoản thu ngân hiện tại và cấu hình kết nối máy chủ." FontSize="13" Foreground="#64748B" Margin="0,0,0,20"/>

                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24">
                        <StackPanel>
                            <Grid Margin="0,6">
                                <TextBlock Text="Chi nhánh đang hoạt động:" FontSize="13.5" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BranchName}" FontSize="14" FontWeight="Black" Foreground="#0F172A" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="#F1F5F9" Margin="0,8"/>
                            <Grid Margin="0,6">
                                <TextBlock Text="Nhân viên đăng nhập:" FontSize="13.5" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CashierName}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="#F1F5F9" Margin="0,8"/>
                            <Grid Margin="0,6">
                                <TextBlock Text="Vai trò (Role RBAC):" FontSize="13.5" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CashierRoleDisplay}" FontSize="14" FontWeight="Bold" Foreground="#DA251D" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="#F1F5F9" Margin="0,8"/>
                            <Grid Margin="0,6">
                                <TextBlock Text="Máy chủ Production:" FontSize="13.5" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="https://avorafnb.com" FontSize="13.5" FontFamily="Consolas" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
