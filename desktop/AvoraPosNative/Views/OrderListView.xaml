<UserControl x:Class="AvoraPosNative.Views.OrderListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="760" d:DesignWidth="1366"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             Background="#233245">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- LEFT AREA: 2D Grid of Order Cards on Deep Navy Background (*) -->
            <ColumnDefinition Width="*"/>
            <!-- RIGHT AREA: Modern Sapo-Style Control Panel (290px) -->
            <ColumnDefinition Width="290"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================================================= -->
        <!-- 1. LEFT: ORDER CARDS 2D WRAP GRID                                          -->
        <!-- ========================================================================= -->
        <Grid Grid.Column="0" Background="#233245">
            <!-- Empty state when no orders match -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredOrders.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="84" Height="84" CornerRadius="42" Background="#2C3D52" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="📋" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Chưa có đơn hàng nào phù hợp" FontSize="18" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock Text="Nhấn '+ Tạo đơn mới' ở góc phải hoặc đổi bộ lọc bên cạnh để xem đơn" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Cards Scroll Viewer -->
            <ScrollViewer x:Name="OrdersScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14">
                <ItemsControl ItemsSource="{Binding FilteredOrders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- ORDER CARD CONTAINER (Crisp White Card on Navy Canvas) -->
                            <Border Width="190" Height="152" Margin="8" Background="#FFFFFF"
                                    BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"
                                    Cursor="Hand" MouseLeftButtonUp="OnOrderCardClick">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.18"/>
                                </Border.Effect>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#DA251D"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <!-- Header Ribbon -->
                                        <RowDefinition Height="34"/>
                                        <!-- Card Body (Large Title + Elapsed Time + Price) -->
                                        <RowDefinition Height="*"/>
                                        <!-- Footer Actions (••• / Thanh toán) -->
                                        <RowDefinition Height="36"/>
                                    </Grid.RowDefinitions>

                                    <!-- 0. Header Ribbon with Dynamic Color -->
                                    <Border Grid.Row="0" Background="{Binding CardHeaderBg}" CornerRadius="9,9,0,0" Padding="10,0">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Icon + Type Name -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CardHeaderIcon}" FontSize="12" Foreground="#FFFFFF" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CardHeaderType}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Right: Guest Count (if dine-in) -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="👤 " FontSize="10.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding GuestCount, FallbackValue='1'}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 1. Card Body -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,2">
                                        <!-- Big Table Number or Order Code -->
                                        <TextBlock Text="{Binding CardTitle}" FontSize="24" FontWeight="Black"
                                                   Foreground="#0F172A" HorizontalAlignment="Center"/>

                                        <!-- Subtitle: Stopwatch Elapsed Time + Price -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                            <TextBlock Text="⏱" FontSize="11" Foreground="#64748B" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ElapsedTimeText}" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="💰" FontSize="11" Foreground="#0F172A" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0}đ}" FontSize="11.5" FontWeight="Black" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 2. Footer Action Bar -->
                                    <Border Grid.Row="2" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Background="#F8FAFC" CornerRadius="0,0,9,9" Padding="8,0">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Actions More Button [ ••• ] -->
                                            <Button Grid.Column="0" Content="•••" Width="36" Height="24"
                                                    Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                                    Foreground="#475569" FontWeight="Black" FontSize="11" Cursor="Hand"
                                                    Command="{Binding DataContext.PrintTempBillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Right: Thanh toán Button -->
                                            <Button Grid.Column="2" Content="Thanh toán"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="#2563EB" FontWeight="Black" FontSize="12.5" Cursor="Hand"
                                                    Command="{Binding DataContext.PayOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" Padding="4,2">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 2. RIGHT SIDEBAR: SAPO-STYLE CONTROL PANEL (#1B2735 DEEP NAVY THEME)      -->
        <!-- ========================================================================= -->
        <Border Grid.Column="1" Background="#1B2735" BorderBrush="#0F172A" BorderThickness="1,0,0,0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 0. Big Green [+ Tạo đơn mới] Button -->
                    <RowDefinition Height="Auto"/>
                    <!-- 1. Tất cả đơn Card -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2. Status Row: Chờ thanh toán | Chờ xác nhận -->
                    <RowDefinition Height="Auto"/>
                    <!-- 3. 2x2 Order Type Grid: Tại bàn | Mang đi | Giao hàng | Đối tác -->
                    <RowDefinition Height="Auto"/>
                    <!-- 4. Search & Checkbox Filters -->
                    <RowDefinition Height="*"/>
                    <!-- 5. Bottom Scroll Buttons: [ ▲ ] [ ▼ ] -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 0. BIG GREEN BUTTON: [+ Tạo đơn mới] -->
                <Button Grid.Row="0" Command="{Binding CreateNewOrderCommand}"
                        Background="#00B14F" Foreground="#FFFFFF" FontWeight="Black" FontSize="14"
                        Height="46" Cursor="Hand" Margin="0,0,0,10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="#FFFFFF" Margin="0,0,8,0">
                                        <TextBlock Text="+" FontSize="14" FontWeight="Black" Foreground="#00B14F" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                    </Border>
                                    <TextBlock Text="Tạo đơn mới" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 1. TẤT CẢ ĐƠN CARD -->
                <Button Grid.Row="1" Height="42" Margin="0,0,0,8" Cursor="Hand"
                        Command="{Binding SetTypeFilterCommand}" CommandParameter="ALL">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#293B50"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TypeFilter}" Value="ALL">
                                    <Setter Property="Background" Value="#2563EB"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,0">
                                <Grid VerticalAlignment="Center">
                                    <TextBlock Text="Tất cả đơn" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding DataContext.AllCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               FontSize="12" FontWeight="Black" Foreground="#E2E8F0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 2. STATUS ROW: Chờ thanh toán | Chờ xác nhận -->
                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Chờ thanh toán -->
                    <Button Grid.Column="0" Height="44" Cursor="Hand"
                            Command="{Binding SetStatusFilterCommand}" CommandParameter="PAYMENT_REQUESTED">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#293B50"/>
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusFilter}" Value="PAYMENT_REQUESTED">
                                        <Setter Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,4">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DataContext.PaymentRequestedCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   FontSize="12" FontWeight="Black" HorizontalAlignment="Right" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Chờ thanh toán" FontSize="11" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Chờ xác nhận -->
                    <Button Grid.Column="2" Height="44" Cursor="Hand"
                            Command="{Binding SetStatusFilterCommand}" CommandParameter="WAITING_CONFIRM">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#293B50"/>
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusFilter}" Value="WAITING_CONFIRM">
                                        <Setter Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,4">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DataContext.WaitingConfirmCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   FontSize="12" FontWeight="Black" HorizontalAlignment="Right" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Chờ xác nhận" FontSize="11" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- 3. 2x2 ORDER TYPE GRID: Tại bàn | Mang đi | Giao hàng | Đối tác -->
                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0, Col 0: Tại bàn (Blue) -->
                    <Button Grid.Row="0" Grid.Column="0" Cursor="Hand"
                            Command="{Binding SetTypeFilterCommand}" CommandParameter="DINE_IN">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#293B50"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TypeFilter}" Value="DINE_IN">
                                        <Setter Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,4">
                                    <Grid>
                                        <TextBlock Text="{Binding DataContext.DineInCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="🍽 Tại bàn" FontSize="12" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Row 0, Col 2: Mang đi (Orange) -->
                    <Button Grid.Row="0" Grid.Column="2" Cursor="Hand"
                            Command="{Binding SetTypeFilterCommand}" CommandParameter="TAKEAWAY">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#293B50"/>
                                <Setter Property="Foreground" Value="#FB923C"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TypeFilter}" Value="TAKEAWAY">
                                        <Setter Property="Background" Value="#EA580C"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,4">
                                    <Grid>
                                        <TextBlock Text="{Binding DataContext.TakeawayCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="🛍 Mang đi" FontSize="12" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Row 2, Col 0: Giao hàng (Purple) -->
                    <Button Grid.Row="2" Grid.Column="0" Cursor="Hand"
                            Command="{Binding SetTypeFilterCommand}" CommandParameter="DELIVERY">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#293B50"/>
                                <Setter Property="Foreground" Value="#C084FC"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TypeFilter}" Value="DELIVERY">
                                        <Setter Property="Background" Value="#9333EA"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,4">
                                    <Grid>
                                        <TextBlock Text="{Binding DataContext.DeliveryCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="🚚 Giao hàng" FontSize="12" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Row 2, Col 2: Đối tác (Green) -->
                    <Button Grid.Row="2" Grid.Column="2" Cursor="Hand"
                            Command="{Binding SetTypeFilterCommand}" CommandParameter="ONLINE">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#293B50"/>
                                <Setter Property="Foreground" Value="#4ADE80"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TypeFilter}" Value="ONLINE">
                                        <Setter Property="Background" Value="#16A34A"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,4">
                                    <Grid>
                                        <TextBlock Text="{Binding DataContext.OnlineCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="📦 Đối tác" FontSize="12" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- 4. SEARCH & FILTER CONTROLS -->
                <StackPanel Grid.Row="4" Margin="0,4,0,0">
                    <!-- Search Box -->
                    <Border Background="#FFFFFF" CornerRadius="6" Padding="8,4" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" FontSize="12"
                                     Foreground="#0F172A" VerticalContentAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Checkboxes: Đơn tại nhà hàng & Đơn bán online -->
                    <Border Background="#233245" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding InRestaurantOrdersChecked}" Content="Đơn tại nhà hàng"
                                      Foreground="#F8FAFC" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <CheckBox IsChecked="{Binding OnlineOrdersChecked}" Content="Đơn bán online"
                                      Foreground="#F8FAFC" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Active Filter Reset Button -->
                    <Button Content="🔄 Đặt lại bộ lọc" Click="OnResetAllFilterClick"
                            Background="#293B50" Foreground="#CBD5E1" FontWeight="Bold" FontSize="11.5"
                            Height="32" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- 5. BOTTOM SCROLL BUTTONS: [ ▲ ] [ ▼ ] -->
                <Grid Grid.Row="5" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="▲" Height="36" Cursor="Hand" Click="OnScrollUpClick"
                            Background="#293B50" Foreground="#FFFFFF" FontWeight="Black" FontSize="14">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" Content="▼" Height="36" Cursor="Hand" Click="OnScrollDownClick"
                            Background="#293B50" Foreground="#FFFFFF" FontWeight="Black" FontSize="14">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
