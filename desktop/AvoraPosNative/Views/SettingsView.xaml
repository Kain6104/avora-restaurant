<UserControl x:Class="AvoraPosNative.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1100"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             Background="#F8FAFC">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Title & Quick Actions Bar (56px) -->
            <RowDefinition Height="56"/>
            <!-- Row 1: Main White Card Workspace (*) -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Bottom Action Bar with Scroll + Save Button (60px) -->
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- 1. TOP TITLE BAR (BRIGHT WHITE & AVORA RED)                               -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🖨️ Máy in &amp; Thiết bị ngoại vi" FontWeight="Black" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="100% Native Spooler (RAW ESC/POS)" FontSize="11" FontWeight="Bold" Foreground="#DA251D"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Click="OnRefreshPrintersClick" Cursor="Hand" Margin="0,0,8,0" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,7">
                                    <TextBlock Text="🔄 Quét máy in Windows" FontSize="12" FontWeight="Bold" Foreground="#334155"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Click="OnShowPrintQueueClick" Cursor="Hand" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="8" Padding="12,7">
                                    <TextBlock Text="📋 Các lệnh đang in" FontSize="12" FontWeight="Bold" Foreground="#DA251D"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- 2. MAIN WORKSPACE CONTAINER (Sub-tabs + Spacious Cards)                   -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1" Margin="20,14,20,0" Background="#F8FAFC" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Sub-Tab Strip (48px) -->
                    <RowDefinition Height="48"/>
                    <!-- Scrollable Form Content (*) -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 4-Column Sub-Tab Bar -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sub-Tab 1: In hóa đơn / tạm tính -->
                        <Button x:Name="BtnSubReceipt" Grid.Column="0" Click="OnSubTabClick" Tag="RECEIPT" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="#FFFFFF">
                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                                            <TextBlock x:Name="TxtSubReceipt" Text="In hóa đơn / tạm tính" FontSize="13.5" FontWeight="Bold" Foreground="#DA251D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="BarSubReceipt" Height="3" VerticalAlignment="Bottom" Background="#DA251D"/>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Sub-Tab 2: In bar / bếp -->
                        <Button x:Name="BtnSubKitchen" Grid.Column="1" Click="OnSubTabClick" Tag="KITCHEN_PRINT" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="#FFFFFF">
                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                                            <TextBlock Text="In bar / bếp" FontSize="13.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Sub-Tab 3: In tem mặt hàng -->
                        <Button x:Name="BtnSubLabel" Grid.Column="2" Click="OnSubTabClick" Tag="LABEL_PRINT" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="#FFFFFF">
                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                                            <TextBlock Text="In tem mặt hàng" FontSize="13.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Sub-Tab 4: Cấu hình nâng cao & Máy in phát hiện -->
                        <Button x:Name="BtnSubAdvanced" Grid.Column="3" Click="OnSubTabClick" Tag="ADVANCED" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="#FFFFFF">
                                        <TextBlock Text="Danh sách máy in &amp; Thông số RAW" FontSize="13.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Scrollable Content Inside Main Card -->
                <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel>
                        <!-- CARD 1: MÁY IN HÓA ĐƠN / TẠM TÍNH (Full-width 4-column ergonomic card) -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtPrinterSectionTitle" Text="Máy in hóa đơn" FontWeight="Bold" FontSize="14.5" Foreground="#0F172A" Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Chế độ in -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Chế độ in" FontSize="12.5" Foreground="#475569" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbConnectionType" Padding="10,8" FontSize="13.5" Foreground="#0F172A" Background="#FFFFFF" BorderBrush="#CBD5E1">
                                            <ComboBoxItem Content="In tại máy (WinSpool RAW)" IsSelected="True"/>
                                            <ComboBoxItem Content="In qua mạng LAN (TCP 9100)"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Tên máy in -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Tên máy" FontSize="12.5" Foreground="#475569" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbPrinters" DisplayMemberPath="Name" SelectionChanged="OnPrinterComboSelectionChanged"
                                                  Padding="10,8" FontSize="13.5" Foreground="#0F172A" Background="#FFFFFF" BorderBrush="#CBD5E1"/>
                                    </StackPanel>

                                    <!-- Khổ giấy -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Khổ giấy" FontSize="12.5" Foreground="#475569" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbPaperSize" SelectionChanged="OnPaperSizeChanged"
                                                  Padding="10,8" FontSize="13.5" Foreground="#0F172A" Background="#FFFFFF" BorderBrush="#CBD5E1">
                                            <ComboBoxItem Content="80mm" Tag="80" IsSelected="True"/>
                                            <ComboBoxItem Content="58mm" Tag="58"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Nút In thử -->
                                    <Button Grid.Column="6" VerticalAlignment="Bottom" Click="OnTestPrintXp80cClick" Cursor="Hand" Height="38">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#FFFFFF" BorderBrush="#DA251D" BorderThickness="1" CornerRadius="6" Padding="18,0">
                                                    <TextBlock Text="In thử" FontSize="13.5" FontWeight="Bold" Foreground="#DA251D" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Nút Mở két -->
                                    <Button Grid.Column="8" VerticalAlignment="Bottom" Click="OnTestCashDrawerClick" Cursor="Hand" Height="38">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="14,0">
                                                    <TextBlock Text="🔓 Mở két" FontSize="13" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 2: LIÊN IN & TÙY CHỌN TỰ ĐỘNG -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Liên in" FontWeight="Bold" FontSize="14.5" Foreground="#0F172A" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="320"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="320"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Số liên in hóa đơn / in biên lai thanh toán" FontSize="12.5" Foreground="#475569" Margin="0,0,0,6"/>
                                        <TextBox x:Name="TxtReceiptCopies" Text="1" Padding="12,8" FontSize="13.5" Foreground="#0F172A" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Số liên in tạm tính" FontSize="12.5" Foreground="#475569" Margin="0,0,0,6"/>
                                        <TextBox x:Name="TxtTempBillCopies" Text="1" Padding="12,8" FontSize="13.5" Foreground="#0F172A" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,4,0,0">
                                    <CheckBox x:Name="ChkSupportsCut" Content="Tự động cắt giấy sau khi in" IsChecked="True" FontSize="13" Foreground="#334155" Margin="0,0,28,6"/>
                                    <CheckBox x:Name="ChkSupportsDrawer" Content="Tự động mở két tiền khi thanh toán" IsChecked="True" FontSize="13" Foreground="#334155" Margin="0,0,28,6"/>
                                    <CheckBox x:Name="ChkSupportsQr" Content="In mã QR thanh toán trên hóa đơn" IsChecked="True" FontSize="13" Foreground="#334155" Margin="0,0,28,6"/>
                                    <CheckBox x:Name="ChkSupportsBarcode" Content="In mã vạch 1D đơn hàng" IsChecked="True" FontSize="13" Foreground="#334155" Margin="0,0,0,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- CARD 3: DANH SÁCH MÁY IN WINDOWS & THÔNG SỐ KỸ THUẬT NÂNG CAO -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Installed Windows Printers List (Fixed Default Badge DataTrigger) -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="MÁY IN WINDOWS PHÁT HIỆN TRÊN THIẾT BỊ" FontWeight="Bold" FontSize="12.5" Foreground="#475569" Margin="0,0,0,10"/>

                                    <ListBox x:Name="PrintersListBox" Height="210" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                             SelectionChanged="OnPrinterSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="6,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#0F172A" FontSize="13"/>
                                                        <TextBlock Text="{Binding DriverName, StringFormat='Driver: {0}  •  Cổng: '}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="Mặc định" FontSize="10" Foreground="#059669" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtApiBaseUrl" Text="API: https://avorafnb.com" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569"/>
                                            <TextBlock x:Name="TxtWsBaseUrl" Text="WS: https://avorafnb.com" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="TxtMachineId" Text="Machine ID: 0000" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Right: Detailed Hardware Profile Fields -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="THÔNG SỐ DRIVER &amp; CỔNG IN CHI TIẾT" FontWeight="Bold" FontSize="12.5" Foreground="#475569" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Tên cấu hình (Profile Name)" Foreground="#475569" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtProfileName" Text="Máy in Bill Thu Ngân" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="10,7" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Bộ lệnh (Command Set)" Foreground="#475569" FontSize="12" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CmbCommandSet" Background="#F8FAFC" Foreground="#0F172A" Padding="10,7" FontSize="13">
                                                <ComboBoxItem Content="ESC/POS (Nhiệt hóa đơn)" IsSelected="True"/>
                                                <ComboBoxItem Content="TSPL (Tem nhãn mã vạch)"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Tên Driver Windows" Foreground="#475569" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtDriverName" Text="Xprinter XP-80C" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="10,7" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Cổng kết nối (USB / IP:9100)" Foreground="#475569" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtPortName" Text="USB001" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="10,7" FontSize="13"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Khổ giấy (mm)" Foreground="#475569" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtPaperWidthMm" Text="80" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="10,7" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Độ rộng (Dots)" Foreground="#475569" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtPrintableWidthDots" Text="576" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="10,7" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Độ phân giải (DPI)" Foreground="#475569" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtDpi" Text="203" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="10,7" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Bảng mã" Foreground="#475569" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtCodePage" Text="UTF-8 Raster" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="10,7" FontSize="13"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- 3. BOTTOM ACTION BAR (Touch Scroll [↑] [↓] + [Lưu] Button)                -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2" Margin="20,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Click="OnScrollUpClick" Width="56" Height="38" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#FFFFFF" CornerRadius="6">
                                <TextBlock Text="↑" FontSize="18" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Click="OnScrollDownClick" Width="56" Height="38" Margin="0,0,12,0" Cursor="Hand" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#FFFFFF" CornerRadius="6">
                                <TextBlock Text="↓" FontSize="18" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Click="OnSaveSettingsClick" Width="130" Height="38" Cursor="Hand" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#DA251D" CornerRadius="6">
                                <TextBlock Text="Lưu" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
