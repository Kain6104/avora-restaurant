<UserControl x:Class="AvoraPosNative.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000"
             Background="#F8FAFC">
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- Top bar -->
            <RowDefinition Height="60"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙️ CẤU HÌNH HỆ THỐNG &amp; MÁY IN NATIVE (PRINTER PROFILE)" FontWeight="Bold" FontSize="16" Foreground="#0F172A"/>
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="12,0,0,0">
                        <TextBlock Text="100% Native Spooler" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                    </Border>
                </StackPanel>

                <Button HorizontalAlignment="Right" Click="OnRefreshPrintersClick"
                        Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                        Padding="14,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="🔄 Quét máy in Windows"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E2E8F0"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Content Split: Left (Printers & Profiles), Right (Profile Details & Test Engine) -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Printer Profiles list & Installed Windows Printers -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="MÁY IN WINDOWS PHÁT HIỆN:" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="0,0,0,8"/>

                    <ListBox Grid.Row="1" x:Name="PrintersListBox" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                             SelectionChanged="OnPrinterSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#0F172A" FontSize="13"/>
                                        <TextBlock Text="{Binding DriverName, StringFormat='Driver: {0}'}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                            Visibility="{Binding IsDefault, Converter={x:Null}}">
                                        <TextBlock Text="Mặc định" FontSize="10" Foreground="#059669" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- System Endpoints -->
                    <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="HỆ THỐNG CONFIG (DIRECTIVE 1)" FontWeight="Bold" FontSize="11" Foreground="#E11D48" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtApiBaseUrl" Text="API: http://127.0.0.1:4001" FontSize="11" Foreground="#475569"/>
                            <TextBlock x:Name="TxtWsBaseUrl" Text="WS: ws://127.0.0.1:4001" FontSize="11" Foreground="#475569" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtMachineId" Text="Machine ID: 0000-0000" FontSize="11" Foreground="#475569" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: Profile 15 Fields & Native Testing -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05" Color="#000000"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CẤU HÌNH THÔNG SỐ KỸ THUẬT (15-FIELD PRINTER PROFILE)" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,16"/>

                        <!-- Row 1: Name & Connection -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tên cấu hình (Name):" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtProfileName" Text="Máy in Bill Thu Ngân (XP-80C)" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Chuẩn kết nối (ConnectionType):" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbConnectionType" Background="#F8FAFC" Foreground="#0F172A" Padding="8,6" FontSize="13">
                                    <ComboBoxItem Content="USB_WINDOWS_SPOOLER (Khuyên dùng WinSpool RAW)" IsSelected="True"/>
                                    <ComboBoxItem Content="TCP_LAN_RAW (Cổng 9100 Direct Socket)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Driver & Port -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tên Driver máy in (DriverName):" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtDriverName" Text="Xprinter XP-80C" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cổng kết nối (PortName):" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtPortName" Text="USB001" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6" FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: CommandSet & DPI & CodePage -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Bộ lệnh (CommandSet):" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbCommandSet" Background="#F8FAFC" Foreground="#0F172A" Padding="8,6">
                                    <ComboBoxItem Content="ESC/POS (Nhiệt hóa đơn)" IsSelected="True"/>
                                    <ComboBoxItem Content="TSPL (Tem nhãn mã vạch)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Độ phân giải (DPI):" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtDpi" Text="203" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Mã ký tự (CodePage):" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtCodePage" Text="1258 (Vietnamese Windows)" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 4: Paper width & Dots -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Khổ giấy mm (PaperWidthMm):" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtPaperWidthMm" Text="80" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Số điểm in bề ngang (PrintableWidthDots):" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtPrintableWidthDots" Text="576" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 5: Checkboxes for Hardware features -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <WrapPanel>
                                <CheckBox x:Name="ChkSupportsCut" Content="Tự động cắt giấy (supportsCut)" IsChecked="True" Foreground="#0F172A" Margin="0,0,20,6"/>
                                <CheckBox x:Name="ChkSupportsDrawer" Content="Kích két tiền (supportsDrawer)" IsChecked="True" Foreground="#0F172A" Margin="0,0,20,6"/>
                                <CheckBox x:Name="ChkSupportsQr" Content="In mã QR native (supportsQr)" IsChecked="True" Foreground="#0F172A" Margin="0,0,20,6"/>
                                <CheckBox x:Name="ChkSupportsBarcode" Content="In mã vạch 1D (supportsBarcode)" IsChecked="True" Foreground="#0F172A" Margin="0,0,20,6"/>
                            </WrapPanel>
                        </Border>

                        <!-- TEST ACTIONS: Directive 9 Mandate -->
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Test In Độ Nét XP-80C -->
                                <Button Grid.Column="0" Content="🖨️ TEST IN ĐỘ NÉT XP-80C THẬT (RAW)" Click="OnTestPrintXp80cClick"
                                        Background="#16A34A" Foreground="#FFFFFF" BorderThickness="0"
                                        Padding="0,14" FontWeight="Bold" FontSize="13" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#15803D"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Test Bật Két Tiền -->
                                <Button Grid.Column="2" Content="🔓 BẬT KÉT TIỀN (RAW ESC/POS)" Click="OnTestCashDrawerClick"
                                        Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1"
                                        Padding="0,14" FontWeight="Bold" FontSize="13" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
