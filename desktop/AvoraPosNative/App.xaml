<Application x:Class="AvoraPosNative.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Luxury Brand Colors -->
        <SolidColorBrush x:Key="BgDark" Color="#0D1117"/>
        <SolidColorBrush x:Key="BgPanel" Color="#161B22"/>
        <SolidColorBrush x:Key="BgHover" Color="#21262D"/>
        <SolidColorBrush x:Key="BorderMuted" Color="#30363D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F6FC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8B949E"/>
        <SolidColorBrush x:Key="GoldAccent" Color="#FFD700"/>
        <SolidColorBrush x:Key="EmeraldSuccess" Color="#238636"/>
        <SolidColorBrush x:Key="CrimsonDanger" Color="#F85149"/>

        <!-- Global Font -->
        <FontFamily x:Key="AppFont">Segoe UI, Helvetica Neue, Arial</FontFamily>

        <!-- Base Button Style -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Base TextBlock Style -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        </Style>
    </Application.Resources>
</Application>
