<Window x:Class="AvoraPosNative.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:AvoraPosNative.Views"
        mc:Ignorable="d"
        Title="AVORA POS - Hệ Thống Bán Hàng Nhà Hàng Chuyên Nghiệp"
        Height="900" Width="1440"
        MinHeight="720" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI"
        KeyDown="OnWindowKeyDown"
        Closing="OnWindowClosing">
    
    <Grid>
        <!-- Content Container -->
        <ContentControl x:Name="MainContentHost"/>
    </Grid>
</Window>
