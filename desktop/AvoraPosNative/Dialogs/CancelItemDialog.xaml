<Window x:Class="AvoraPosNative.Dialogs.CancelItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hủy Món / Hủy Đơn"
        Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="16" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="6" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="txtDialogTitle" Text="Hủy Món Ăn" FontSize="20" FontWeight="Black" Foreground="#0F172A" Margin="0,0,0,6" />
            <TextBlock Grid.Row="1" x:Name="txtItemName" Text="Món: Trà sữa nướng (x1)" FontSize="14" Foreground="#DC2626" FontWeight="Bold" Margin="0,0,0,14" />

            <!-- Preset Reasons -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="Chọn lý do hủy:" FontSize="12" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,6" />
                <UniformGrid Columns="2" Rows="2" Margin="0,0,0,10">
                    <Button Content="Khách đổi ý" Height="38" Margin="3" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" Click="BtnReason_Click" />
                    <Button Content="Hết nguyên liệu" Height="38" Margin="3" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" Click="BtnReason_Click" />
                    <Button Content="Đợi quá lâu" Height="38" Margin="3" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" Click="BtnReason_Click" />
                    <Button Content="Món làm lỗi / hỏng" Height="38" Margin="3" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" Click="BtnReason_Click" />
                </UniformGrid>
            </StackPanel>

            <!-- Custom Reason Input -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Text="Hoặc nhập lý do cụ thể:" FontSize="12" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="txtReason" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" Height="40" Padding="8,0" VerticalContentAlignment="Center" FontSize="13">
                    <TextBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                    </TextBox.Resources>
                </TextBox>
            </StackPanel>

            <!-- Actions -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Bỏ qua" Height="46" Background="#F1F5F9" Foreground="#64748B" FontWeight="Bold" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Click="BtnCancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" Content="XÁC NHẬN HỦY" Height="46" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="BtnConfirm_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
