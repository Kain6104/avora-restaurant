<Window x:Class="AvoraPosNative.Dialogs.NumericKeypadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bàn Phím Số Cảm Ứng"
        Height="500" Width="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="KeyBtn" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="16" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="6" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="txtTitle" Text="Nhập Số Tiền / Số Lượng" FontSize="18" FontWeight="Black" Foreground="#0F172A" Margin="0,0,0,12" HorizontalAlignment="Center" />

            <!-- Display Screen -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#2563EB" BorderThickness="1.5" CornerRadius="12" Height="56" Margin="0,0,0,16" Padding="14,0">
                <TextBlock x:Name="txtValue" Text="0" FontSize="26" FontWeight="Black" Foreground="#2563EB" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Border>

            <!-- Keypad Grid -->
            <UniformGrid Grid.Row="2" Columns="3" Rows="4" Margin="0,0,0,16">
                <Button Content="1" Style="{StaticResource KeyBtn}" Click="BtnNum_Click" />
                <Button Content="2" Style="{StaticResource KeyBtn}" Click="BtnNum_Click" />
                <Button Content="3" Style="{StaticResource KeyBtn}" Click="BtnNum_Click" />
                <Button Content="4" Style="{StaticResource KeyBtn}" Click="BtnNum_Click" />
                <Button Content="5" Style="{StaticResource KeyBtn}" Click="BtnNum_Click" />
                <Button Content="6" Style="{StaticResource KeyBtn}" Click="BtnNum_Click" />
                <Button Content="7" Style="{StaticResource KeyBtn}" Click="BtnNum_Click" />
                <Button Content="8" Style="{StaticResource KeyBtn}" Click="BtnNum_Click" />
                <Button Content="9" Style="{StaticResource KeyBtn}" Click="BtnNum_Click" />
                <Button Content="000" Style="{StaticResource KeyBtn}" Click="BtnNum_Click" />
                <Button Content="0" Style="{StaticResource KeyBtn}" Click="BtnNum_Click" />
                <Button Content="⌫" Style="{StaticResource KeyBtn}" Background="#F1F5F9" Foreground="#64748B" Click="BtnBack_Click" />
            </UniformGrid>

            <!-- Actions -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Hủy" Height="46" Background="#F1F5F9" Foreground="#64748B" FontWeight="Bold" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Click="BtnCancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" Content="XÁC NHẬN" Height="46" Background="#16A34A" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="BtnConfirm_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
