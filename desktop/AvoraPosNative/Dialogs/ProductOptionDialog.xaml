<Window x:Class="AvoraPosNative.Dialogs.ProductOptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tùy Chọn Món Ăn"
        Height="540" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="16" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="6" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title & Product Name -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="txtProductName" Text="Tên Món Ăn" FontSize="20" FontWeight="Black" Foreground="#0F172A" Margin="0,0,0,4" />
                <TextBlock x:Name="txtProductBasePrice" Text="Đơn giá: 0đ" FontSize="13" Foreground="#E11D48" FontWeight="Bold" />
            </StackPanel>

            <!-- Option Groups List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="pnlOptionGroups" Margin="0,0,8,0" />
            </ScrollViewer>

            <!-- Note input & Total adjustment -->
            <StackPanel Grid.Row="2" Margin="0,12,0,16">
                <TextBlock Text="Ghi chú món:" FontSize="12" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="txtNote" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,8" FontSize="13">
                    <TextBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                    </TextBox.Resources>
                </TextBox>
                <Grid Margin="0,10,0,0">
                    <TextBlock Text="Tổng tiền sau tùy chọn:" FontSize="13" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtEffectivePrice" Text="0đ" FontSize="18" FontWeight="Black" Foreground="#16A34A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- Actions -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Hủy" Height="46" Background="#F1F5F9" Foreground="#64748B" FontWeight="Bold" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Click="BtnCancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" Content="CHỌN MÓN" Height="46" Background="#E11D48" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="BtnConfirm_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
