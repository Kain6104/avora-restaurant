<Window x:Class="AvoraPosNative.Dialogs.SplitTableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tách Bàn / Tách Món"
        Height="540" Width="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="2" CornerRadius="14" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Tách Bàn &amp; Tách Món" FontSize="20" FontWeight="Black" Foreground="#0F172A" Margin="0,0,0,12" />

            <!-- Items to split list -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="pnlItems" />
                </ScrollViewer>
            </Border>

            <!-- Destination Table Selection -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <TextBlock Text="Chuyển các món đã chọn sang bàn:" FontSize="13" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox x:Name="cboDestinationTable" Height="42" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="14" Padding="10,0" />
            </StackPanel>

            <!-- Actions -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Hủy" Height="46" Background="#F1F5F9" Foreground="#64748B" FontWeight="Bold" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Click="BtnCancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" Content="XÁC NHẬN TÁCH" Height="46" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="BtnConfirm_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
