<Window x:Class="AvoraPosNative.Dialogs.TableQrDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mã QR Gọi Món Bàn"
        Height="540" Width="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="16" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="MÃ QR GỌI MÓN TẠI BÀN" FontSize="11" FontWeight="Black" Foreground="#DA251D"/>
                    <TextBlock x:Name="txtTableName" Text="Bàn M09" FontSize="20" FontWeight="Black" Foreground="#0F172A" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Width="32" Height="32"
                        Background="#F1F5F9" Foreground="#64748B" BorderThickness="0"
                        FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Center Content: QR Code & Info -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- QR Code Box -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="14" HorizontalAlignment="Center">
                    <Image x:Name="imgQrCode" Width="200" Height="200" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Status Chip -->
                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="10,3" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="● " FontSize="10" Foreground="#059669" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtStatus" Text="Đang hoạt động (ACTIVE)" FontSize="11.5" FontWeight="Bold" Foreground="#059669"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Khách quét mã bằng camera điện thoại để tự gọi món" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,8,0,0"/>

                <!-- URL & Copy Button -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,10,0,0" Width="380">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtQrUrl" Text="https://avorafnb.com/qr/..." FontSize="11" Foreground="#475569" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Content="Sao chép" Click="BtnCopy_Click" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#0F172A" FontSize="10.5" FontWeight="Bold" Padding="8,3" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Bottom Actions -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="🖨️ In Phiếu QR Bàn" Click="BtnPrint_Click"
                        Height="44" Background="#DA251D" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"
                        Margin="0,0,6,0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="1" Content="🔄 Tạo lại mã" Click="BtnRegenerate_Click"
                        Height="44" Background="#F1F5F9" Foreground="#334155" FontWeight="Bold" FontSize="13"
                        BorderBrush="#CBD5E1" BorderThickness="1" Margin="6,0,0,0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
