<Window x:Class="AvoraPosNative.Dialogs.PosBuffetApplyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Áp Dụng Gói Buffet"
        Height="620" Width="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="16" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 1. Header (64px) -->
                <RowDefinition Height="64"/>
                <!-- 2. Scrollable Body Content (*) -->
                <RowDefinition Height="*"/>
                <!-- 3. Footer Actions (68px) -->
                <RowDefinition Height="68"/>
            </Grid.RowDefinitions>

            <!-- 1. DIALOG HEADER -->
            <Border Grid.Row="0" Background="#DA251D" CornerRadius="14,14,0,0" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#FFFFFF" Margin="0,0,12,0">
                            <TextBlock Text="🍱" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Áp Dụng Gói Buffet Cho Bàn" FontSize="16" FontWeight="Black" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="TxtSubtitle" Text="Bàn ăn • Đang phục vụ khách" FontSize="12" FontWeight="SemiBold" Foreground="#FECACA" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Click="OnCloseClick" Width="36" Height="36" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#B91C1C" CornerRadius="18">
                                    <TextBlock Text="✕" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. BODY CONTENT -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
                <StackPanel>
                    <!-- Step 1: Chọn gói Buffet -->
                    <TextBlock Text="1. CHỌN GÓI BUFFET ÁP DỤNG" FontSize="12" FontWeight="Black" Foreground="#64748B" Margin="0,0,0,10"/>

                    <ItemsControl x:Name="PackagesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4,4,6,6" CornerRadius="12" BorderThickness="2" Cursor="Hand"
                                        MouseLeftButtonUp="OnSelectPackageClick">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                            <Setter Property="Padding" Value="14"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#FFF1F2"/>
                                                    <Setter Property="BorderBrush" Value="#DA251D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontWeight="Black" FontSize="14" Foreground="#0F172A"/>
                                            <Border HorizontalAlignment="Right" Width="20" Height="20" CornerRadius="10" Background="#DA251D">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="✓" FontSize="11" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Description, FallbackValue='Gói Buffet ẩm thực cao cấp'}" FontSize="11.5" Foreground="#64748B" Margin="0,4,0,8" TextTrimming="CharacterEllipsis"/>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                                            <Grid>
                                                <TextBlock Text="{Binding ItemsCountText}" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding PriceText}" FontSize="12.5" FontWeight="Black" Foreground="#DA251D" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Step 2: Chọn số lượng vé tính tiền -->
                    <TextBlock Text="2. SỐ LƯỢNG VÉ TÍNH TIỀN" FontSize="12" FontWeight="Black" Foreground="#64748B" Margin="0,16,0,10"/>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14">
                        <ItemsControl x:Name="TicketsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                    <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0">
                                                        <TextBlock Text="Vé Buffet" FontSize="10" FontWeight="Black" Foreground="#4338CA"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding PriceText, StringFormat='{}{0} / người'}" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Stepper: [-] [Qty] [+] -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Click="OnDecreaseTicketClick" Width="32" Height="32" Cursor="Hand" BorderThickness="0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="#F1F5F9" CornerRadius="8">
                                                                <TextBlock Text="−" FontSize="15" FontWeight="Black" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <TextBlock Text="{Binding Quantity}" Width="36" FontSize="14" FontWeight="Black" Foreground="#0F172A" TextAlignment="Center" VerticalAlignment="Center"/>

                                                <Button Click="OnIncreaseTicketClick" Width="32" Height="32" Cursor="Hand" BorderThickness="0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="#DA251D" CornerRadius="8">
                                                                <TextBlock Text="+" FontSize="16" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Information banner -->
                    <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="✨ Cơ chế hoạt động của Buffet:" FontSize="12" FontWeight="Black" Foreground="#0369A1"/>
                            <TextBlock Text="• Các vé tính tiền ở trên sẽ được thêm vào hóa đơn của bàn." FontSize="11.5" Foreground="#0284C7" Margin="0,4,0,0"/>
                            <TextBlock Text="• Tất cả các món ăn thuộc gói Buffet này sẽ tự động áp dụng giá 0đ khi gọi món." FontSize="11.5" Foreground="#0284C7" Margin="0,2,0,0"/>
                            <TextBlock Text="• Đồng hồ đếm ngược thời gian ăn Buffet (120 phút) sẽ tự động bắt đầu tính giờ." FontSize="11.5" Foreground="#0284C7" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. FOOTER ACTIONS -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tổng tiền vé dự tính:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtTotalEstimate" Text="0đ (0 vé)" FontSize="16" FontWeight="Black" Foreground="#DA251D" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="OnCloseClick" Width="100" Height="42" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#E2E8F0" CornerRadius="8">
                                        <TextBlock Text="Hủy bỏ" FontSize="13" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="OnConfirmApplyClick" Height="42" Padding="20,0" Cursor="Hand" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#DA251D" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="✓" FontSize="13" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                            <TextBlock Text="Kích Hoạt Buffet Cho Bàn" FontSize="13.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
