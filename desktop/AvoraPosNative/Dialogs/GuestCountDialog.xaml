<Window x:Class="AvoraPosNative.Dialogs.GuestCountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Số Lượng Khách"
        Height="460" Width="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="TouchNumBtn" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="16" Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="6" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="txtTitle" Text="Chọn Số Lượng Khách" FontSize="20" FontWeight="Black" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,16" />

            <!-- Display Current Count with Minus and Plus -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="-" Style="{StaticResource TouchNumBtn}" FontSize="24" Click="BtnMinus_Click" />
                <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Margin="10,0">
                    <TextBlock x:Name="txtGuestCount" Text="2" FontSize="28" FontWeight="Black" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Button Grid.Column="2" Content="+" Style="{StaticResource TouchNumBtn}" FontSize="24" Click="BtnPlus_Click" />
            </Grid>

            <!-- Quick Number Grid -->
            <UniformGrid Grid.Row="2" Columns="4" Rows="3" Margin="0,0,0,20">
                <Button Content="1" Style="{StaticResource TouchNumBtn}" Margin="4" Click="BtnPreset_Click" Tag="1" />
                <Button Content="2" Style="{StaticResource TouchNumBtn}" Margin="4" Click="BtnPreset_Click" Tag="2" />
                <Button Content="3" Style="{StaticResource TouchNumBtn}" Margin="4" Click="BtnPreset_Click" Tag="3" />
                <Button Content="4" Style="{StaticResource TouchNumBtn}" Margin="4" Click="BtnPreset_Click" Tag="4" />
                <Button Content="5" Style="{StaticResource TouchNumBtn}" Margin="4" Click="BtnPreset_Click" Tag="5" />
                <Button Content="6" Style="{StaticResource TouchNumBtn}" Margin="4" Click="BtnPreset_Click" Tag="6" />
                <Button Content="8" Style="{StaticResource TouchNumBtn}" Margin="4" Click="BtnPreset_Click" Tag="8" />
                <Button Content="10" Style="{StaticResource TouchNumBtn}" Margin="4" Click="BtnPreset_Click" Tag="10" />
                <Button Content="12" Style="{StaticResource TouchNumBtn}" Margin="4" Click="BtnPreset_Click" Tag="12" />
                <Button Content="15" Style="{StaticResource TouchNumBtn}" Margin="4" Click="BtnPreset_Click" Tag="15" />
                <Button Content="20" Style="{StaticResource TouchNumBtn}" Margin="4" Click="BtnPreset_Click" Tag="20" />
                <Button Content="C" Style="{StaticResource TouchNumBtn}" Background="#F1F5F9" Foreground="#64748B" Margin="4" Click="BtnReset_Click" />
            </UniformGrid>

            <!-- Actions -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Bỏ qua" Height="48" Background="#F1F5F9" Foreground="#64748B" FontWeight="Bold" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Click="BtnCancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" Content="XÁC NHẬN" Height="48" Background="#E11D48" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="BtnConfirm_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
