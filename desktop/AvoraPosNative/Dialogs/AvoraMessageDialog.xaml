<Window x:Class="AvoraPosNative.Dialogs.AvoraMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AVORA POS"
        Height="300" Width="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Modal Card Container -->
    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="16" Padding="28,24" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Icon Circle -->
            <Border Grid.Row="0" Width="52" Height="52" CornerRadius="26" HorizontalAlignment="Center" Margin="0,0,0,14" x:Name="IconBadge">
                <TextBlock x:Name="TxtIcon" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- 2. Modal Title -->
            <TextBlock Grid.Row="1" x:Name="TxtTitle" Text="Thông báo"
                       FontSize="16.5" FontWeight="Black" Foreground="#0F172A"
                       HorizontalAlignment="Center" Margin="0,0,0,10" TextAlignment="Center" />

            <!-- 3. Modal Message Body -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                <TextBlock x:Name="TxtMessage" Text="Nội dung thông báo..."
                           FontSize="13.5" Foreground="#475569" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center" LineHeight="20" />
            </ScrollViewer>

            <!-- 4. Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Cancel / Secondary Button (Hidden if single button) -->
                <Button x:Name="BtnCancel" Grid.Column="0" Content="Hủy bỏ" Height="42"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#F1F5F9" Foreground="#475569"
                        Click="OnCancelClick" Margin="0,0,10,0" FontSize="13.5" Visibility="Collapsed"/>

                <!-- Primary / OK Button -->
                <Button x:Name="BtnOk" Grid.Column="1" Content="Xác nhận" Height="42" MinWidth="140"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#DA251D" Foreground="#FFFFFF"
                        Click="OnOkClick" FontSize="13.5" HorizontalAlignment="Stretch"/>
            </Grid>
        </Grid>
    </Border>
</Window>

