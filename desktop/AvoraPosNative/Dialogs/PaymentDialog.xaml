<Window x:Class="AvoraPosNative.Dialogs.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh Toán Đơn Hàng"
        Height="630" Width="840"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="MethodBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CashPresetBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="16" Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="6" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="THANH TOÁN" FontSize="22" FontWeight="Black" Foreground="#0F172A" Margin="0,0,12,0" />
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Name="txtOrderInfo" Text="Bàn: Bàn 01 • #ORD-1234" FontSize="12" Foreground="#1D4ED8" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <Button HorizontalAlignment="Right" Width="36" Height="36" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#EF4444" FontWeight="Bold" Cursor="Hand" Click="BtnClose_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></Button.Resources>
                    <TextBlock Text="✕" FontSize="16" />
                </Button>
            </Grid>

            <!-- 2-Column Main Workspace -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1.3*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Payment Methods & Vouchers -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Phương thức thanh toán:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8" />
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <Button x:Name="btnMethodCash" Content="Tiền mặt" Style="{StaticResource MethodBtn}" Background="#E11D48" Foreground="#FFFFFF" BorderBrush="#E11D48" Margin="0,0,4,0" Click="BtnMethod_Click" Tag="CASH" />
                        <Button x:Name="btnMethodQr" Content="QR VietQR" Style="{StaticResource MethodBtn}" Margin="2,0" Click="BtnMethod_Click" Tag="BANK_TRANSFER" />
                        <Button x:Name="btnMethodCard" Content="Thẻ POS" Style="{StaticResource MethodBtn}" Margin="4,0,0,0" Click="BtnMethod_Click" Tag="CARD" />
                    </UniformGrid>

                    <!-- Two Vouchers Section (Directive 4) -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ÁP DỤNG MÃ KHUYẾN MÃI" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,8" />
                            
                            <!-- Voucher 1: Discount Voucher -->
                            <TextBlock Text="1. Voucher giảm giá món/đơn:" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtDiscountVoucher" Height="36" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center" CharacterCasing="Upper">
                                    <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></TextBox.Resources>
                                </TextBox>
                                <Button Grid.Column="1" Content="Áp dụng" Height="36" Margin="6,0,0,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="Bold" Cursor="Hand" Click="BtnApplyDiscountVoucher_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                </Button>
                            </Grid>

                            <!-- Voucher 2: Shipping Voucher -->
                            <TextBlock Text="2. Voucher miễn phí vận chuyển:" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtShippingVoucher" Height="36" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center" CharacterCasing="Upper">
                                    <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></TextBox.Resources>
                                </TextBox>
                                <Button Grid.Column="1" Content="Áp dụng" Height="36" Margin="6,0,0,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="Bold" Cursor="Hand" Click="BtnApplyShippingVoucher_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Extra Options Checkbox -->
                    <CheckBox x:Name="chkInvoice" Content="Yêu cầu xuất hóa đơn điện tử GTGT" Foreground="#334155" FontSize="12" Margin="0,0,0,8" />
                    <CheckBox x:Name="chkAutoPrint" Content="Tự động in hóa đơn nhiệt sau khi thanh toán" Foreground="#334155" FontSize="12" IsChecked="True" />
                </StackPanel>

                <!-- Right Column: Cash Calculator / Totals / Change -->
                <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Total Due -->
                        <Border Grid.Row="0" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                            <Grid>
                                <TextBlock Text="CẦN THANH TOÁN:" FontSize="13" FontWeight="Bold" Foreground="#065F46" VerticalAlignment="Center" />
                                <TextBlock x:Name="txtTotalDue" Text="0đ" FontSize="24" FontWeight="Black" Foreground="#16A34A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Cash Received Input -->
                        <StackPanel Grid.Row="1" x:Name="pnlCashInput" Margin="0,0,0,10">
                            <TextBlock Text="Tiền khách đưa:" FontSize="12" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,8">
                                <TextBox x:Name="txtReceivedAmount" Height="46" Background="#FFFFFF" Foreground="#2563EB" FontWeight="Black" FontSize="20" BorderBrush="#2563EB" BorderThickness="1.5" Padding="10,0" VerticalContentAlignment="Center" TextChanged="TxtReceivedAmount_TextChanged">
                                    <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></TextBox.Resources>
                                </TextBox>
                            </Grid>

                            <!-- Quick Presets -->
                            <UniformGrid Columns="4">
                                <Button Content="ĐỦ TIỀN" Style="{StaticResource CashPresetBtn}" Click="BtnPresetExact_Click" />
                                <Button Content="100k" Style="{StaticResource CashPresetBtn}" Click="BtnPresetNum_Click" Tag="100000" />
                                <Button Content="200k" Style="{StaticResource CashPresetBtn}" Click="BtnPresetNum_Click" Tag="200000" />
                                <Button Content="500k" Style="{StaticResource CashPresetBtn}" Click="BtnPresetNum_Click" Tag="500000" />
                            </UniformGrid>
                        </StackPanel>

                        <!-- QR Code Container for BANK_TRANSFER -->
                        <Border Grid.Row="2" x:Name="pnlQrDisplay" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="MÃ QR THANH TOÁN VIETQR" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <Border Width="160" Height="160" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="6" HorizontalAlignment="Center">
                                    <Image x:Name="imgQrCode" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="Khách quét mã để thanh toán tức thì" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Change Amount -->
                        <Border Grid.Row="4" x:Name="pnlChange" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
                            <Grid>
                                <TextBlock Text="Tiền thối lại khách:" FontSize="13" Foreground="#92400E" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="txtChangeAmount" Text="0đ" FontSize="18" FontWeight="Black" Foreground="#D97706" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Actions -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="HỦY BỎ" Height="52" Background="#F1F5F9" Foreground="#64748B" FontWeight="Bold" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Click="BtnClose_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style></Button.Resources>
                </Button>

                <Button Grid.Column="2" x:Name="btnSubmitPayment" Content="XÁC NHẬN THANH TOÁN" Height="52" Background="#16A34A" Foreground="#FFFFFF" FontWeight="Black" FontSize="16" Cursor="Hand" Click="BtnSubmitPayment_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style></Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
